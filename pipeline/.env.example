# Variables the pipeline reads. labs.sh, candidates.sh and podcasts.sh do not
# read this file: they load ~/infra/.env (set -a; . ~/infra/.env) before running
# Python. Copy the names you need there; never commit real values.

# Gemini (labs classification, briefs, weekly report, podcast summaries).
# google-genai reads GOOGLE_API_KEY, or GEMINI_API_KEY when that is unset.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# X API (labs/x_source.py); without the token the labs run skips X.
X_BEARER_TOKEN=
# Posts billed per UTC day before reading stops ($0.005 each).
X_DAILY_POST_CAP=300

# TypeSafe Jev (candidates); without the key candidates are saved unscored.
TYPESAFE_API_KEY=
# Optional: the reader Jev judges importance for.
USER_INTERESTS=AI agents, LLM infrastructure and open models

# knowledge-api ingest (labs X posts, podcasts); without the token nothing is sent.
KNOWLEDGE_API=http://127.0.0.1:8000
INGEST_API_TOKEN=

# Substack subscriber cookie (substack.sid) for full Latent Space posts.
SUBSTACK_SID=
# Gmail IMAP (read-only) for the podcast fallback: when the cookie is missing
# or rejected, the episode is read from the subscriber mail instead.
GMAIL_IMAP_USER=
GMAIL_IMAP_PASSWORD=
