---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { marked } from "marked";

import legacyData from "../../data/legacy.json";
import legacyContent from "../../data/legacy-content.json";

export function getStaticPaths() {
  return legacyData
    .filter((issue: any) => issue.hasContent)
    .map((issue: any) => ({
      params: { date: issue.date },
      props: { issue },
    }));
}

const { issue } = Astro.props;
const content = (legacyContent as Record<string, string>)[issue.date] || "";
const htmlContent = await marked.parse(content);

const idx = legacyData.findIndex((i: any) => i.date === issue.date);
const prevIssue = idx < legacyData.length - 1 ? legacyData[idx + 1] : null;
const nextIssue = idx > 0 ? legacyData[idx - 1] : null;
---

<Layout title={issue.title} description={issue.description || `AI News for ${issue.date}`}>
  <Container>
    <div class="mx-auto max-w-3xl space-y-10">
      <!-- Back link -->
      <a href="/archive" class="inline-flex items-center gap-1.5 text-sm no-underline transition-colors" style="color: var(--color-text-muted);">
        <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Archive
      </a>

      <!-- Header -->
      <header class="space-y-3" style="border-left: 3px solid var(--color-accent-cool); padding-left: 1.25rem;">
        <div class="flex items-center gap-3">
          <span class="meta">{issue.date}</span>
        </div>
        <h1 class="text-2xl font-semibold tracking-tight lg:text-3xl" style="color: var(--color-text);">
          {issue.title}
        </h1>
        {((issue.companies?.length > 0) || (issue.models?.length > 0)) && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {(issue.companies || []).map((c: string) => (
              <span class="tag tag-company">{c}</span>
            ))}
            {(issue.models || []).map((m: string) => (
              <span class="tag tag-model">{m}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Content -->
      <article set:html={htmlContent} />

      <!-- Prev/Next -->
      <nav class="flex items-center justify-between pt-4" style="border-top: 1px solid var(--color-border);">
        {prevIssue ? (
          <a href={prevIssue.hasContent ? `/archive/${prevIssue.date}` : "/archive"} class="meta no-underline hover:underline">
            ← {prevIssue.date}
          </a>
        ) : <span />}
        {nextIssue ? (
          <a href={nextIssue.hasContent ? `/archive/${nextIssue.date}` : "/archive"} class="meta no-underline hover:underline">
            {nextIssue.date} →
          </a>
        ) : <span />}
      </nav>
    </div>
  </Container>
</Layout>

<style>
  .tag {
    display: inline-block;
    border-radius: 2px;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
  }
  .tag-company {
    color: #9333ea;
    background-color: color-mix(in srgb, #9333ea 8%, transparent);
    border: 1px solid color-mix(in srgb, #9333ea 20%, transparent);
  }
  :global(.dark) .tag-company {
    color: #c084fc;
    background-color: color-mix(in srgb, #c084fc 10%, transparent);
    border-color: color-mix(in srgb, #c084fc 20%, transparent);
  }
  .tag-model {
    color: var(--color-accent-cool);
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
  }
  :global(.dark) .tag-model {
    color: var(--color-accent-cool-dark);
    background-color: color-mix(in srgb, var(--color-accent-cool-dark) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent-cool-dark) 20%, transparent);
  }
</style>
