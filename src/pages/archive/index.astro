---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { markdownToHtml } from "../../utils/textUtils";

import legacyData from "../../data/legacy.json";

type Grouped = Record<string, Record<string, any[]>>;

const grouped = legacyData.reduce((acc: Grouped, issue: any) => {
  const year = issue.date.slice(0, 4);
  const month = issue.date.slice(0, 7);
  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];
  acc[year][month].push(issue);
  return acc;
}, {} as Grouped);

const years = Object.keys(grouped).sort().reverse();

const monthNames: Record<string, string> = {
  "01": "Jan", "02": "Feb", "03": "Mar", "04": "Apr",
  "05": "May", "06": "Jun", "07": "Jul", "08": "Aug",
  "09": "Sep", "10": "Oct", "11": "Nov", "12": "Dec",
};
---

<Layout title="Archive" description="Historical AI news archive">
  <Container>
    <div class="space-y-10">
      <div>
        <div class="section-title mb-2">Historical Data</div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Archive</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
          {legacyData.length} AI news digests, 2023 ~ 2026
        </p>
      </div>

      {years.map((year) => (
        <section class="space-y-4">
          <h2 class="text-lg font-semibold" style="color: var(--color-text);">{year}</h2>
          {Object.keys(grouped[year]).sort().reverse().map((monthKey) => {
            const mm = monthKey.split("-")[1];
            const issues = grouped[year][monthKey];
            return (
              <details class="group">
                <summary class="flex cursor-pointer items-center gap-3 rounded-md px-4 py-2.5 transition-colors" style="color: var(--color-text);">
                  <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
                    <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span class="font-medium">{monthNames[mm]} {year}</span>
                  <span class="meta">{issues.length} issues</span>
                </summary>
                <div class="mt-2 space-y-1.5 pl-4">
                  {issues.map((issue: any) => {
                    const Tag = issue.hasContent ? "a" : "div";
                    return (
                      <Tag
                        href={issue.hasContent ? `/archive/${issue.date}` : undefined}
                        class={`card block px-5 py-3.5 no-underline ${issue.hasContent ? "cursor-pointer" : ""}`}
                      >
                        <div class="flex items-start gap-4">
                          <span class="meta min-w-[5.5rem] pt-0.5">{issue.date}</span>
                          <div class="flex-1 space-y-1.5">
                            <div class="flex items-center gap-2">
                              <span class="text-sm font-medium" style="color: var(--color-text);">{issue.title}</span>
                              {issue.hasContent && (
                                <span class="text-xs" style="color: var(--color-accent-cool);">→</span>
                              )}
                            </div>
                            {issue.description && (
                              <p class="text-xs leading-relaxed line-clamp-2" style="color: var(--color-text-muted);"
                                 set:html={markdownToHtml(issue.description)} />
                            )}
                            {((issue.companies?.length > 0) || (issue.models?.length > 0)) && (
                              <div class="flex flex-wrap gap-1 pt-0.5">
                                {(issue.companies || []).slice(0, 4).map((c: string) => (
                                  <span class="tag tag-company">{c}</span>
                                ))}
                                {(issue.models || []).slice(0, 4).map((m: string) => (
                                  <span class="tag tag-model">{m}</span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      </Tag>
                    );
                  })}
                </div>
              </details>
            );
          })}
        </section>
      ))}
    </div>
  </Container>
</Layout>

<style>
  .tag {
    display: inline-block;
    border-radius: 2px;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
  }
  .tag-company {
    color: #9333ea;
    background-color: color-mix(in srgb, #9333ea 8%, transparent);
    border: 1px solid color-mix(in srgb, #9333ea 20%, transparent);
  }
  :global(.dark) .tag-company {
    color: #c084fc;
    background-color: color-mix(in srgb, #c084fc 10%, transparent);
    border-color: color-mix(in srgb, #c084fc 20%, transparent);
  }
  .tag-model {
    color: var(--color-accent-cool);
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
  }
  :global(.dark) .tag-model {
    color: var(--color-accent-cool);
    background-color: color-mix(in srgb, var(--color-accent-cool) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
  }
  summary:hover {
    background-color: var(--color-surface-muted);
  }
  :global(.dark) summary:hover {
    background-color: var(--color-surface-muted);
  }
</style>
