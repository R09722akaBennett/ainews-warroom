---
import type { GetStaticPaths } from "astro";
import List from "../_List.astro";
import { laterPages } from "../../_lib/paging";
import { PER_PAGE, items } from "../_data";

export const getStaticPaths = (({ paginate }) => laterPages(paginate, items, PER_PAGE)) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<List page={page} />
