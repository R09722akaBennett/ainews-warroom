---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ExternalIcon from "@components/ExternalIcon.astro";
import papersData from "@data/papers.json";
import mcpData from "@data/mcpmarket.json";

const papers = papersData as any;
const mcp = mcpData as any;
const mcpServers: any[] = mcp.servers || [];
const mcpSkills: any[] = mcp.skills || [];
const monthDay = (d: string) =>
  new Date(d).toLocaleDateString("zh-TW", { timeZone: "Asia/Taipei", month: "numeric", day: "numeric" });
const mcpUpdated = mcp.updatedAt ? monthDay(mcp.updatedAt) : "";
// "computer-science" is on nearly every paper, so it would not filter anything.
const paperCats: string[] = [];
const _catCount: Record<string, number> = {};
for (const p of [...(papers.hot || []), ...(papers.likes || [])]) {
  for (const c of (p as any).categories || []) {
    if (c !== "computer-science") {
      _catCount[c] = (_catCount[c] || 0) + 1;
    }
  }
}
Object.entries(_catCount)
  .sort((a, b) => b[1] - a[1])
  .forEach(([cat]) => paperCats.push(cat));

const papersUpdated = papers.updatedAt ? monthDay(papers.updatedAt) : "";

type Product = { name: string; tagline: string; url: string; author: string; date: string };
let products: Product[] = [];
try {
  const resp = await fetch("https://www.producthunt.com/feed");
  const text = await resp.text();
  const entries = text.match(/<entry>[\s\S]*?<\/entry>/g) || [];
  for (const entry of entries.slice(0, 50)) {
    const title = entry.match(/<title>(.*?)<\/title>/)?.[1] || "";
    const link = entry.match(/<link[^>]*href="([^"]*)"[^>]*\/>/)?.[1]
              || entry.match(/<link[^>]*rel="alternate"[^>]*href="([^"]*)"[^>]*\/>/)?.[1]
              || "";
    const content = entry.match(/<content[^>]*>([\s\S]*?)<\/content>/)?.[1] || "";
    const author = entry.match(/<name>(.*?)<\/name>/)?.[1] || "";
    const published = entry.match(/<published>(.*?)<\/published>/)?.[1] || "";
    const taglineMatch = content.match(/&lt;p&gt;\s*([\s\S]*?)\s*&lt;\/p&gt;/);
    const tagline = taglineMatch
      ? taglineMatch[1].replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").trim()
      : "";
    if (title && link) {
      const dateStr = published ? monthDay(published) : "";
      products.push({ name: title.trim(), tagline, url: link, author, date: dateStr });
    }
  }
} catch (e) {
  console.error("[Products] Fetch error:", e);
}
---

<Layout title="Trending" description="GitHub 熱門 repo、Product Hunt 新產品、alphaXiv 熱門論文與 MCP Market 排行。">
  <Container>
    <div class="space-y-8">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Trending</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
          GitHub 熱門 repo、Product Hunt 新產品、alphaXiv 熱門論文與 MCP Market 排行。
        </p>
      </div>

      <div class="top-tabs" id="top-tabs">
        <button type="button" data-top="repos" class="tab-pill tab-pill-active">
          <span class="tab-pill-icon">{"\u{1F4BB}"}</span>
          GitHub Repos
        </button>
        <button type="button" data-top="products" class="tab-pill">
          <span class="tab-pill-icon">{"\u{1F680}"}</span>
          Product Hunt
          <span class="tab-pill-count">{products.length}</span>
        </button>
        <button type="button" data-top="papers" class="tab-pill">
          <span class="tab-pill-icon">{"\u{1F4D1}"}</span>
          論文
        </button>
        <button type="button" data-top="mcpservers" class="tab-pill">
          <span class="tab-pill-icon">{"\u{1F50C}"}</span>
          MCP Servers
          <span class="tab-pill-count">{mcpServers.length}</span>
        </button>
        <button type="button" data-top="skills" class="tab-pill">
          <span class="tab-pill-icon">{"\u{1F916}"}</span>
          Agent Skills
          <span class="tab-pill-count">{mcpSkills.length}</span>
        </button>
      </div>

      <div data-section="repos" class="section-content">
        <div class="flex gap-1 flex-wrap" id="lang-tabs" style="border-bottom: 1px solid var(--color-border);"></div>

        <div id="repos-container" class="mt-4">
          <div class="flex items-center justify-center py-12">
            <span class="text-sm" style="color: var(--color-text-muted);">正在抓取 GitHub 熱門 repo…</span>
          </div>
        </div>

        <div class="mt-2">
          <span id="update-time" class="meta"></span>
        </div>
      </div>

      <div data-section="products" class="section-content hidden">
        {products.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-sm" style="color: var(--color-text-muted);">這次更新沒有抓到 Product Hunt 的產品。</p>
            <a href="https://www.producthunt.com" target="_blank" rel="noopener noreferrer"
               class="trend-more mt-2 text-xs no-underline" style="color: var(--color-accent-warm-text);">
              前往 Product Hunt →
            </a>
          </div>
        ) : (
          <div class="space-y-0.5">
            {products.map((p, i) => (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="product-row">
                <span class:list={["product-rank", { "product-rank-top": i < 3 }]}>{i + 1}</span>
                <div style="flex: 1; min-width: 0;">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold" style="color: var(--color-text);">{p.name}</span>
                    <ExternalIcon />
                  </div>
                  {p.tagline && (
                    <p class="text-xs mt-0.5 leading-relaxed" style="color: var(--color-text-muted);">{p.tagline}</p>
                  )}
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-[10px] font-mono" style="color: var(--color-text-muted);">{p.author}</span>
                    {p.date && (
                      <>
                        <span class="text-[10px]" style="color: var(--color-border);">·</span>
                        <span class="text-[10px] font-mono" style="color: var(--color-text-muted);">{p.date}</span>
                      </>
                    )}
                  </div>
                </div>
              </a>
            ))}
            <div class="text-center pt-6 pb-2">
              <a href="https://www.producthunt.com" target="_blank" rel="noopener noreferrer"
                 class="trend-more text-xs no-underline hover:underline" style="color: var(--color-accent-warm-text);">
                到 Product Hunt 看更多 →
              </a>
            </div>
          </div>
        )}
      </div>

      <div data-section="papers" class="section-content hidden">
        <div class="flex gap-1 mb-3" style="border-bottom: 1px solid var(--color-border);">
          <button type="button" data-paper-tab="hot" class="tab-btn tab-active">熱門</button>
          <button type="button" data-paper-tab="likes" class="tab-btn">最受喜愛</button>
        </div>
        <p class="text-xs mb-3" style="color: var(--color-text-muted);">
          <a href="https://www.alphaxiv.org" target="_blank" rel="noopener" style="color: var(--color-accent-cool-text); text-decoration: underline;">alphaXiv</a> 前 20 名{papersUpdated && `，更新於 ${papersUpdated}`}。
        </p>
        <div class="flex gap-1.5 flex-wrap mb-4" id="paper-filters"></div>

        {/* Hot papers */}
        <div data-paper-content="hot" class="space-y-0.5">
          {(papers.hot || []).map((p: any) => (
            <a href={p.alphaxivUrl} target="_blank" rel="noopener" class="paper-row" data-paper-cats={(p.categories || []).join(",")}>

              <span class="paper-rank">{p.rank}</span>
              <div style="flex: 1; min-width: 0;">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold" style="color: var(--color-text);">{p.title}</span>
                  <ExternalIcon />
                </div>
                {p.summary && (
                  <p class="text-xs mt-1 leading-relaxed paper-summary">{p.summary}</p>
                )}
                <div class="flex items-center gap-2 mt-1.5 flex-wrap">
                  {p.authors?.length > 0 && (
                    <span class="text-xs" style="color: var(--color-text-muted);">{p.authors.slice(0, 3).join(", ")}{p.authors.length > 3 ? " et al." : ""}</span>
                  )}
                  {p.date && <span class="meta">{p.date}</span>}
                  <span class="paper-stat">{p.votes.toLocaleString()} 票</span>
                  <span class="paper-stat">{p.visits.toLocaleString()} 次瀏覽</span>
                  {p.ghStars > 0 && <span class="paper-stat">☆ {p.ghStars.toLocaleString()}</span>}
                  {p.categories?.length > 0 && p.categories.map((c: string) => (
                    <span class="paper-cat">{c}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>

        {/* Liked papers */}
        <div data-paper-content="likes" class="space-y-0.5 hidden">
          {(papers.likes || []).map((p: any) => (
            <a href={p.alphaxivUrl} target="_blank" rel="noopener" class="paper-row" data-paper-cats={(p.categories || []).join(",")}>

              <span class="paper-rank">{p.rank}</span>
              <div style="flex: 1; min-width: 0;">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold" style="color: var(--color-text);">{p.title}</span>
                  <ExternalIcon />
                </div>
                {p.summary && (
                  <p class="text-xs mt-1 leading-relaxed paper-summary">{p.summary}</p>
                )}
                <div class="flex items-center gap-2 mt-1.5 flex-wrap">
                  {p.authors?.length > 0 && (
                    <span class="text-xs" style="color: var(--color-text-muted);">{p.authors.slice(0, 3).join(", ")}{p.authors.length > 3 ? " et al." : ""}</span>
                  )}
                  {p.date && <span class="meta">{p.date}</span>}
                  <span class="paper-stat">{p.votes.toLocaleString()} 票</span>
                  <span class="paper-stat">{p.visits.toLocaleString()} 次瀏覽</span>
                  {p.ghStars > 0 && <span class="paper-stat">☆ {p.ghStars.toLocaleString()}</span>}
                  {p.categories?.length > 0 && p.categories.map((c: string) => (
                    <span class="paper-cat">{c}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div data-section="mcpservers" class="section-content hidden">
        <p class="text-xs mb-3" style="color: var(--color-text-muted);">
          <a href="https://mcpmarket.com/leaderboards" target="_blank" rel="noopener" style="color: var(--color-accent-cool-text); text-decoration: underline;">MCP Market</a> 前 50 名，依 GitHub star 數排序{mcpUpdated && `，更新於 ${mcpUpdated}`}。
        </p>
        <div class="flex gap-1.5 flex-wrap mb-4" id="mcp-server-filters"></div>
        <div class="space-y-0.5">
          {mcpServers.map((s: any) => (
            <a href={s.url || `https://mcpmarket.com/server/${s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
               target="_blank" rel="noopener" class="mcp-row" data-mcp-cat={s.category} data-mcp-section="servers">
              <span class:list={["mcp-rank", { "mcp-rank-top": s.rank <= 3 }]}>{s.rank}</span>
              <div style="flex: 1; min-width: 0;">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold" style="color: var(--color-text);">{s.name}</span>
                  <ExternalIcon />
                </div>
                {s.description && (
                  <p class="text-xs mt-0.5 leading-relaxed mcp-desc">{s.description}</p>
                )}
                <div class="flex items-center gap-2 mt-1 flex-wrap">
                  {s.category && <span class="mcp-cat">{s.category}</span>}
                  <span class="mcp-stat">☆ {s.stars.toLocaleString()}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div data-section="skills" class="section-content hidden">
        <p class="text-xs mb-3" style="color: var(--color-text-muted);">
          <a href="https://mcpmarket.com/tools/skills/leaderboard" target="_blank" rel="noopener" style="color: var(--color-accent-cool-text); text-decoration: underline;">MCP Market</a> 前 50 名，依 GitHub star 數排序{mcpUpdated && `，更新於 ${mcpUpdated}`}。
        </p>
        <div class="flex gap-1.5 flex-wrap mb-4" id="mcp-skill-filters"></div>
        <div class="space-y-0.5">
          {mcpSkills.map((s: any) => (
            <a href={s.url || `https://mcpmarket.com/tools/skills/${s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
               target="_blank" rel="noopener" class="mcp-row" data-mcp-cat={s.category} data-mcp-section="skills">
              <span class:list={["mcp-rank", { "mcp-rank-top": s.rank <= 3 }]}>{s.rank}</span>
              <div style="flex: 1; min-width: 0;">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold" style="color: var(--color-text);">{s.name}</span>
                  <ExternalIcon />
                </div>
                {s.description && (
                  <p class="text-xs mt-0.5 leading-relaxed mcp-desc">{s.description}</p>
                )}
                <div class="flex items-center gap-2 mt-1 flex-wrap">
                  {s.category && <span class="mcp-cat">{s.category}</span>}
                  <span class="mcp-stat">☆ {s.stars.toLocaleString()}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .top-tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 0 -1rem;
    padding: 0 1rem;
  }
  .top-tabs::-webkit-scrollbar { display: none; }
  .top-tabs .tab-pill {
    flex-shrink: 0;
    min-height: 40px;
    white-space: nowrap;
    font-size: 0.9375rem;
    padding: 0.5rem 1.25rem;
  }
  .trend-more { display: inline-flex; align-items: center; min-height: 40px; }
  .tab-pill-icon {
    font-size: 1.125rem;
    line-height: 1;
  }

  /* Language tabs and repo rows are built in the browser, where scoped
     styles cannot reach them. */
  :global(.tab-btn) {
    cursor: pointer;
    min-height: 40px;
    border-radius: 0.375rem 0.375rem 0 0;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.15s;
    border: 1px solid transparent;
    border-bottom: none;
    background: transparent;
    margin-bottom: -1px;
    color: var(--color-text-muted);
  }
  :global(.tab-btn:hover) {
    background-color: var(--color-surface-muted);
  }
  :global(.tab-btn.tab-active) {
    background-color: var(--color-surface-raised);
    border-color: var(--color-border);
    color: var(--color-text);
  }
  :global(.tab-btn-count) { margin-left: 0.25rem; }

  :global(.repo-panel) {
    flex-direction: column;
    gap: 0.25rem;
  }
  :global(.repo-row) {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  :global(a.repo-row:hover) {
    background-color: var(--color-surface-muted);
  }
  :global(.repo-rank) { min-width: 1.5rem; text-align: right; }
  :global(.repo-body) { flex: 1; min-width: 0; }
  :global(.repo-title-line) { display: flex; align-items: center; gap: 0.5rem; }
  :global(.repo-name) { font-weight: 600; color: var(--color-text); overflow-wrap: anywhere; }
  :global(.repo-desc) { color: var(--color-text-muted); margin-top: 0.25rem; line-height: 1.5; }

  .product-row {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  .product-row:hover {
    background-color: var(--color-surface-muted);
  }
  .product-rank {
    min-width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted-on-muted);
    background-color: var(--color-surface-muted);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .product-rank-top {
    color: var(--color-accent-warm-text);
    background-color: color-mix(in srgb, var(--color-accent-warm) 12%, transparent);
  }

  .paper-row {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  .paper-row:hover {
    background-color: var(--color-surface-muted);
  }
  .paper-rank {
    min-width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-accent-cool-text);
    background-color: color-mix(in srgb, var(--color-accent-cool) 10%, transparent);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  :global(.paper-filter) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  :global(.paper-filter:hover) {
    background-color: color-mix(in srgb, var(--color-accent-purple) 8%, transparent);
    border-color: var(--color-accent-purple);
    color: var(--color-text);
  }
  :global(.paper-filter-active) {
    background-color: color-mix(in srgb, var(--color-accent-purple) 12%, transparent);
    border-color: var(--color-accent-purple);
    color: var(--color-accent-purple-text);
    font-weight: 600;
  }
  .paper-summary {
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .paper-stat {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
  .paper-cat {
    font-size: 0.625rem;
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
    color: var(--color-accent-purple-text);
    background-color: color-mix(in srgb, var(--color-accent-purple) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-purple) 20%, transparent);
  }

  .mcp-row {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  .mcp-row:hover {
    background-color: var(--color-surface-muted);
  }
  .mcp-rank {
    min-width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted-on-muted);
    background-color: var(--color-surface-muted);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .mcp-rank-top {
    color: var(--color-accent-cool-text);
    background-color: color-mix(in srgb, var(--color-accent-cool) 10%, transparent);
  }
  .mcp-desc {
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mcp-cat {
    font-size: 0.625rem;
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
    color: var(--color-accent-cool-text);
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .mcp-stat {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
  :global(.mcp-filter) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  :global(.mcp-filter:hover) {
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border-color: var(--color-accent-cool);
    color: var(--color-text);
  }
  :global(.mcp-filter-active) {
    background-color: color-mix(in srgb, var(--color-accent-cool) 10%, transparent);
    border-color: var(--color-accent-cool);
    color: var(--color-accent-cool-text);
    font-weight: 600;
  }
</style>

<script>
  function initTopTabs() {
    const topTabs = document.getElementById("top-tabs");
    if (!topTabs || topTabs.dataset.bound) return;
    topTabs.dataset.bound = "true";

    topTabs.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-top]") as HTMLElement | null;
      if (!btn) return;
      const key = btn.dataset.top!;
      switchTopTab(key);
      history.replaceState(null, "", `#${key}`);
    });
  }

  // Fetched in the browser so the list is live rather than as old as the last build.
  const FEEDS = [
    { key: "all", label: "全部語言", url: "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml" },
    { key: "python", label: "Python", url: "https://mshibanami.github.io/GitHubTrendingRSS/daily/python.xml" },
    { key: "typescript", label: "TypeScript", url: "https://mshibanami.github.io/GitHubTrendingRSS/daily/typescript.xml" },
    { key: "rust", label: "Rust", url: "https://mshibanami.github.io/GitHubTrendingRSS/daily/rust.xml" },
    { key: "go", label: "Go", url: "https://mshibanami.github.io/GitHubTrendingRSS/daily/go.xml" },
  ];

  type Repo = { name: string; url: string; description: string };
  type FeedResult = { key: string; label: string; repos: Repo[] };

  // The feed description is an HTML fragment with the summary in a <p>.
  // DOMParser in "text/html" mode never runs scripts or loads images, so
  // reading textContent from it cannot execute anything the feed carries.
  function parseDescription(html: string): string {
    const match = html.match(/<p>(.*?)<\/p>/s);
    if (!match) return "";
    const doc = new DOMParser().parseFromString(match[1], "text/html");
    return (doc.body.textContent || "").trim().slice(0, 200);
  }

  function safeRepoUrl(url: string): string | null {
    const u = url.trim();
    return u.startsWith("https://github.com/") ? u : null;
  }

  function parseRSS(xml: string): Repo[] {
    const doc = new DOMParser().parseFromString(xml, "text/xml");
    const repos: Repo[] = [];
    doc.querySelectorAll("item").forEach(item => {
      const title = item.querySelector("title")?.textContent || "";
      const link = item.querySelector("link")?.textContent || "";
      const desc = item.querySelector("description")?.textContent || "";
      repos.push({ name: title, url: link, description: parseDescription(desc) });
    });
    return repos;
  }

  const SVG_NS = "http://www.w3.org/2000/svg";

  function externalIcon(): SVGSVGElement {
    const svg = document.createElementNS(SVG_NS, "svg");
    svg.setAttribute("class", "h-3 w-3");
    svg.setAttribute("viewBox", "0 0 16 16");
    svg.setAttribute("aria-hidden", "true");
    svg.style.color = "var(--color-text-muted)";
    const path = document.createElementNS(SVG_NS, "path");
    path.setAttribute("d", "M4 12L12 4M12 4H6M12 4v6");
    path.setAttribute("fill", "none");
    path.setAttribute("stroke", "currentColor");
    path.setAttribute("stroke-width", "1.5");
    path.setAttribute("stroke-linecap", "round");
    path.setAttribute("stroke-linejoin", "round");
    svg.appendChild(path);
    return svg;
  }

  // Feed fields are third-party text, so they only ever reach the DOM through
  // textContent and a github.com-only href.
  function renderRepos(repos: Repo[]): HTMLElement[] {
    if (repos.length === 0) {
      const p = document.createElement("p");
      p.className = "text-sm";
      p.style.color = "var(--color-text-muted)";
      p.textContent = "目前沒有抓到熱門 repo。";
      return [p];
    }
    return repos.map((repo, i) => {
      const href = safeRepoUrl(repo.url);
      const row = document.createElement(href ? "a" : "div");
      row.className = "repo-row";
      if (href && row instanceof HTMLAnchorElement) {
        row.href = href;
        row.target = "_blank";
        row.rel = "noopener noreferrer";
      }

      const rank = document.createElement("span");
      rank.className = "meta repo-rank";
      rank.textContent = String(i + 1);

      const body = document.createElement("div");
      body.className = "repo-body";
      const titleLine = document.createElement("div");
      titleLine.className = "repo-title-line";
      const name = document.createElement("span");
      name.className = "text-sm repo-name";
      name.textContent = repo.name;
      titleLine.append(name);
      if (href) titleLine.append(externalIcon());
      body.append(titleLine);

      if (repo.description) {
        const desc = document.createElement("p");
        desc.className = "text-xs repo-desc";
        desc.textContent = repo.description;
        body.append(desc);
      }

      row.append(rank, body);
      return row;
    });
  }

  async function loadTrending() {
    const tabsEl = document.getElementById("lang-tabs");
    const containerEl = document.getElementById("repos-container");
    const timeEl = document.getElementById("update-time");
    if (!tabsEl || !containerEl || !timeEl) return;

    const results: FeedResult[] = [];
    const fetches = FEEDS.map(async (feed) => {
      try {
        const resp = await fetch(feed.url);
        const xml = await resp.text();
        return { key: feed.key, label: feed.label, repos: parseRSS(xml) };
      } catch {
        return { key: feed.key, label: feed.label, repos: [] };
      }
    });

    const settled = await Promise.all(fetches);
    results.push(...settled);

    const tabButtons = results.map((feed, i) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.dataset.tab = feed.key;
      btn.className = i === 0 ? "tab-btn tab-active" : "tab-btn";
      btn.append(`${feed.label} `);
      const count = document.createElement("span");
      count.className = "meta tab-btn-count";
      count.textContent = `(${feed.repos.length})`;
      btn.append(count);
      return btn;
    });
    tabsEl.replaceChildren(...tabButtons);

    containerEl.replaceChildren(...results.map((feed, i) => {
      const panel = document.createElement("div");
      panel.dataset.tabContent = feed.key;
      panel.className = "repo-panel";
      panel.style.display = i === 0 ? "flex" : "none";
      panel.append(...renderRepos(feed.repos));
      return panel;
    }));

    function switchTab(activeKey: string) {
      tabsEl!.querySelectorAll(".tab-btn").forEach(b => {
        b.classList.toggle("tab-active", b.getAttribute("data-tab") === activeKey);
      });
      containerEl!.querySelectorAll<HTMLElement>("[data-tab-content]").forEach(c => {
        c.style.display = c.getAttribute("data-tab-content") === activeKey ? "flex" : "none";
      });
    }

    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => switchTab(btn.dataset.tab!));
    });

    const now = new Date();
    timeEl.textContent = `即時抓取於 ${now.toLocaleString("zh-TW", { hour12: false })}`;
  }

  function switchTopTab(key: string) {
    const topTabs = document.getElementById("top-tabs");
    if (!topTabs) return;
    topTabs.querySelectorAll(".tab-pill").forEach(b =>
      b.classList.toggle("tab-pill-active", (b as HTMLElement).dataset.top === key)
    );
    document.querySelectorAll(".section-content").forEach(s =>
      s.classList.toggle("hidden", (s as HTMLElement).dataset.section !== key)
    );
  }

  function restoreFromHash() {
    const hash = window.location.hash.replace("#", "");
    if (["repos", "products", "papers", "mcpservers", "skills"].includes(hash)) {
      switchTopTab(hash);
    }
  }

  // Category names come from scraped leaderboards, so they are set as text.
  function filterButton(dataKey: string, value: string, label: string, className: string): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = className;
    btn.dataset[dataKey] = value;
    btn.textContent = label;
    return btn;
  }

  function initMcpFilters() {
    const sections = [
      { filterId: "mcp-server-filters", sectionAttr: "servers" },
      { filterId: "mcp-skill-filters", sectionAttr: "skills" },
    ];

    for (const { filterId, sectionAttr } of sections) {
      const filtersEl = document.getElementById(filterId);
      if (!filtersEl || filtersEl.dataset.bound) continue;
      filtersEl.dataset.bound = "true";

      const rows = document.querySelectorAll<HTMLElement>(`.mcp-row[data-mcp-section="${sectionAttr}"]`);
      const catCount: Record<string, number> = {};
      rows.forEach(row => {
        const cat = row.dataset.mcpCat || "";
        if (cat) catCount[cat] = (catCount[cat] || 0) + 1;
      });

      const sorted = Object.entries(catCount).sort((a, b) => b[1] - a[1]);
      filtersEl.replaceChildren(
        filterButton("mcpFilter", "all", "全部", "mcp-filter mcp-filter-active"),
        ...sorted.map(([cat]) => filterButton("mcpFilter", cat, cat, "mcp-filter")),
      );

      filtersEl.querySelectorAll<HTMLButtonElement>("[data-mcp-filter]").forEach(btn => {
        btn.addEventListener("click", () => {
          const cat = btn.dataset.mcpFilter!;
          filtersEl!.querySelectorAll(".mcp-filter").forEach(b =>
            b.classList.toggle("mcp-filter-active", (b as HTMLElement).dataset.mcpFilter === cat)
          );
          rows.forEach(row => {
            if (cat === "all") {
              row.style.display = "";
            } else {
              row.style.display = row.dataset.mcpCat === cat ? "" : "none";
            }
          });
        });
      });
    }
  }

  function initPaperTabs() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>("[data-paper-tab]");
    const filtersEl = document.getElementById("paper-filters");
    let activeTab = "hot";

    function buildFilters() {
      if (!filtersEl) return;
      const activeContent = document.querySelector<HTMLElement>(`[data-paper-content="${activeTab}"]`);
      if (!activeContent) return;

      const catCount: Record<string, number> = {};
      activeContent.querySelectorAll<HTMLElement>(".paper-row").forEach(row => {
        for (const c of (row.dataset.paperCats || "").split(",")) {
          if (c && c !== "computer-science") catCount[c] = (catCount[c] || 0) + 1;
        }
      });

      const sorted = Object.entries(catCount).sort((a, b) => b[1] - a[1]);
      filtersEl.replaceChildren(
        filterButton("catFilter", "all", "全部", "paper-filter paper-filter-active"),
        ...sorted.map(([cat]) => filterButton("catFilter", cat, cat, "paper-filter")),
      );

      filtersEl.querySelectorAll<HTMLButtonElement>("[data-cat-filter]").forEach(btn => {
        btn.addEventListener("click", () => {
          const cat = btn.dataset.catFilter!;
          filtersEl!.querySelectorAll(".paper-filter").forEach(b =>
            b.classList.toggle("paper-filter-active", (b as HTMLElement).dataset.catFilter === cat)
          );
          document.querySelectorAll<HTMLElement>(".paper-row").forEach(row => {
            if (cat === "all") {
              row.style.display = "";
            } else {
              const cats = (row.dataset.paperCats || "").split(",");
              row.style.display = cats.includes(cat) ? "" : "none";
            }
          });
        });
      });
    }

    tabBtns.forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        activeTab = btn.dataset.paperTab!;
        tabBtns.forEach(b => b.classList.toggle("tab-active", b.dataset.paperTab === activeTab));
        document.querySelectorAll<HTMLElement>("[data-paper-content]").forEach(c =>
          c.classList.toggle("hidden", c.dataset.paperContent !== activeTab)
        );
        // The two tabs have different categories, so the filter starts over.
        document.querySelectorAll<HTMLElement>(".paper-row").forEach(row => row.style.display = "");
        buildFilters();
      });
    });

    buildFilters();
  }

  function init() {
    initTopTabs();
    initPaperTabs();
    initMcpFilters();
    loadTrending();
    restoreFromHash();
  }

  // astro:page-load also fires on the first load, so calling init() directly
  // as well would fetch the feeds twice.
  document.addEventListener("astro:page-load", init);
</script>
