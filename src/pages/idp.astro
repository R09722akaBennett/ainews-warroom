---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ExternalIcon from "@components/ExternalIcon.astro";
import { marked } from "marked";

import idpData from "../data/idp.json";

const items = (idpData as any[]) || [];

const recaps = items.filter(i => i.kind === "weekly_recap");
const opinions = items.filter(i => i.kind === "opinion");

// Collect all vendors across all items
const vendorSet = new Set<string>();
for (const it of items) {
  for (const v of (it.vendors || [])) vendorSet.add(v);
}
const allVendors = [...vendorSet].sort((a, b) => a.localeCompare(b));

function renderMd(md: string | null | undefined) {
  if (!md) return "";
  return marked.parse(md) as string;
}
---

<Layout title="IDP" description="Intelligent Document Processing — industry weekly recaps & analysis">
  <Container>
    <div class="space-y-8">
      <div>
        <div class="section-title mb-2">External Industry Coverage</div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">IDP Community</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
          Translated weekly recaps and analysis articles from <a href="https://www.intelligentdocumentprocessing.com/" target="_blank" rel="noopener" class="underline">intelligentdocumentprocessing.com</a> — the leading independent IDP industry portal.
          {recaps.length} weekly recaps · {opinions.length} opinions.
        </p>
        <p class="mt-2 text-xs" style="color: var(--color-text-muted);">
          ⚠️ The site is currently seeking a new owner / consortium. Content may stop updating without notice.
        </p>
      </div>

      {items.length === 0 ? (
        <div class="card p-12 text-center">
          <p class="text-lg font-semibold mb-2" style="color: var(--color-text);">No IDP data yet</p>
          <p class="text-sm" style="color: var(--color-text-muted);">Run <code>uv run python -m idp</code> to fetch the RSS feed.</p>
        </div>
      ) : (
        <>
          {/* Vendor filter */}
          {allVendors.length > 0 && (
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Filter by vendor</div>
              <div class="flex gap-1.5 flex-wrap" id="vendor-filters">
                <button data-vendor="all" class="tab-pill tab-pill-active">
                  All<span class="tab-pill-count">{items.length}</span>
                </button>
                {allVendors.map(v => {
                  const count = items.filter(it => (it.vendors || []).includes(v)).length;
                  return (
                    <button data-vendor={v} class="tab-pill">
                      {v}<span class="tab-pill-count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          {/* Kind tabs */}
          <div class="flex gap-1.5 flex-wrap" id="kind-tabs">
            <button data-kind="all" class="tab-pill tab-pill-active">All<span class="tab-pill-count">{items.length}</span></button>
            <button data-kind="weekly_recap" class="tab-pill">Weekly Recap<span class="tab-pill-count">{recaps.length}</span></button>
            <button data-kind="opinion" class="tab-pill">Opinions<span class="tab-pill-count">{opinions.length}</span></button>
          </div>

          {/* Items */}
          <div class="space-y-3" id="idp-items">
            {items.map((it: any) => {
              const html = renderMd(it.translatedMd);
              const vendorAttr = (it.vendors || []).join("|");
              return (
                <details
                  class="card card-accent-cool group idp-item"
                  data-kind={it.kind}
                  data-vendors={vendorAttr}
                  open={it.kind === "weekly_recap"}
                >
                  <summary class="flex cursor-pointer items-center gap-4 px-5 py-4">
                    <span class={`kind-badge kind-${it.kind}`}>{it.kind === "weekly_recap" ? "週報" : it.kind === "opinion" ? "評論" : "新聞"}</span>
                    <span class="meta min-w-[6rem]">{it.publishedAt || ""}</span>
                    <span class="flex-1 text-sm font-medium" style="color: var(--color-text);">
                      {it.translatedTitle || it.title}
                    </span>
                    {it.vendors && it.vendors.length > 0 && (
                      <span class="hidden sm:flex gap-1 flex-wrap justify-end max-w-[14rem]">
                        {it.vendors.slice(0, 4).map((v: string) => <span class="vendor-chip">{v}</span>)}
                      </span>
                    )}
                    <svg class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 16 16" fill="currentColor" style="color: var(--color-text-muted);">
                      <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </summary>
                  <div class="px-5 pb-5 pt-2 space-y-3" style="border-top: 1px solid var(--color-border);">
                    {html ? (
                      <article class="prose-idp" set:html={html} />
                    ) : (
                      <p class="text-sm" style="color: var(--color-text-muted);">尚未翻譯</p>
                    )}
                    <div class="flex items-center gap-3 text-xs pt-2" style="color: var(--color-text-muted);">
                      <a href={it.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 underline">
                        原文連結 <ExternalIcon />
                      </a>
                      {it.tokenUsage && (
                        <span class="meta">In: {it.tokenUsage.input?.toLocaleString()} · Out: {it.tokenUsage.output?.toLocaleString()}</span>
                      )}
                    </div>
                  </div>
                </details>
              );
            })}
          </div>
        </>
      )}
    </div>
  </Container>
</Layout>

<style>
  .kind-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    flex-shrink: 0;
  }
  .kind-weekly_recap { background: color-mix(in srgb, var(--color-accent-cool) 18%, transparent); color: var(--color-accent-cool); }
  .kind-opinion { background: color-mix(in srgb, var(--color-accent-purple) 18%, transparent); color: var(--color-accent-purple); }
  .kind-news { background: var(--color-surface-muted); color: var(--color-text-muted); }

  .vendor-chip {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.625rem;
    font-weight: 500;
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  :global(.prose-idp) {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text);
  }
  :global(.prose-idp ol),
  :global(.prose-idp ul) { padding-left: 1.25rem; margin: 0.5rem 0; }
  :global(.prose-idp li) { margin: 0.35rem 0; }
  :global(.prose-idp p) { margin: 0.5rem 0; }
  :global(.prose-idp strong) { color: var(--color-text); font-weight: 600; }
  :global(.prose-idp a) { color: var(--color-accent-cool); text-decoration: underline; text-underline-offset: 2px; }
  :global(.prose-idp h1),
  :global(.prose-idp h2),
  :global(.prose-idp h3) { font-weight: 600; margin: 0.75rem 0 0.35rem; color: var(--color-text); }
</style>

<script>
  function initIdp() {
    let activeKind = "all";
    let activeVendor = "all";
    const items = document.querySelectorAll<HTMLElement>(".idp-item");

    function apply() {
      items.forEach(el => {
        const kind = el.dataset.kind || "";
        const vendors = (el.dataset.vendors || "").split("|").filter(Boolean);
        const matchKind = activeKind === "all" || kind === activeKind;
        const matchVendor = activeVendor === "all" || vendors.includes(activeVendor);
        el.style.display = (matchKind && matchVendor) ? "" : "none";
      });
    }

    document.querySelectorAll<HTMLButtonElement>("#kind-tabs .tab-pill").forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        activeKind = btn.dataset.kind!;
        document.querySelectorAll("#kind-tabs .tab-pill").forEach(b => b.classList.toggle("tab-pill-active", (b as HTMLElement).dataset.kind === activeKind));
        apply();
      });
    });

    document.querySelectorAll<HTMLButtonElement>("#vendor-filters .tab-pill").forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        activeVendor = btn.dataset.vendor!;
        document.querySelectorAll("#vendor-filters .tab-pill").forEach(b => b.classList.toggle("tab-pill-active", (b as HTMLElement).dataset.vendor === activeVendor));
        apply();
      });
    });
  }

  initIdp();
  document.addEventListener("astro:page-load", initIdp);
</script>
