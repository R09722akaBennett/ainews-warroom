---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import { SITE_SINCE } from "@consts";
import reportsData from "../data/reports.json";

type SourceItem = { url: string; title: string; source: string };
type SourceGroup = { name: string; items: SourceItem[] };
type DayData = { groups: SourceGroup[]; total: number };

const reports = reportsData.filter((r: any) => r.date >= SITE_SINCE);

const byDate: Record<string, DayData> = {};
for (const report of reports as any[]) {
  const bySource: Record<string, SourceItem[]> = {};
  for (const item of (report.newsItems || []) as SourceItem[]) {
    if (!item?.url) continue;
    (bySource[item.source || "Other"] ||= []).push(item);
  }
  const groups = Object.entries(bySource)
    .map(([name, items]) => ({ name, items }))
    .sort((a, b) => b.items.length - a.items.length || a.name.localeCompare(b.name));
  byDate[report.date] = { groups, total: groups.reduce((sum, g) => sum + g.items.length, 0) };
}

const dates = Object.keys(byDate).sort().reverse();
const totalItems = dates.reduce((sum, d) => sum + byDate[d].total, 0);
---

<Layout title="Sources" description="News items behind each daily report, grouped by source">
  <Container>
    <div class="space-y-8">
      <div>
        <div class="section-title mb-2">Daily Feed</div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Sources</h1>
        <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-text-muted);">
          每日快報引用的新聞,依日期與<a href="/about" style="color: var(--color-accent-cool); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">來源</a>分組。{SITE_SINCE} 起共 {totalItems} 則,{dates.length} 天。
        </p>
      </div>

      {dates.map((date) => {
        const { groups, total } = byDate[date];
        return (
          <section>
            <details class="group">
              <summary class="day-header">
                <div class="flex items-center gap-3 flex-1">
                  <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);" aria-hidden="true">
                    <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span class="text-base font-semibold" style="color: var(--color-text);">{date}</span>
                  <span class="meta">{total} items · {groups.length} sources</span>
                </div>
                <a href={`/reports/${date}`} class="report-link" onclick="event.stopPropagation();">
                  View Report →
                </a>
              </summary>

              <div class="source-groups">
                {groups.map((group) => (
                  <details class="group/src">
                    <summary class="source-header">
                      <svg class="size-3 shrink-0 transition-transform duration-200 group-open/src:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);" aria-hidden="true">
                        <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                      <span class="source-chip">{group.name}</span>
                      <span class="meta">{group.items.length}</span>
                    </summary>
                    <div class="news-list">
                      {group.items.map((item, i) => (
                        <a href={item.url} target="_blank" rel="noopener noreferrer" class="news-item">
                          <span class="news-rank">{i + 1}</span>
                          <div class="news-content">
                            <span class="news-title">{item.title}</span>
                            <svg class="news-external" viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M4 12L12 4M12 4H6M12 4v6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </div>
                        </a>
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            </details>
          </section>
        );
      })}

      {dates.length === 0 && (
        <div class="text-center py-12">
          <p class="text-sm" style="color: var(--color-text-muted);">
            No news data collected yet. Data will appear after the daily pipeline runs.
          </p>
        </div>
      )}
    </div>
  </Container>
</Layout>

<style>
  .day-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-raised);
    transition: background-color 0.15s;
  }
  .day-header:hover {
    background-color: var(--color-surface-muted);
  }
  .report-link {
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-accent-warm);
    white-space: nowrap;
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
    transition: background-color 0.15s;
  }
  .report-link:hover {
    background-color: color-mix(in srgb, var(--color-accent-warm) 10%, transparent);
  }
  .source-groups {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
    padding-left: 0.5rem;
  }
  .source-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  .source-header:hover {
    background-color: var(--color-surface-muted);
  }
  .source-chip {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent-cool);
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
  }
  .news-list {
    display: flex;
    flex-direction: column;
    margin-left: 1.75rem;
    border-left: 1px solid var(--color-border);
  }
  .news-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    text-decoration: none;
    transition: background-color 0.15s;
    border-radius: 0 0.25rem 0.25rem 0;
  }
  .news-item:hover {
    background-color: var(--color-surface-muted);
  }
  .news-rank {
    min-width: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-align: right;
    flex-shrink: 0;
  }
  .news-content {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }
  .news-title {
    font-size: 0.8125rem;
    color: var(--color-text);
    line-height: 1.5;
  }
  .news-external {
    width: 0.625rem;
    height: 0.625rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .news-item:hover .news-external {
    opacity: 1;
  }
</style>
