---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import reportsData from "../data/reports.json";
import sourcesData from "../data/sources.json";
import summariesData from "../data/summaries.json";

const reports = reportsData as any[];
const sources = sourcesData as any[];
const summaries = summariesData as any[];

// === Source Quality Analytics ===
// Count raw items per source
const sourceCollected: Record<string, number> = {};
for (const s of sources) {
  sourceCollected[s.source] = (sourceCollected[s.source] || 0) + 1;
}

// Count how many times each source was referenced in reports (via newsItems)
const sourceReferenced: Record<string, number> = {};
for (const r of reports) {
  for (const item of r.newsItems || []) {
    const src = item.source || "";
    if (src) sourceReferenced[src] = (sourceReferenced[src] || 0) + 1;
  }
}

// Build source quality table
type SourceRow = { source: string; collected: number; referenced: number; rate: number };
const sourceRows: SourceRow[] = Object.keys(sourceCollected).map(src => {
  const collected = sourceCollected[src];
  const referenced = sourceReferenced[src] || 0;
  return { source: src, collected, referenced, rate: collected > 0 ? referenced / collected : 0 };
}).sort((a, b) => b.referenced - a.referenced || b.collected - a.collected);

// === Tag Trend Data ===
// Build date → tags mapping for chart
const tagDates: string[] = reports.map((r: any) => r.date).sort();
const tagsByDate: Record<string, { companies: string[]; models: string[]; topics: string[] }> = {};
for (const r of reports) {
  tagsByDate[r.date] = {
    companies: r.tags?.companies || [],
    models: r.tags?.models || [],
    topics: r.tags?.topics || [],
  };
}

// Collect all unique tags with their type and frequency
type TagInfo = { tag: string; type: string; count: number; dates: string[] };
const tagMap = new Map<string, TagInfo>();
for (const r of reports) {
  const date = r.date;
  for (const [type, tags] of Object.entries(r.tags || {}) as [string, string[]][]) {
    for (const tag of tags) {
      const key = `${type}:${tag}`;
      if (!tagMap.has(key)) {
        tagMap.set(key, { tag, type, count: 0, dates: [] });
      }
      const info = tagMap.get(key)!;
      info.count++;
      info.dates.push(date);
    }
  }
}
const allTags = Array.from(tagMap.values()).sort((a, b) => b.count - a.count);

// Prepare chart data (JSON for client-side)
const chartData = {
  dates: tagDates,
  tags: allTags.slice(0, 20).map(t => ({
    label: t.tag,
    type: t.type,
    data: tagDates.map(d => t.dates.includes(d) ? 1 : 0),
  })),
};

// === Token Cost Dashboard ===
// Gemini 3 Flash Preview pricing (per 1M tokens)
const PRICE_INPUT = 0.05;   // $0.05 / 1M input tokens
const PRICE_OUTPUT = 3.00;  // $3.00 / 1M output tokens (text + reasoning)

type TokenEntry = {
  label: string;
  date: string;
  type: string; // "daily" | period name
  input: number;
  output: number;
  total: number;
  cost: number;
};

const tokenEntries: TokenEntry[] = [];

// Daily reports
for (const r of reports) {
  const tu = r.tokenUsage;
  if (!tu) continue;
  const cost = (tu.input * PRICE_INPUT + tu.output * PRICE_OUTPUT) / 1_000_000;
  tokenEntries.push({
    label: r.title || r.date,
    date: r.date,
    type: "daily",
    input: tu.input,
    output: tu.output,
    total: tu.total,
    cost,
  });
}

// Periodic summaries
for (const s of summaries) {
  const tu = s.tokenUsage;
  if (!tu) continue;
  const cost = (tu.input * PRICE_INPUT + tu.output * PRICE_OUTPUT) / 1_000_000;
  tokenEntries.push({
    label: s.title || `${s.period} ${s.startDate}`,
    date: s.createdAt?.slice(0, 10) || s.startDate,
    type: s.period,
    input: tu.input,
    output: tu.output,
    total: tu.total,
    cost,
  });
}

tokenEntries.sort((a, b) => b.date.localeCompare(a.date));

const totalInput = tokenEntries.reduce((s, e) => s + e.input, 0);
const totalOutput = tokenEntries.reduce((s, e) => s + e.output, 0);
const totalTokens = tokenEntries.reduce((s, e) => s + e.total, 0);
const totalCost = tokenEntries.reduce((s, e) => s + e.cost, 0);

// Chart data: daily token usage over time
const tokenChartData = {
  dates: [...new Set(tokenEntries.map(e => e.date))].sort(),
  daily: {} as Record<string, { input: number; output: number }>,
};
for (const e of tokenEntries) {
  if (!tokenChartData.daily[e.date]) {
    tokenChartData.daily[e.date] = { input: 0, output: 0 };
  }
  tokenChartData.daily[e.date].input += e.input;
  tokenChartData.daily[e.date].output += e.output;
}
---

<Layout title="Analytics" description="Source quality and tag trend analytics">
  <Container>
    <div class="space-y-12">
      <div>
        <div class="section-title mb-2">Analytics</div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Analytics</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
          Source quality metrics and tag trend analysis across {reports.length} reports
        </p>
      </div>

      <!-- Token Cost Dashboard -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold" style="color: var(--color-text);">Token Usage & Cost</h2>
        <p class="text-xs" style="color: var(--color-text-muted);">
          Gemini 3 Flash Preview: ${PRICE_INPUT}/1M input · ${PRICE_OUTPUT}/1M output
        </p>

        {/* Summary cards */}
        <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
          <div class="card p-4 text-center">
            <div class="meta mb-1">Total Input</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);">{(totalInput / 1_000_000).toFixed(2)}M</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">Total Output</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);">{(totalOutput / 1_000_000).toFixed(2)}M</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">Total Tokens</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);">{(totalTokens / 1_000_000).toFixed(2)}M</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">Est. Cost</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-quarterly);">${totalCost.toFixed(4)}</div>
          </div>
        </div>

        {/* Token chart */}
        {tokenEntries.length > 0 ? (
          <div class="card p-4" style="position: relative; height: 300px;">
            <canvas id="token-chart"></canvas>
          </div>
        ) : (
          <div class="card p-8 text-center">
            <p class="text-sm" style="color: var(--color-text-muted);">No token data yet. Data will appear after the next pipeline run with token tracking enabled.</p>
          </div>
        )}

        {/* Detailed table */}
        {tokenEntries.length > 0 && (
          <details class="group">
            <summary class="flex cursor-pointer items-center gap-3 py-2 text-sm font-semibold" style="color: var(--color-text);">
              <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
                <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Detailed breakdown ({tokenEntries.length} LLM calls)
            </summary>
            <div class="overflow-x-auto mt-2">
              <table class="source-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th class="text-right">Input</th>
                    <th class="text-right">Output</th>
                    <th class="text-right">Total</th>
                    <th class="text-right">Cost</th>
                  </tr>
                </thead>
                <tbody>
                  {tokenEntries.map(e => (
                    <tr>
                      <td class="meta">{e.date}</td>
                      <td>
                        <span class={`period-label period-${e.type === "daily" ? "warroom" : e.type.includes("weekly") ? "weekly" : e.type.includes("monthly") ? "monthly" : "quarterly"}`}>
                          {e.type === "daily" ? "D" : e.type.replace("raw_", "").charAt(0).toUpperCase()}
                        </span>
                      </td>
                      <td class="text-right meta">{e.input.toLocaleString()}</td>
                      <td class="text-right meta">{e.output.toLocaleString()}</td>
                      <td class="text-right font-mono text-xs font-semibold" style="color: var(--color-text);">{e.total.toLocaleString()}</td>
                      <td class="text-right font-mono text-xs" style="color: var(--color-quarterly);">${e.cost.toFixed(4)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}
      </section>

      <!-- Tag Trend Timeline -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold" style="color: var(--color-text);">Tag Trends</h2>
          <div class="flex gap-1.5" id="tag-type-filters">
            <button data-type="all" class="tag-filter tag-filter-active">All</button>
            <button data-type="companies" class="tag-filter" style="--filter-color: #9333ea;">Companies</button>
            <button data-type="models" class="tag-filter" style="--filter-color: var(--color-accent-cool);">Models</button>
            <button data-type="topics" class="tag-filter" style="--filter-color: var(--color-accent-warm);">Topics</button>
          </div>
        </div>
        <p class="text-xs" style="color: var(--color-text-muted);">
          Top 20 tags across all reports. Each line shows whether a tag appeared in the daily report.
        </p>
        {allTags.length > 0 ? (
          <div class="card p-4" style="position: relative; height: 400px;">
            <canvas id="tag-chart"></canvas>
          </div>
        ) : (
          <div class="card p-8 text-center">
            <p class="text-sm" style="color: var(--color-text-muted);">Not enough data yet. Tag trends will appear as more daily reports accumulate.</p>
          </div>
        )}
      </section>

      <!-- Source Quality -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold" style="color: var(--color-text);">Source Quality</h2>
        <p class="text-xs" style="color: var(--color-text-muted);">
          How often each source's items get referenced in daily reports. High collection + low reference = noise source.
        </p>
        <div class="overflow-x-auto">
          <table class="source-table">
            <thead>
              <tr>
                <th>Source</th>
                <th class="text-right">Collected</th>
                <th class="text-right">Referenced</th>
                <th class="text-right">Rate</th>
                <th class="w-48">Distribution</th>
              </tr>
            </thead>
            <tbody>
              {sourceRows.map(row => {
                const barWidth = Math.min(row.rate * 100, 100);
                const barColor = row.rate > 0.5 ? "var(--color-quarterly)" : row.rate > 0.1 ? "var(--color-accent-cool)" : "var(--color-text-muted)";
                return (
                  <tr>
                    <td class="font-medium" style="color: var(--color-text);">{row.source}</td>
                    <td class="text-right meta">{row.collected}</td>
                    <td class="text-right meta">{row.referenced}</td>
                    <td class="text-right">
                      <span class="font-mono text-xs font-semibold" style={`color: ${barColor};`}>
                        {(row.rate * 100).toFixed(1)}%
                      </span>
                    </td>
                    <td>
                      <div class="bar-bg">
                        <div class="bar-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </Container>
</Layout>

<style>
  /* === Tag filters === */
  .tag-filter {
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .tag-filter:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
  .tag-filter-active {
    color: var(--filter-color, var(--color-text));
    border-color: var(--filter-color, var(--color-border));
    background-color: color-mix(in srgb, var(--filter-color, var(--color-surface-muted)) 10%, transparent);
    font-weight: 600;
  }

  /* === Source table === */
  .source-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .source-table th {
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-border);
  }
  .source-table td {
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .source-table tbody tr:hover {
    background-color: var(--color-surface-muted);
  }
  .bar-bg {
    height: 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--color-surface-muted);
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 0.25rem;
    transition: width 0.3s;
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

<script define:vars={{ chartData, tokenChartData }}>
  const TYPE_COLORS = {
    companies: { border: "#9333ea", bg: "rgba(147, 51, 234, 0.1)" },
    models: { border: "#0891b2", bg: "rgba(8, 145, 178, 0.1)" },
    topics: { border: "#d97706", bg: "rgba(217, 119, 6, 0.1)" },
  };

  function initTokenChart() {
    const canvas = document.getElementById("token-chart");
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = "true";

    const isDark = document.documentElement.classList.contains("dark");
    const gridColor = isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.06)";
    const textColor = isDark ? "#78859b" : "#78716c";

    const dates = tokenChartData.dates;
    const inputData = dates.map(d => (tokenChartData.daily[d]?.input || 0) / 1000);
    const outputData = dates.map(d => (tokenChartData.daily[d]?.output || 0) / 1000);

    new Chart(canvas, {
      type: "bar",
      data: {
        labels: dates,
        datasets: [
          {
            label: "Input (K)",
            data: inputData,
            backgroundColor: isDark ? "rgba(34, 211, 238, 0.5)" : "rgba(8, 145, 178, 0.5)",
            borderColor: isDark ? "#22d3ee" : "#0891b2",
            borderWidth: 1,
          },
          {
            label: "Output (K)",
            data: outputData,
            backgroundColor: isDark ? "rgba(245, 158, 11, 0.5)" : "rgba(217, 119, 6, 0.5)",
            borderColor: isDark ? "#f59e0b" : "#d97706",
            borderWidth: 1,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom",
            labels: { color: textColor, font: { size: 11, family: "Geist Mono, monospace" }, boxWidth: 12 },
          },
          tooltip: {
            backgroundColor: isDark ? "#141825" : "#fff",
            titleColor: isDark ? "#e7e5e4" : "#1c1917",
            bodyColor: isDark ? "#78859b" : "#78716c",
            borderColor: isDark ? "#252a3a" : "#e2e0dc",
            borderWidth: 1,
            callbacks: {
              label: (ctx) => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)}K tokens`,
            },
          },
        },
        scales: {
          x: {
            stacked: true,
            grid: { color: gridColor },
            ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } },
          },
          y: {
            stacked: true,
            grid: { color: gridColor },
            ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } },
            title: { display: true, text: "Tokens (K)", color: textColor, font: { size: 11 } },
          },
        },
      },
    });
  }

  function initAnalytics() {
    initTokenChart();

    const canvas = document.getElementById("tag-chart");
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = "true";

    const datasets = chartData.tags.map((tag, i) => {
      const colors = TYPE_COLORS[tag.type] || TYPE_COLORS.topics;
      // Cumulative count for timeline
      let cumulative = 0;
      const cumulativeData = tag.data.map(v => { cumulative += v; return cumulative; });

      return {
        label: tag.label,
        data: cumulativeData,
        borderColor: colors.border,
        backgroundColor: colors.bg,
        borderWidth: 2,
        pointRadius: 3,
        tension: 0.3,
        hidden: i >= 8, // Show top 8 by default
        _type: tag.type,
      };
    });

    const isDark = document.documentElement.classList.contains("dark");
    const gridColor = isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.06)";
    const textColor = isDark ? "#78859b" : "#78716c";

    const chart = new Chart(canvas, {
      type: "line",
      data: {
        labels: chartData.dates,
        datasets: datasets,
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: "index",
          intersect: false,
        },
        plugins: {
          legend: {
            position: "bottom",
            labels: {
              color: textColor,
              font: { size: 11, family: "Geist Mono, monospace" },
              boxWidth: 12,
              padding: 12,
            },
          },
          tooltip: {
            backgroundColor: isDark ? "#141825" : "#fff",
            titleColor: isDark ? "#e7e5e4" : "#1c1917",
            bodyColor: isDark ? "#78859b" : "#78716c",
            borderColor: isDark ? "#252a3a" : "#e2e0dc",
            borderWidth: 1,
          },
        },
        scales: {
          x: {
            grid: { color: gridColor },
            ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } },
          },
          y: {
            beginAtZero: true,
            grid: { color: gridColor },
            ticks: {
              color: textColor,
              font: { size: 10, family: "Geist Mono, monospace" },
              stepSize: 1,
            },
            title: {
              display: true,
              text: "Cumulative mentions",
              color: textColor,
              font: { size: 11 },
            },
          },
        },
      },
    });

    // Type filter buttons
    document.querySelectorAll("[data-type]").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = btn.dataset.type;
        document.querySelectorAll(".tag-filter").forEach(b =>
          b.classList.toggle("tag-filter-active", b.dataset.type === type)
        );
        chart.data.datasets.forEach((ds, i) => {
          if (type === "all") {
            ds.hidden = i >= 8;
          } else {
            ds.hidden = ds._type !== type;
          }
        });
        chart.update();
      });
    });
  }

  initAnalytics();
  document.addEventListener("astro:page-load", initAnalytics);
</script>
