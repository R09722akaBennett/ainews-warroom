---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import reportsData from "../data/reports.json";
import sourcesData from "../data/sources.json";
import summariesData from "../data/summaries.json";

const reports = reportsData as any[];
const sources = sourcesData as any[];
const summaries = summariesData as any[];

// === Source Quality Analytics ===
// Count raw items per source
const sourceCollected: Record<string, number> = {};
for (const s of sources) {
  sourceCollected[s.source] = (sourceCollected[s.source] || 0) + 1;
}

// Count how many times each source was referenced in reports (via newsItems)
const sourceReferenced: Record<string, number> = {};
for (const r of reports) {
  for (const item of r.newsItems || []) {
    const src = item.source || "";
    if (src) sourceReferenced[src] = (sourceReferenced[src] || 0) + 1;
  }
}

// Build source quality table
type SourceRow = { source: string; collected: number; referenced: number; rate: number };
const sourceRows: SourceRow[] = Object.keys(sourceCollected).map(src => {
  const collected = sourceCollected[src];
  const referenced = sourceReferenced[src] || 0;
  return { source: src, collected, referenced, rate: collected > 0 ? referenced / collected : 0 };
}).sort((a, b) => b.referenced - a.referenced || b.collected - a.collected);

// === Tag Trend Data ===
// Build date → tags mapping for chart
const tagDates: string[] = reports.map((r: any) => r.date).sort();
const tagsByDate: Record<string, { companies: string[]; models: string[]; topics: string[] }> = {};
for (const r of reports) {
  tagsByDate[r.date] = {
    companies: r.tags?.companies || [],
    models: r.tags?.models || [],
    topics: r.tags?.topics || [],
  };
}

// Collect all unique tags with their type and frequency
type TagInfo = { tag: string; type: string; count: number; dates: string[] };
const tagMap = new Map<string, TagInfo>();
for (const r of reports) {
  const date = r.date;
  for (const [type, tags] of Object.entries(r.tags || {}) as [string, string[]][]) {
    for (const tag of tags) {
      const key = `${type}:${tag}`;
      if (!tagMap.has(key)) {
        tagMap.set(key, { tag, type, count: 0, dates: [] });
      }
      const info = tagMap.get(key)!;
      info.count++;
      info.dates.push(date);
    }
  }
}
const allTags = Array.from(tagMap.values()).sort((a, b) => b.count - a.count);

// Prepare chart data (JSON for client-side)
const chartData = {
  dates: tagDates,
  tags: allTags.slice(0, 20).map(t => ({
    label: t.tag,
    type: t.type,
    data: tagDates.map(d => t.dates.includes(d) ? 1 : 0),
  })),
};

// === Token Cost Dashboard ===
// Gemini 3 Flash Preview pricing (per 1M tokens)
const PRICE_INPUT = 0.05;   // $0.05 / 1M input tokens
const PRICE_OUTPUT = 3.00;  // $3.00 / 1M output tokens (text + reasoning)

type TokenEntry = {
  label: string;
  date: string;
  type: string; // "daily" | period name
  input: number;
  output: number;
  total: number;
  cost: number;
};

const tokenEntries: TokenEntry[] = [];

// Daily reports
for (const r of reports) {
  const tu = r.tokenUsage;
  if (!tu) continue;
  const cost = (tu.input * PRICE_INPUT + tu.output * PRICE_OUTPUT) / 1_000_000;
  tokenEntries.push({
    label: r.title || r.date,
    date: r.date,
    type: "daily",
    input: tu.input,
    output: tu.output,
    total: tu.total,
    cost,
  });
}

// Periodic summaries
for (const s of summaries) {
  const tu = s.tokenUsage;
  if (!tu) continue;
  const cost = (tu.input * PRICE_INPUT + tu.output * PRICE_OUTPUT) / 1_000_000;
  tokenEntries.push({
    label: s.title || `${s.period} ${s.startDate}`,
    date: s.createdAt?.slice(0, 10) || s.startDate,
    type: s.period,
    input: tu.input,
    output: tu.output,
    total: tu.total,
    cost,
  });
}

tokenEntries.sort((a, b) => b.date.localeCompare(a.date));

const totalInput = tokenEntries.reduce((s, e) => s + e.input, 0);
const totalOutput = tokenEntries.reduce((s, e) => s + e.output, 0);
const totalTokens = tokenEntries.reduce((s, e) => s + e.total, 0);
const totalCost = tokenEntries.reduce((s, e) => s + e.cost, 0);

// Chart data: token usage over time, grouped by task type
const tokenChartDates = [...new Set(tokenEntries.map(e => e.date))].sort();
const tokenTypes = [...new Set(tokenEntries.map(e => e.type))];

// Per-type per-date totals
const tokenByTypeDate: Record<string, Record<string, { input: number; output: number }>> = {};
for (const e of tokenEntries) {
  if (!tokenByTypeDate[e.type]) tokenByTypeDate[e.type] = {};
  if (!tokenByTypeDate[e.type][e.date]) tokenByTypeDate[e.type][e.date] = { input: 0, output: 0 };
  tokenByTypeDate[e.type][e.date].input += e.input;
  tokenByTypeDate[e.type][e.date].output += e.output;
}

// Also keep aggregate for "all" view
const tokenChartData = {
  dates: tokenChartDates,
  types: tokenTypes,
  byType: tokenByTypeDate,
};
---

<Layout title="Analytics" description="Source quality and tag trend analytics">
  <Container>
    <div class="space-y-12">
      <div>
        <div class="section-title mb-2">Analytics</div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Analytics</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
          Source quality metrics and tag trend analysis across {reports.length} reports
        </p>
      </div>

      {/* Global Time Range */}
      <div class="flex flex-wrap items-center gap-3" style="border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
        <span class="meta">Time Range:</span>
        <div class="flex gap-1" id="global-range-btns">
          <button data-grange="7" class="tag-filter">7d</button>
          <button data-grange="30" class="tag-filter">30d</button>
          <button data-grange="90" class="tag-filter">90d</button>
          <button data-grange="all" class="tag-filter tag-filter-active">All</button>
        </div>
        <div class="flex items-center gap-1.5">
          <input type="date" id="global-date-from" class="date-input" />
          <span class="meta">~</span>
          <input type="date" id="global-date-to" class="date-input" />
        </div>
      </div>

      <!-- Token Cost Dashboard -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold" style="color: var(--color-text);">Token Usage & Cost</h2>
        <p class="text-xs" style="color: var(--color-text-muted);">
          Gemini 3 Flash Preview: ${PRICE_INPUT}/1M input · ${PRICE_OUTPUT}/1M output
        </p>

        {/* Task type filter */}
        <div class="flex gap-1.5 flex-wrap" id="token-type-filters">
          <button data-ttype="all" class="tag-filter tag-filter-active">All</button>
          <button data-ttype="daily" class="tag-filter" title="Daily Report">Daily Report</button>
          <button data-ttype="weekly" class="tag-filter" title="Warroom Weekly">Weekly</button>
          <button data-ttype="monthly" class="tag-filter" title="Warroom Monthly">Monthly</button>
          <button data-ttype="quarterly" class="tag-filter" title="Warroom Quarterly">Quarterly</button>
          <button data-ttype="competitor_classify" class="tag-filter" title="Competitor Classify">Comp. Classify</button>
          <button data-ttype="competitor_weekly" class="tag-filter" title="Competitor Weekly">Comp. Weekly</button>
        </div>

        {/* Summary cards (JS-driven) */}
        <div class="grid gap-4 grid-cols-2 md:grid-cols-4" id="token-cards">
          <div class="card p-4 text-center">
            <div class="meta mb-1">Total Input</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);" id="card-input">—</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">Total Output</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);" id="card-output">—</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">Total Tokens</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);" id="card-total">—</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">Est. Cost</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-quarterly);" id="card-cost">—</div>
          </div>
        </div>

        {/* Chart */}
        <div class="card p-4" style="position: relative; height: 300px;">
          <canvas id="token-chart"></canvas>
        </div>

        {/* Detailed table (JS-driven) */}
        <details class="group">
          <summary class="flex cursor-pointer items-center gap-3 py-2 text-sm font-semibold" style="color: var(--color-text);">
            <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
              <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span id="breakdown-title">Detailed breakdown</span>
          </summary>
          <div class="overflow-x-auto mt-2">
            <table class="source-table">
              <thead>
                <tr>
                  <th style="width: 7rem;">Date</th>
                  <th style="width: 3rem;">Type</th>
                  <th style="text-align: right; width: 7rem;">Input</th>
                  <th style="text-align: right; width: 7rem;">Output</th>
                  <th style="text-align: right; width: 7rem;">Total</th>
                  <th style="text-align: right; width: 6rem;">Cost</th>
                </tr>
              </thead>
              <tbody id="breakdown-body"></tbody>
            </table>
          </div>
        </details>
      </section>

      <!-- Tag Trend Timeline -->
      <section class="space-y-4">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <h2 class="text-lg font-semibold" style="color: var(--color-text);">Tag Trends</h2>
          <div class="flex gap-1.5" id="tag-type-filters">
            <button data-type="all" class="tag-filter tag-filter-active">All</button>
            <button data-type="companies" class="tag-filter" style="--filter-color: #9333ea;">Companies</button>
            <button data-type="models" class="tag-filter" style="--filter-color: var(--color-accent-cool);">Models</button>
            <button data-type="topics" class="tag-filter" style="--filter-color: var(--color-accent-warm);">Topics</button>
          </div>
        </div>
        <p class="text-xs" style="color: var(--color-text-muted);">
          {allTags.length} tags · {reports.length} reports. Click tags below to show/hide.
        </p>
        {allTags.length > 0 ? (
          <>
            <div class="card p-4" style="position: relative; height: 400px;">
              <canvas id="tag-chart"></canvas>
            </div>
            {/* Custom tag list (replaces Chart.js legend) */}
            <div class="tag-list-container" id="tag-list">
              {allTags.slice(0, 20).map((t, i) => {
                const color = t.type === "companies" ? "#9333ea" : t.type === "models" ? "#0891b2" : "#d97706";
                return (
                  <button
                    class="tag-list-item"
                    data-tag-idx={String(i)}
                    data-tag-type={t.type}
                    style={`--tag-color: ${color};`}
                  >
                    <span class="tag-list-dot"></span>
                    <span class="tag-list-name">{t.tag}</span>
                    <span class="tag-list-count">{t.count}</span>
                  </button>
                );
              })}
            </div>
          </>
        ) : (
          <div class="card p-8 text-center">
            <p class="text-sm" style="color: var(--color-text-muted);">Not enough data yet. Tag trends will appear as more daily reports accumulate.</p>
          </div>
        )}
      </section>

      <!-- Source Quality -->
      <section class="space-y-4">
        <h2 class="text-lg font-semibold" style="color: var(--color-text);">Source Quality</h2>
        <p class="text-xs" style="color: var(--color-text-muted);">
          How often each source's items get referenced in daily reports. High collection + low reference = noise source.
        </p>
        <div class="overflow-x-auto">
          <table class="source-table">
            <thead>
              <tr>
                <th style="width: 14rem;">Source</th>
                <th style="text-align: right; width: 7rem;" title="Total items collected from this source across all days">Collected</th>
                <th style="text-align: right; width: 7rem;" title="How many of those items were referenced in LLM-generated daily reports">Referenced</th>
                <th style="text-align: right; width: 6rem;" title="Referenced / Collected — higher = more valuable source, lower = more noise">Rate</th>
                <th style="width: 10rem;" title="Visual bar showing the reference rate percentage">Distribution</th>
              </tr>
            </thead>
            <tbody>
              {sourceRows.map(row => {
                const barWidth = Math.min(row.rate * 100, 100);
                const barColor = row.rate > 0.5 ? "var(--color-quarterly)" : row.rate > 0.1 ? "var(--color-accent-cool)" : "var(--color-text-muted)";
                return (
                  <tr>
                    <td class="font-medium" style="color: var(--color-text);">{row.source}</td>
                    <td class="text-right meta">{row.collected}</td>
                    <td class="text-right meta">{row.referenced}</td>
                    <td class="text-right">
                      <span class="font-mono text-xs font-semibold" style={`color: ${barColor};`}>
                        {(row.rate * 100).toFixed(1)}%
                      </span>
                    </td>
                    <td>
                      <div class="bar-bg">
                        <div class="bar-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </Container>
</Layout>

<style>
  /* === Tag filters === */
  .tag-filter {
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .tag-filter:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
  .tag-filter-active {
    color: var(--filter-color, var(--color-text));
    border-color: var(--filter-color, var(--color-border));
    background-color: color-mix(in srgb, var(--filter-color, var(--color-surface-muted)) 10%, transparent);
    font-weight: 600;
  }

  /* === Date input === */
  .date-input {
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-raised);
    color: var(--color-text);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    outline: none;
  }
  .date-input:focus {
    border-color: var(--color-accent-cool);
  }

  /* === Tag list (custom legend) === */
  .tag-list-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    max-height: 8rem;
    overflow-y: auto;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-surface-raised);
  }
  .tag-list-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .tag-list-item:hover {
    border-color: var(--tag-color);
    color: var(--color-text);
  }
  .tag-list-item.tag-active {
    border-color: var(--tag-color);
    color: var(--tag-color);
    background-color: color-mix(in srgb, var(--tag-color) 8%, transparent);
    font-weight: 600;
  }
  .tag-list-item.tag-hidden-type {
    display: none;
  }
  .tag-list-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--tag-color);
    flex-shrink: 0;
  }
  .tag-list-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tag-list-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-muted);
  }

  /* === Source table === */
  .source-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .source-table th {
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }
  .source-table th[title] {
    cursor: help;
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-text-muted);
  }
  .source-table td {
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .source-table tbody tr:hover {
    background-color: var(--color-surface-muted);
  }
  .bar-bg {
    height: 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--color-surface-muted);
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 0.25rem;
    transition: width 0.3s;
  }
</style>

<script define:vars={{ chartData, tokenChartData, tokenEntries, PRICE_INPUT, PRICE_OUTPUT, sourceRows }}>
  window.__analyticsData = { chartData, tokenChartData, tokenEntries, PRICE_INPUT, PRICE_OUTPUT, sourceRows };
</script>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

<script is:inline>
  var ad = window.__analyticsData || {};
  var chartData = ad.chartData;
  var tokenChartData = ad.tokenChartData;
  var tokenEntries = ad.tokenEntries || [];
  var sourceRows = ad.sourceRows || [];
  var PRICE_INPUT = ad.PRICE_INPUT || 0.05;
  var PRICE_OUTPUT = ad.PRICE_OUTPUT || 3;

  // === Global filter state ===
  var globalDateFrom = "";
  var globalDateTo = "";
  var tokenFilterType = "all";

  function getTypeBadge(type) {
    if (type === "daily") return "D";
    if (type.indexOf("classify") >= 0) return "CC";
    if (type.indexOf("competitor") >= 0) return "CW";
    return type.replace("raw_", "").charAt(0).toUpperCase();
  }
  function getTypePeriodClass(type) {
    if (type === "daily") return "warroom";
    if (type.indexOf("classify") >= 0) return "industry";
    if (type.indexOf("weekly") >= 0) return "weekly";
    if (type.indexOf("monthly") >= 0) return "monthly";
    return "quarterly";
  }
  function getTypeTitle(type) {
    var m = { daily: "Daily Report", competitor_classify: "Competitor Classify (daily)",
      competitor_weekly: "Competitor Weekly Report", raw_weekly: "Industry Weekly",
      raw_monthly: "Industry Monthly", raw_quarterly: "Industry Quarterly",
      weekly: "Warroom Weekly", monthly: "Warroom Monthly", quarterly: "Warroom Quarterly" };
    return m[type] || type;
  }

  function filteredTokenEntries() {
    return tokenEntries.filter(function(e) {
      if (tokenFilterType !== "all" && e.type !== tokenFilterType) return false;
      if (globalDateFrom && e.date < globalDateFrom) return false;
      if (globalDateTo && e.date > globalDateTo) return false;
      return true;
    });
  }

  function updateTokenCards() {
    var entries = filteredTokenEntries();
    var inp = 0, out = 0, tot = 0, cost = 0;
    entries.forEach(function(e) { inp += e.input; out += e.output; tot += e.total; cost += e.cost; });
    var ci = document.getElementById("card-input");
    var co = document.getElementById("card-output");
    var ct = document.getElementById("card-total");
    var cc = document.getElementById("card-cost");
    if (ci) ci.textContent = (inp / 1000000).toFixed(2) + "M";
    if (co) co.textContent = (out / 1000000).toFixed(2) + "M";
    if (ct) ct.textContent = (tot / 1000000).toFixed(2) + "M";
    if (cc) cc.textContent = "$" + cost.toFixed(4);
  }

  function updateBreakdownTable() {
    var entries = filteredTokenEntries();
    var tbody = document.getElementById("breakdown-body");
    var title = document.getElementById("breakdown-title");
    if (!tbody) return;
    if (title) title.textContent = "Detailed breakdown (" + entries.length + " LLM calls)";
    tbody.innerHTML = entries.map(function(e) {
      return '<tr><td class="meta">' + e.date + '</td>' +
        '<td><span class="period-label period-' + getTypePeriodClass(e.type) + '" title="' + getTypeTitle(e.type) + '">' + getTypeBadge(e.type) + '</span></td>' +
        '<td style="text-align:right" class="meta">' + e.input.toLocaleString() + '</td>' +
        '<td style="text-align:right" class="meta">' + e.output.toLocaleString() + '</td>' +
        '<td style="text-align:right;font-family:var(--font-mono);font-size:0.75rem;font-weight:600;color:var(--color-text)">' + e.total.toLocaleString() + '</td>' +
        '<td style="text-align:right;font-family:var(--font-mono);font-size:0.75rem;color:var(--color-quarterly)">$' + e.cost.toFixed(4) + '</td></tr>';
    }).join("");
  }

  function updateTokenChartData() {
    if (!window.__tokenChart) return;
    var entries = filteredTokenEntries();
    var dateMap = {};
    entries.forEach(function(e) {
      if (!dateMap[e.date]) dateMap[e.date] = { input: 0, output: 0 };
      dateMap[e.date].input += e.input;
      dateMap[e.date].output += e.output;
    });
    var dates = Object.keys(dateMap).sort();
    window.__tokenChart.data.labels = dates;
    window.__tokenChart.data.datasets[0].data = dates.map(function(d) { return dateMap[d].input / 1000; });
    window.__tokenChart.data.datasets[1].data = dates.map(function(d) { return dateMap[d].output / 1000; });
    window.__tokenChart.update();
  }

  function updateAllTokenViews() {
    updateTokenCards();
    updateBreakdownTable();
    updateTokenChartData();
  }

  const TYPE_COLORS = {
    companies: { border: "#9333ea", bg: "rgba(147, 51, 234, 0.1)" },
    models: { border: "#0891b2", bg: "rgba(8, 145, 178, 0.1)" },
    topics: { border: "#d97706", bg: "rgba(217, 119, 6, 0.1)" },
  };

  function initTokenChart() {
    var canvas = document.getElementById("token-chart");
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = "true";

    var isDark = document.documentElement.classList.contains("dark");
    var gridColor = isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.06)";
    var textColor = isDark ? "#78859b" : "#78716c";

    window.__tokenChart = new Chart(canvas, {
      type: "bar",
      data: { labels: [], datasets: [
        { label: "Input (K)", data: [],
          backgroundColor: isDark ? "rgba(34, 211, 238, 0.5)" : "rgba(8, 145, 178, 0.5)",
          borderColor: isDark ? "#22d3ee" : "#0891b2", borderWidth: 1 },
        { label: "Output (K)", data: [],
          backgroundColor: isDark ? "rgba(245, 158, 11, 0.5)" : "rgba(217, 119, 6, 0.5)",
          borderColor: isDark ? "#f59e0b" : "#d97706", borderWidth: 1 },
      ]},
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { position: "bottom", labels: { color: textColor, font: { size: 11, family: "Geist Mono, monospace" }, boxWidth: 12 } },
          tooltip: {
            backgroundColor: isDark ? "#141825" : "#fff",
            titleColor: isDark ? "#e7e5e4" : "#1c1917",
            bodyColor: isDark ? "#78859b" : "#78716c",
            borderColor: isDark ? "#252a3a" : "#e2e0dc", borderWidth: 1,
            callbacks: { label: function(ctx) { return ctx.dataset.label + ": " + ctx.parsed.y.toFixed(1) + "K"; } },
          },
        },
        scales: {
          x: { stacked: true, grid: { color: gridColor }, ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } } },
          y: { stacked: true, grid: { color: gridColor }, ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } },
            title: { display: true, text: "Tokens (K)", color: textColor, font: { size: 11 } } },
        },
      },
    });

    // Wire up type filter only (time range is global)
    document.querySelectorAll("[data-ttype]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        tokenFilterType = btn.dataset.ttype;
        document.querySelectorAll("#token-type-filters .tag-filter").forEach(function(b) {
          b.classList.toggle("tag-filter-active", b.dataset.ttype === tokenFilterType);
        });
        updateAllTokenViews();
      });
    });

    updateAllTokenViews();
  }

  function initAnalytics() {
    if (typeof Chart === "undefined") return; // Chart.js not loaded yet
    initTokenChart();

    if (!chartData) return;
    const canvas = document.getElementById("tag-chart");
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = "true";

    const datasets = chartData.tags.map((tag, i) => {
      const colors = TYPE_COLORS[tag.type] || TYPE_COLORS.topics;
      // Cumulative count for timeline
      let cumulative = 0;
      const cumulativeData = tag.data.map(v => { cumulative += v; return cumulative; });

      return {
        label: tag.label,
        data: cumulativeData,
        borderColor: colors.border,
        backgroundColor: colors.bg,
        borderWidth: 2,
        pointRadius: 3,
        tension: 0.3,
        hidden: false,
        _type: tag.type,
      };
    });

    // Default visibility: top 3 per type
    var typeCounts = {};
    datasets.forEach(function(ds) {
      var t = ds._type;
      typeCounts[t] = (typeCounts[t] || 0) + 1;
      ds.hidden = typeCounts[t] > 3;
    });

    var isDark = document.documentElement.classList.contains("dark");
    var gridColor = isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.06)";
    var textColor = isDark ? "#78859b" : "#78716c";

    window.__tagChart = new Chart(canvas, {
      type: "line",
      data: {
        labels: chartData.dates,
        datasets: datasets,
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: "index",
          intersect: false,
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: isDark ? "#141825" : "#fff",
            titleColor: isDark ? "#e7e5e4" : "#1c1917",
            bodyColor: isDark ? "#78859b" : "#78716c",
            borderColor: isDark ? "#252a3a" : "#e2e0dc",
            borderWidth: 1,
          },
        },
        scales: {
          x: {
            grid: { color: gridColor },
            ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } },
          },
          y: {
            beginAtZero: true,
            grid: { color: gridColor },
            ticks: {
              color: textColor,
              font: { size: 10, family: "Geist Mono, monospace" },
              stepSize: 1,
            },
            title: {
              display: true,
              text: "Cumulative mentions",
              color: textColor,
              font: { size: 11 },
            },
          },
        },
      },
    });

    // Sync tag list items with chart visibility
    function syncTagList() {
      document.querySelectorAll(".tag-list-item").forEach(function(item) {
        var idx = parseInt(item.dataset.tagIdx);
        var ds = window.__tagChart.data.datasets[idx];
        if (ds) item.classList.toggle("tag-active", !ds.hidden);
      });
    }
    syncTagList();

    // Click tag list item → toggle dataset
    document.querySelectorAll(".tag-list-item").forEach(function(item) {
      item.addEventListener("click", function() {
        var idx = parseInt(item.dataset.tagIdx);
        var ds = window.__tagChart.data.datasets[idx];
        if (ds) {
          ds.hidden = !ds.hidden;
          window.__tagChart.update();
          syncTagList();
        }
      });
    });

    // Type filter buttons
    var activeType = "all";
    document.querySelectorAll("[data-type]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        activeType = btn.dataset.type;
        document.querySelectorAll(".tag-filter").forEach(function(b) {
          b.classList.toggle("tag-filter-active", b.dataset.type === activeType);
        });

        // Show/hide datasets by type
        window.__tagChart.data.datasets.forEach(function(ds) {
          if (activeType === "all") {
            ds.hidden = false;
          } else {
            ds.hidden = ds._type !== activeType;
          }
        });
        window.__tagChart.update();

        // Show/hide tag list items by type
        document.querySelectorAll(".tag-list-item").forEach(function(item) {
          if (activeType === "all") {
            item.classList.remove("tag-hidden-type");
          } else {
            item.classList.toggle("tag-hidden-type", item.dataset.tagType !== activeType);
          }
        });
        syncTagList();
      });
    });
  }

  // === Global time range controller ===
  function initGlobalRange() {
    var fromEl = document.getElementById("global-date-from");
    var toEl = document.getElementById("global-date-to");

    function updateAll() {
      updateAllTokenViews();
      updateTagChart();
    }

    // Quick buttons
    document.querySelectorAll("[data-grange]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        document.querySelectorAll("#global-range-btns .tag-filter").forEach(function(b) {
          b.classList.toggle("tag-filter-active", b.dataset.grange === btn.dataset.grange);
        });
        if (btn.dataset.grange === "all") {
          globalDateFrom = "";
          globalDateTo = "";
        } else {
          var days = parseInt(btn.dataset.grange);
          var to = new Date();
          var from = new Date(to.getTime() - days * 86400000);
          globalDateFrom = from.toISOString().slice(0, 10);
          globalDateTo = to.toISOString().slice(0, 10);
        }
        if (fromEl) fromEl.value = globalDateFrom;
        if (toEl) toEl.value = globalDateTo;
        updateAll();
      });
    });

    // Custom date inputs
    function onDateChange() {
      globalDateFrom = fromEl ? fromEl.value : "";
      globalDateTo = toEl ? toEl.value : "";
      document.querySelectorAll("#global-range-btns .tag-filter").forEach(function(b) {
        b.classList.remove("tag-filter-active");
      });
      updateAll();
    }
    if (fromEl) fromEl.addEventListener("change", onDateChange);
    if (toEl) toEl.addEventListener("change", onDateChange);
  }

  // Update tag chart by global date range
  function updateTagChart() {
    if (!window.__tagChart || !chartData) return;
    // Find date indices within range
    var indices = [];
    chartData.dates.forEach(function(d, i) {
      if (globalDateFrom && d < globalDateFrom) return;
      if (globalDateTo && d > globalDateTo) return;
      indices.push(i);
    });
    var filteredDates = indices.map(function(i) { return chartData.dates[i]; });
    window.__tagChart.data.labels = filteredDates;
    window.__tagChart.data.datasets.forEach(function(ds, di) {
      var tag = chartData.tags[di];
      if (!tag) return;
      var cumulative = 0;
      ds.data = indices.map(function(i) { cumulative += tag.data[i]; return cumulative; });
    });
    window.__tagChart.update();
  }

  // Retry until Chart.js is loaded
  function tryInit() {
    if (typeof Chart !== "undefined") {
      initAnalytics();
      initGlobalRange();
    } else {
      setTimeout(tryInit, 100);
    }
  }
  tryInit();
  document.addEventListener("astro:page-load", tryInit);
</script>
