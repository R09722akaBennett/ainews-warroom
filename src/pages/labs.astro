---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import labsData from "../data/labs.json";
import summariesData from "../data/summaries.json";
import { marked } from "marked";

type Lab = { key: string; name: string; tier: number; region: string; openness: string };
type Item = { date: string; lab: string; title: string; url: string; source: string; publishedAt: string; category: string; summary: string; content: string };
type Summary = { period: string; startDate: string; endDate: string; title: string; content: string; tags?: any; tokenUsage?: { input?: number; output?: number } };

const labsMeta = (labsData as any).labs as Lab[];
const updatedAt = (labsData as any).updatedAt as string | undefined;
const labByKey = new Map(labsMeta.map((l) => [l.key, l]));
const labName = (key: string) => labByKey.get(key)?.name || key;

const INITIAL = 50;

// Taiwan has no DST, so a fixed +8h offset is exact and avoids depending on the
// build machine's ICU data.
function taipei(iso: string): Date {
  return new Date(new Date(iso).getTime() + 8 * 3600 * 1000);
}
const pad = (n: number) => String(n).padStart(2, "0");
const weekdays = ["週日", "週一", "週二", "週三", "週四", "週五", "週六"];
function dayLabel(ymd: string): string {
  const d = new Date(`${ymd}T00:00:00Z`);
  return `${pad(d.getUTCMonth() + 1)}/${pad(d.getUTCDate())} ${weekdays[d.getUTCDay()]}`;
}
const shortDate = (ymd: string) => ymd.slice(5).replace("-", "/");

// The exported `date` is the run date, which can be a day after the Taipei
// publish date for evening posts, so grouping and the time label both come
// from publishedAt.
const items = (((labsData as any).items || []) as Item[])
  .map((item) => {
    const t = item.publishedAt ? taipei(item.publishedAt) : null;
    const day = t ? `${t.getUTCFullYear()}-${pad(t.getUTCMonth() + 1)}-${pad(t.getUTCDate())}` : item.date;
    const time = t ? `${pad(t.getUTCHours())}:${pad(t.getUTCMinutes())}` : "";
    const id = `post-${item.url.split("/").pop()}`;
    return { ...item, day, time, id };
  })
  .sort((a, b) => (b.publishedAt || b.date).localeCompare(a.publishedAt || a.date))
  .map((item, idx) => ({ ...item, idx }));

const groups: { day: string; posts: typeof items }[] = [];
for (const item of items) {
  const last = groups[groups.length - 1];
  if (last && last.day === item.day) last.posts.push(item);
  else groups.push({ day: item.day, posts: [item] });
}

const countBy = (key: (i: Item) => string | undefined) => {
  const m = new Map<string, number>();
  for (const i of items) {
    const k = key(i);
    if (k) m.set(k, (m.get(k) || 0) + 1);
  }
  return m;
};
const labCounts = countBy((i) => i.lab);
const labKeys = [...labCounts.keys()].sort(
  (a, b) => (labByKey.get(a)?.tier ?? 9) - (labByKey.get(b)?.tier ?? 9) || labCounts.get(b)! - labCounts.get(a)! || labName(a).localeCompare(labName(b)),
);

const categoryLabels: Record<string, string> = {
  model_release: "模型發布",
  product: "產品更新",
  research: "研究",
  open_source: "開源",
  infra: "基礎設施",
  partnership: "合作",
  funding: "資金",
  talent: "人事",
  policy: "安全與政策",
  event: "活動",
  other: "其他",
};
const categoryColors: Record<string, string> = {
  model_release: "var(--color-quarterly)",
  product: "var(--color-monthly)",
  research: "var(--color-accent-cool)",
  open_source: "var(--color-accent-purple)",
  infra: "var(--color-accent-warm)",
  partnership: "var(--color-accent-orange)",
  funding: "var(--color-accent-orange)",
  talent: "var(--color-accent-purple)",
  policy: "#ef4444",
  event: "var(--color-monthly)",
  other: "var(--color-text-muted)",
};
const catLabel = (c: string) => categoryLabels[c] || c.replace(/_/g, " ");
const catColor = (c: string) => categoryColors[c] || "var(--color-text-muted)";
const catCounts = countBy((i) => i.category);
const catKeys = [
  ...Object.keys(categoryLabels).filter((c) => catCounts.has(c)),
  ...[...catCounts.keys()].filter((c) => !(c in categoryLabels)).sort(),
];

const regionLabels: Record<string, string> = { us: "美國", china: "中國", europe: "歐洲", other: "其他" };
const opennessLabels: Record<string, string> = { open: "開放權重", closed: "閉源", mixed: "混合" };
const regionCounts = countBy((i) => labByKey.get(i.lab)?.region);
const openCounts = countBy((i) => labByKey.get(i.lab)?.openness);
const regionKeys = Object.keys(regionLabels).filter((r) => regionCounts.has(r));
const openKeys = Object.keys(opennessLabels).filter((o) => openCounts.has(o));

// Briefs cite posts by their X URL. Pointing those links at the in-page card
// keeps readers on the page; the card itself carries the X link.
const idByUrl = new Map(items.flatMap((i) => [i.url, ...((i as any).aliases || [])].map((u: string) => [u, i.id] as [string, string])));
function renderBrief(md: string): string {
  const html = marked.parse(md || "") as string;
  return html.replace(/<a href="([^"]+)">([^<]*)<\/a>/g, (whole, url: string, text: string) => {
    const id = idByUrl.get(url.replace(/&amp;/g, "&"));
    return id ? `<a href="#${id}" class="lab-ref" data-target="${id}">${text}</a>` : whole.replace("<a ", '<a target="_blank" rel="noopener" ');
  });
}
// The first markdown block (usually the 本週重點 list) is the teaser; the rest
// opens on demand so the latest report stays short on a phone.
function splitWeekly(md: string): { lead: string; rest: string } {
  const blocks = (md || "").trim().split(/\n\s*\n/);
  let i = 0;
  const lead: string[] = [];
  while (i < blocks.length && /^#{1,6}\s/.test(blocks[i].trim()) && !blocks[i].trim().includes("\n")) lead.push(blocks[i++]);
  if (i < blocks.length) lead.push(blocks[i++]);
  return { lead: lead.join("\n\n"), rest: blocks.slice(i).join("\n\n") };
}
const tokens = (u?: { input?: number; output?: number }) =>
  u ? `In ${u.input?.toLocaleString() ?? "–"} · Out ${u.output?.toLocaleString() ?? "–"}` : "";

const summaries = summariesData as unknown as Summary[];
const dailyBriefs = summaries
  .filter((s) => s.period === "labs_daily")
  .sort((a, b) => b.startDate.localeCompare(a.startDate));
const weeklyReports = summaries
  .filter((s) => s.period === "labs_weekly")
  .sort((a, b) => b.endDate.localeCompare(a.endDate));
const latestWeekly = weeklyReports[0];
const latestSplit = latestWeekly ? splitWeekly(latestWeekly.content) : null;
const olderWeekly = weeklyReports.slice(1);

const updatedLabel = updatedAt
  ? (() => {
      const t = taipei(updatedAt);
      return `${t.getUTCFullYear()}-${pad(t.getUTCMonth() + 1)}-${pad(t.getUTCDate())} ${pad(t.getUTCHours())}:${pad(t.getUTCMinutes())}`;
    })()
  : "";
---

<Layout title="Labs" description="前沿 AI 實驗室動態追蹤：每日快報、週報與官方 X 貼文的中文摘要">
  <Container>
    <div class="lab-wrap">
      <div>
        <div class="section-title mb-2">Frontier Labs</div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Labs</h1>
        <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-text-muted);">
          追蹤 {labsMeta.length} 家美國、中國與歐洲的前沿 AI 實驗室官方 X 帳號，每天整理成中文快報。
          {items.length > 0 ? `共 ${items.length} 則貼文。` : "第一次每日排程跑完後，貼文會出現在這裡。"}
          {updatedLabel && <span class="meta whitespace-nowrap">更新於 {updatedLabel}</span>}
        </p>
      </div>

      {dailyBriefs.length > 0 && (
        <section class="card card-accent-cool lab-daily" id="lab-daily" aria-label="每日快報">
          <div class="lab-daily-top">
            <h2 class="lab-h2">今日前沿實驗室</h2>
            {dailyBriefs.map((b, i) => (
              <span class="meta lab-daily-meta" data-brief-meta={b.startDate} hidden={i !== 0}>
                {b.startDate}
                {b.tags?.posts ? ` · ${b.tags.posts} 則貼文` : ""}
                {b.tokenUsage && <span class="lab-tokens"> · {tokens(b.tokenUsage)}</span>}
              </span>
            ))}
          </div>
          {dailyBriefs.length > 1 && (
            <div class="lab-scroll lab-date-chips" role="group" aria-label="選擇日期">
              {dailyBriefs.map((b, i) => (
                <button type="button" class="lab-chip" data-brief={b.startDate} aria-pressed={i === 0 ? "true" : "false"}>
                  {i === 0 ? `最新 ${shortDate(b.startDate)}` : shortDate(b.startDate)}
                </button>
              ))}
            </div>
          )}
          {dailyBriefs.map((b, i) => (
            <article class="lab-prose" data-brief-body={b.startDate} hidden={i !== 0} set:html={renderBrief(b.content)} />
          ))}
        </section>
      )}

      {latestWeekly && latestSplit && (
        <section class="lab-section" aria-label="週報">
          <h2 class="lab-h2">週報</h2>
          <article class="card card-accent-warm lab-weekly">
            <div class="lab-weekly-meta">
              <span class="period-label period-warroom">W</span>
              <span class="meta">{latestWeekly.startDate} ~ {latestWeekly.endDate}</span>
              {latestWeekly.tokenUsage && <span class="meta lab-tokens ml-auto">{tokens(latestWeekly.tokenUsage)}</span>}
            </div>
            <h3 class="lab-weekly-title">{latestWeekly.title}</h3>
            <div class="lab-prose" set:html={renderBrief(latestSplit.lead)} />
            {latestSplit.rest && (
              <details class="lab-more">
                <summary class="lab-more-toggle">
                  <span class="lab-more-open">展開全文</span><span class="lab-more-close">收合</span>
                  <svg class="lab-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </summary>
                <div class="lab-prose" set:html={renderBrief(latestSplit.rest)} />
              </details>
            )}
          </article>
          {olderWeekly.length > 0 && (
            <div class="lab-older">
              {olderWeekly.map((s) => (
                <details class="card lab-row">
                  <summary class="lab-row-summary">
                    <span class="meta lab-row-date">{shortDate(s.startDate)} ~ {shortDate(s.endDate)}</span>
                    <span class="lab-row-title">{s.title}</span>
                    {s.tokenUsage && <span class="meta lab-tokens">{tokens(s.tokenUsage)}</span>}
                    <svg class="lab-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                  </summary>
                  <div class="lab-prose lab-row-body" set:html={renderBrief(s.content)} />
                </details>
              ))}
            </div>
          )}
        </section>
      )}

      {items.length === 0 ? (
        <div class="card p-8 text-center text-sm" style="color: var(--color-text-muted);">
          還沒有貼文。每日排程會蒐集並分類各實驗室的貼文，每週一產生週報。
        </div>
      ) : (
        <section class="lab-section" id="lab-feed" aria-label="貼文" data-initial={INITIAL}>
          <h2 class="lab-h2">貼文</h2>

          <div class="lab-scroll" id="lab-labs" role="group" aria-label="依實驗室篩選">
            <button type="button" class="lab-chip" data-value="all" aria-pressed="true">全部 <span class="lab-count" data-count="all">{items.length}</span></button>
            {labKeys.map((k) => (
              <button type="button" class="lab-chip" data-value={k} aria-pressed="false">{labName(k)} <span class="lab-count" data-count={k}>{labCounts.get(k)}</span></button>
            ))}
          </div>

          <div class="lab-scroll" id="lab-cats" role="group" aria-label="依類別篩選">
            <button type="button" class="lab-chip" data-value="all" aria-pressed="true">全部類別 <span class="lab-count" data-count="all">{items.length}</span></button>
            {catKeys.map((c) => (
              <button type="button" class="lab-chip" data-value={c} aria-pressed="false">
                <span class="lab-dot" style={`background-color: ${catColor(c)};`}></span>{catLabel(c)} <span class="lab-count" data-count={c}>{catCounts.get(c)}</span>
              </button>
            ))}
          </div>

          <div class="lab-toolbar">
            <button type="button" class="lab-btn" id="lab-filter-toggle" aria-expanded="false" aria-controls="lab-filter-panel">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
              篩選<span class="lab-badge" id="lab-filter-badge" hidden></span>
            </button>
            <span class="meta" id="lab-status" aria-live="polite">顯示 {Math.min(INITIAL, items.length)} / {items.length} 則</span>
          </div>

          <div class="card lab-panel" id="lab-filter-panel" hidden>
            <div class="lab-panel-row">
              <span class="lab-panel-label">地區</span>
              <div class="lab-wrap-chips" id="lab-regions" role="group" aria-label="地區">
                <button type="button" class="lab-chip" data-value="all" aria-pressed="true">不限</button>
                {regionKeys.map((r) => <button type="button" class="lab-chip" data-value={r} aria-pressed="false">{regionLabels[r]} <span class="lab-count" data-count={r}>{regionCounts.get(r)}</span></button>)}
              </div>
            </div>
            <div class="lab-panel-row">
              <span class="lab-panel-label">開放程度</span>
              <div class="lab-wrap-chips" id="lab-opens" role="group" aria-label="開放程度">
                <button type="button" class="lab-chip" data-value="all" aria-pressed="true">不限</button>
                {openKeys.map((o) => <button type="button" class="lab-chip" data-value={o} aria-pressed="false">{opennessLabels[o]} <span class="lab-count" data-count={o}>{openCounts.get(o)}</span></button>)}
              </div>
            </div>
            <button type="button" class="lab-link-btn" data-reset>清除所有篩選</button>
          </div>

          <div id="lab-groups">
            {groups.map((g) => (
              <section class:list={["lab-group", { "lab-off": g.posts[0].idx >= INITIAL }]} data-day={g.day}>
                <div class="lab-day">
                  <span class="lab-day-label">{dayLabel(g.day)}</span>
                  <span class="meta lab-day-count">{g.posts.length} 則</span>
                </div>
                <div class="lab-posts">
                  {g.posts.map((p) => {
                    const lab = labByKey.get(p.lab);
                    return (
                      <article
                        class:list={["card lab-post", { "lab-off": p.idx >= INITIAL }]}
                        id={p.id}
                        data-lab={p.lab}
                        data-cat={p.category}
                        data-region={lab?.region}
                        data-open={lab?.openness}
                      >
                        <div class="lab-post-top">
                          <span class="lab-badge-lab">{labName(p.lab)}</span>
                          <time class="meta" datetime={p.publishedAt}>{p.time}</time>
                          <span class="lab-tag" style={`--tag: ${catColor(p.category)};`}>{catLabel(p.category)}</span>
                          <a href={p.url} target="_blank" rel="noopener" class="lab-x" title={p.source} aria-label={`在 X 開啟 ${p.source} 的貼文`}>X ↗</a>
                        </div>
                        <p class="lab-summary">{p.summary || p.title}</p>
                        {p.content && (
                          <details class="lab-orig">
                            <summary>原文</summary>
                            <p class="lab-orig-text">{p.content}</p>
                          </details>
                        )}
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>

          <p class="card p-6 text-center text-sm" id="lab-empty" style="color: var(--color-text-muted);" hidden>
            沒有符合的貼文。<button type="button" class="lab-link-btn" data-reset>清除篩選</button>
          </p>
          <button type="button" class="lab-btn lab-loadmore" id="lab-loadmore" hidden={items.length <= INITIAL}>載入更多（還有 {items.length - INITIAL} 則）</button>
        </section>
      )}
    </div>
  </Container>
</Layout>

<style>
  .lab-wrap { max-width: 52rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem; min-width: 0; }
  .lab-section { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .lab-h2 { font-size: 1.125rem; font-weight: 600; color: var(--color-text); }

  /* Chip rows bleed to the screen edge on phones so the sideways scroll reads
     as scrollable instead of looking cut off at the gutter. */
  .lab-scroll {
    display: flex; gap: 0.375rem; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
    margin: 0 -1rem; padding: 0 1rem; min-width: 0;
  }
  .lab-scroll::-webkit-scrollbar { display: none; }
  @media (min-width: 640px) { .lab-scroll { margin: 0; padding: 0; } }
  .lab-wrap-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }

  .lab-chip {
    flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.375rem; min-height: 40px; padding: 0 0.75rem;
    border-radius: 999px; border: 1px solid var(--color-border); background-color: var(--color-surface-raised);
    color: var(--color-text-muted); font-size: 0.8125rem; font-weight: 500; white-space: nowrap; cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .lab-chip:hover { color: var(--color-text); background-color: var(--color-surface-muted); }
  .lab-chip[aria-pressed="true"] {
    color: var(--color-text); font-weight: 600;
    border-color: color-mix(in srgb, var(--color-accent-cool) 55%, transparent);
    background-color: var(--color-accent-cool-muted);
  }
  .lab-chip.is-empty { opacity: 0.45; }
  .lab-count {
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-muted);
    background-color: var(--color-surface-muted); padding: 0.05rem 0.35rem; border-radius: 0.25rem;
  }
  .lab-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; flex-shrink: 0; }

  .lab-daily { padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  @media (min-width: 640px) { .lab-daily { padding: 1.25rem; } }
  .lab-daily-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; }
  /* Inside a card the chip row can't bleed past the card border. */
  .lab-date-chips { margin: 0; padding: 0; }
  .lab-tokens { display: none; }
  @media (min-width: 640px) { .lab-tokens { display: inline; } }

  .lab-prose { font-size: 0.9375rem; line-height: 1.7; color: var(--color-text); min-width: 0; overflow-wrap: anywhere; }
  .lab-prose :global(p) { margin: 0.5rem 0; }
  .lab-prose :global(h2), .lab-prose :global(h3) { font-size: 0.9375rem; font-weight: 700; margin: 1rem 0 0.25rem; }
  .lab-prose :global(h2:first-child), .lab-prose :global(p:first-child) { margin-top: 0; }
  .lab-prose :global(ul) { list-style: disc; padding-left: 1.15rem; margin: 0.25rem 0 0.75rem; }
  .lab-prose :global(li) { margin: 0.3rem 0; }
  .lab-prose :global(strong) { font-weight: 700; }
  .lab-prose :global(a) { color: var(--color-accent-cool); text-decoration: underline; text-underline-offset: 2px; }
  .lab-prose :global(a.lab-ref) { color: var(--color-accent-warm); text-decoration: none; font-weight: 500; }
  .lab-prose :global(a.lab-ref:hover) { text-decoration: underline; }

  .lab-weekly { padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  @media (min-width: 640px) { .lab-weekly { padding: 1.25rem; } }
  .lab-weekly-meta { display: flex; align-items: center; gap: 0.5rem; }
  .lab-weekly-title { font-size: 1rem; line-height: 1.5; font-weight: 700; color: var(--color-text); }
  .lab-more > summary { list-style: none; }
  .lab-more > summary::-webkit-details-marker { display: none; }
  .lab-more-toggle {
    display: inline-flex; align-items: center; gap: 0.375rem; min-height: 40px; cursor: pointer;
    font-size: 0.875rem; font-weight: 600; color: var(--color-accent-cool);
  }
  .lab-more-close { display: none; }
  .lab-more[open] .lab-more-open { display: none; }
  .lab-more[open] .lab-more-close { display: inline; }
  .lab-more[open] > .lab-prose { padding-top: 0.25rem; }
  .lab-caret { width: 1rem; height: 1rem; flex-shrink: 0; transition: transform 0.2s; color: var(--color-text-muted); }
  details[open] > summary .lab-caret { transform: rotate(180deg); }

  .lab-older { display: flex; flex-direction: column; gap: 0.5rem; }
  .lab-row > summary { list-style: none; }
  .lab-row > summary::-webkit-details-marker { display: none; }
  .lab-row-summary { display: flex; align-items: center; gap: 0.75rem; min-height: 48px; padding: 0.5rem 1rem; cursor: pointer; }
  .lab-row-date { flex-shrink: 0; }
  .lab-row-title {
    flex: 1; min-width: 0; font-size: 0.875rem; font-weight: 500; color: var(--color-text);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .lab-row-body { padding: 0.75rem 1rem 1rem; border-top: 1px solid var(--color-border); }

  .lab-toolbar { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .lab-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem; min-height: 44px; padding: 0 1rem;
    border-radius: 0.5rem; border: 1px solid var(--color-border); background-color: var(--color-surface-raised);
    color: var(--color-text); font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: background-color 0.15s;
  }
  .lab-btn:hover { background-color: var(--color-surface-muted); }
  .lab-btn[aria-expanded="true"] { border-color: color-mix(in srgb, var(--color-accent-cool) 55%, transparent); }
  .lab-badge {
    min-width: 1.25rem; padding: 0 0.3rem; border-radius: 999px; font-size: 0.6875rem; font-family: var(--font-mono);
    color: var(--color-surface); background-color: var(--color-accent-cool); text-align: center;
  }
  .lab-panel { padding: 1rem; display: flex; flex-direction: column; gap: 0.875rem; }
  .lab-panel-row { display: flex; flex-direction: column; gap: 0.375rem; }
  .lab-panel-label { font-size: 0.75rem; font-weight: 600; color: var(--color-text-muted); }
  .lab-link-btn {
    align-self: flex-start; min-height: 40px; padding: 0 0.25rem; background: none; border: 0; cursor: pointer;
    font-size: 0.875rem; color: var(--color-accent-cool); text-decoration: underline; text-underline-offset: 2px;
  }
  .lab-loadmore { width: 100%; }

  .lab-group { display: flex; flex-direction: column; }
  .lab-group + .lab-group { margin-top: 0.5rem; }
  /* Sits under the fixed site header (about 61px tall), same as the podcast
     episode nav; it bleeds to the screen edge on phones so cards don't show
     through the gutter while scrolling. */
  .lab-day {
    position: sticky; top: 61px; z-index: 10; display: flex; align-items: baseline; gap: 0.5rem;
    margin: 0 -1rem; padding: 0.625rem 1rem 0.5rem;
    background-color: color-mix(in srgb, var(--color-surface) 92%, transparent); backdrop-filter: blur(8px);
  }
  @media (min-width: 640px) { .lab-day { margin: 0; padding: 0.625rem 0 0.5rem; } }
  .lab-day-label { font-family: var(--font-mono); font-size: 0.875rem; font-weight: 700; color: var(--color-text); }
  .lab-posts { display: flex; flex-direction: column; gap: 0.5rem; }

  .lab-post { padding: 0.75rem 1rem 0.5rem; display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; scroll-margin-top: 110px; }
  .lab-post-top { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .lab-badge-lab {
    min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding: 2px 8px; border-radius: 4px; font-size: 11px; font-family: var(--font-mono); font-weight: 600;
    color: var(--color-accent-cool); border: 1px solid var(--color-border);
  }
  .lab-tag {
    flex-shrink: 0; padding: 1px 6px; border-radius: 4px; font-size: 11px; font-weight: 500; white-space: nowrap;
    color: var(--tag); background-color: color-mix(in srgb, var(--tag) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag) 25%, transparent);
  }
  .lab-x {
    margin-left: auto; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    min-width: 40px; min-height: 40px; margin-right: -0.5rem; padding: 0 0.5rem; margin-block: -0.5rem;
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--color-text-muted); text-decoration: none;
  }
  .lab-x:hover { color: var(--color-text); text-decoration: underline; text-underline-offset: 2px; }
  .lab-summary { font-size: 0.9375rem; line-height: 1.65; color: var(--color-text); overflow-wrap: anywhere; }
  .lab-orig > summary {
    display: inline-flex; align-items: center; min-height: 40px; cursor: pointer;
    font-size: 0.75rem; color: var(--color-text-muted);
  }
  .lab-orig > summary:hover { color: var(--color-text); }
  .lab-orig-text {
    white-space: pre-line; overflow-wrap: anywhere; font-size: 0.8125rem; line-height: 1.6; color: var(--color-text-muted);
    padding: 0.5rem 0.75rem; margin-bottom: 0.5rem; border-left: 2px solid var(--color-border);
    background-color: var(--color-surface-muted); border-radius: 0 0.25rem 0.25rem 0;
  }
  .lab-post.lab-hl {
    border-color: var(--color-accent-warm);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-warm) 25%, transparent);
  }
  :global(.lab-off) { display: none !important; }
  /* Several toggled elements set their own display, which would beat the UA
     rule for [hidden]. */
  [hidden] { display: none !important; }
</style>

<script>
  function initDaily() {
    const root = document.getElementById("lab-daily");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";
    const chips = root.querySelectorAll<HTMLButtonElement>("[data-brief]");
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const date = chip.dataset.brief!;
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        root.querySelectorAll<HTMLElement>("[data-brief-body]").forEach((el) => (el.hidden = el.dataset.briefBody !== date));
        root.querySelectorAll<HTMLElement>("[data-brief-meta]").forEach((el) => (el.hidden = el.dataset.briefMeta !== date));
      });
    });
  }

  type Dim = "lab" | "cat" | "region" | "open";

  function initFeed() {
    const feed = document.getElementById("lab-feed");
    if (!feed || feed.dataset.bound) return;
    feed.dataset.bound = "true";

    const step = Number(feed.dataset.initial || 50);
    const posts = Array.from(feed.querySelectorAll<HTMLElement>(".lab-post"));
    const groups = Array.from(feed.querySelectorAll<HTMLElement>(".lab-group"));
    const status = document.getElementById("lab-status")!;
    const more = document.getElementById("lab-loadmore") as HTMLButtonElement;
    const empty = document.getElementById("lab-empty")!;
    const toggle = document.getElementById("lab-filter-toggle") as HTMLButtonElement;
    const panel = document.getElementById("lab-filter-panel")!;
    const badge = document.getElementById("lab-filter-badge")!;

    const rows: Record<Dim, HTMLElement> = {
      lab: document.getElementById("lab-labs")!,
      cat: document.getElementById("lab-cats")!,
      region: document.getElementById("lab-regions")!,
      open: document.getElementById("lab-opens")!,
    };
    const active: Record<Dim, string> = { lab: "all", cat: "all", region: "all", open: "all" };
    const dims = Object.keys(active) as Dim[];
    let limit = step;

    const matches = (p: HTMLElement, skip?: Dim) =>
      dims.every((d) => d === skip || active[d] === "all" || p.dataset[d] === active[d]);

    function render() {
      let matched = 0;
      for (const p of posts) {
        const ok = matches(p);
        if (ok) matched++;
        p.classList.toggle("lab-off", !ok || matched > limit);
      }
      for (const g of groups) {
        g.classList.toggle("lab-off", !g.querySelector(".lab-post:not(.lab-off)"));
      }
      const shown = Math.min(matched, limit);
      status.textContent = `顯示 ${shown} / ${matched} 則`;
      empty.hidden = matched > 0;
      more.hidden = matched <= limit;
      more.textContent = `載入更多（還有 ${matched - limit} 則）`;

      // Each chip's count answers "how many posts if I pick this", so it is
      // computed against every other active filter but not its own row.
      for (const d of dims) {
        const counts = new Map<string, number>();
        let all = 0;
        for (const p of posts) {
          if (!matches(p, d)) continue;
          all++;
          const v = p.dataset[d] || "";
          counts.set(v, (counts.get(v) || 0) + 1);
        }
        rows[d].querySelectorAll<HTMLButtonElement>(".lab-chip").forEach((chip) => {
          const v = chip.dataset.value!;
          const n = v === "all" ? all : counts.get(v) || 0;
          const el = chip.querySelector(".lab-count");
          if (el) el.textContent = String(n);
          chip.classList.toggle("is-empty", n === 0 && v !== "all");
        });
      }
      const extra = (active.region !== "all" ? 1 : 0) + (active.open !== "all" ? 1 : 0);
      badge.hidden = extra === 0;
      badge.textContent = String(extra);
    }

    function select(d: Dim, value: string) {
      active[d] = value;
      rows[d].querySelectorAll<HTMLButtonElement>(".lab-chip").forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.value === value)));
    }

    for (const d of dims) {
      rows[d].querySelectorAll<HTMLButtonElement>(".lab-chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          select(d, chip.dataset.value!);
          limit = step;
          render();
        });
      });
    }

    function resetAll() {
      dims.forEach((d) => select(d, "all"));
    }
    feed.querySelectorAll<HTMLButtonElement>("[data-reset]").forEach((b) =>
      b.addEventListener("click", () => {
        resetAll();
        limit = step;
        render();
      }),
    );

    toggle.addEventListener("click", () => {
      const open = panel.hidden;
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    });

    more.addEventListener("click", () => {
      limit += step;
      render();
    });

    // A brief can cite a post that is filtered out or past the load limit, so
    // clear the filters and grow the limit until the target is rendered.
    function reveal(id: string, smooth: boolean) {
      const target = document.getElementById(id);
      if (!target || !target.classList.contains("lab-post")) return false;
      if (target.classList.contains("lab-off")) {
        resetAll();
        const idx = posts.indexOf(target);
        limit = Math.max(step, Math.ceil((idx + 1) / step) * step);
        render();
      }
      requestAnimationFrame(() => {
        const y = target.getBoundingClientRect().top + window.scrollY - 110;
        window.scrollTo({ top: y, behavior: smooth ? "smooth" : "auto" });
        target.classList.add("lab-hl");
        setTimeout(() => target.classList.remove("lab-hl"), 2400);
      });
      return true;
    }

    document.querySelectorAll<HTMLAnchorElement>("a.lab-ref").forEach((a) => {
      a.addEventListener("click", (e) => {
        if (reveal(a.dataset.target!, true)) {
          e.preventDefault();
          history.replaceState(history.state, "", `#${a.dataset.target}`);
        }
      });
    });

    render();
    const hash = decodeURIComponent(location.hash.slice(1));
    if (hash.startsWith("post-")) reveal(hash, false);
  }

  document.addEventListener("astro:page-load", () => {
    initDaily();
    initFeed();
  });
</script>
