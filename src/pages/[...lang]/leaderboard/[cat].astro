---
import Board from "./_Board.astro";
import leaderboard from "@data/leaderboard.json";
import { langOf, withLangs } from "@i18n";

export function getStaticPaths() {
  return withLangs(["orgs", ...Object.keys((leaderboard as any).categories)].map((cat) => ({ params: { cat } })));
}

const { cat } = Astro.params;
const lang = langOf(Astro.params);
---

<Board active={cat!} lang={lang} />
