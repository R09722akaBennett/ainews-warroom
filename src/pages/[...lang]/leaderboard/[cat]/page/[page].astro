---
import type { GetStaticPaths } from "astro";
import Board from "../../_Board.astro";
import { laterPages } from "../../../_lib/paging";
import { langOf, withLangs } from "@i18n";
import { ROWS_PER_PAGE, categories, tableRows } from "../../_data";

export const getStaticPaths = (({ paginate }) =>
  withLangs(Object.keys(categories).flatMap((cat) => laterPages(paginate, tableRows(cat), ROWS_PER_PAGE, { cat })))) satisfies GetStaticPaths;

const { cat } = Astro.params;
const { page } = Astro.props;
const lang = langOf(Astro.params);
---

<Board active={cat!} page={page.currentPage} lang={lang} />
