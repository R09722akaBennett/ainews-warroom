---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import { SITE_SINCE } from "@consts";
import { buildToday } from "@lib/podcasts";
import reportsData from "../data/reports.json";
import summariesData from "../data/summaries.json";
import costsData from "../data/costs.json";
import podcastsData from "../data/podcasts.json";

const reports = (reportsData as any[]).filter((r) => r.date >= SITE_SINCE);
const summaries = (summariesData as any[]).filter((s) => (s.startDate || "") >= SITE_SINCE);

// === Source Quality Analytics (per-date for client-side filtering) ===
// Collected: per date per source, from the items each report was written from
type SQDateEntry = { date: string; source: string; collected: number; referenced: number };
const sqByDateSource: Record<string, Record<string, { collected: number; referenced: number }>> = {};
for (const r of reports) {
  for (const item of r.newsItems || []) {
    const src = item.source || "";
    if (!src) continue;
    if (!sqByDateSource[r.date]) sqByDateSource[r.date] = {};
    if (!sqByDateSource[r.date][src]) sqByDateSource[r.date][src] = { collected: 0, referenced: 0 };
    sqByDateSource[r.date][src].collected += 1;
  }
}
// Referenced: parse ref-N from each report
for (const r of reports) {
  const content = r.content || "";
  const newsItems = r.newsItems || [];
  const refMatches = content.matchAll(/ref-(\d+)/g);
  const citedIndices = new Set<number>();
  for (const m of refMatches) {
    citedIndices.add(parseInt(m[1], 10));
  }
  // Wiki digests number refs from 0; the retired agent numbered them from 1.
  const offset = r.origin === "wiki" ? 0 : 1;
  for (const idx of citedIndices) {
    const item = newsItems[idx - offset];
    if (item) {
      const src = item.source || "";
      if (src) {
        if (!sqByDateSource[r.date]) sqByDateSource[r.date] = {};
        if (!sqByDateSource[r.date][src]) sqByDateSource[r.date][src] = { collected: 0, referenced: 0 };
        sqByDateSource[r.date][src].referenced += 1;
      }
    }
  }
}
// Flatten to array for client-side
const sqData: SQDateEntry[] = [];
for (const [date, srcMap] of Object.entries(sqByDateSource)) {
  for (const [source, counts] of Object.entries(srcMap)) {
    sqData.push({ date, source, collected: counts.collected, referenced: counts.referenced });
  }
}

// === Tag Trend Data ===
// Build date → tags mapping for chart
const tagDates: string[] = reports.map((r: any) => r.date).sort();
const tagsByDate: Record<string, { companies: string[]; models: string[]; topics: string[] }> = {};
for (const r of reports) {
  tagsByDate[r.date] = {
    companies: r.tags?.companies || [],
    models: r.tags?.models || [],
    topics: r.tags?.topics || [],
  };
}

// Collect all unique tags with their type and frequency
type TagInfo = { tag: string; type: string; count: number; dates: string[] };
const tagMap = new Map<string, TagInfo>();
for (const r of reports) {
  const date = r.date;
  for (const [type, tags] of Object.entries(r.tags || {}) as [string, string[]][]) {
    for (const tag of tags) {
      const key = `${type}:${tag}`;
      if (!tagMap.has(key)) {
        tagMap.set(key, { tag, type, count: 0, dates: [] });
      }
      const info = tagMap.get(key)!;
      info.count++;
      info.dates.push(date);
    }
  }
}
const allTags = Array.from(tagMap.values()).sort((a, b) => b.count - a.count);

// Prepare chart data (JSON for client-side)
const chartData = {
  dates: tagDates,
  tags: allTags.slice(0, 20).map(t => ({
    label: t.tag,
    type: t.type,
    data: tagDates.map(d => t.dates.includes(d) ? 1 : 0),
  })),
};

// === Token Cost Dashboard ===
// gemini-3.8-flash standard paid tier, per 1M tokens. These are launch prices
// valid through 2026-12-31; from 2027-01-01 Google doubles them to $1.50 input
// and $7.50 output (ai.google.dev/gemini-api/docs/pricing).
// Every entry is costed at today's price, including runs on older models.
const PRICE_INPUT = 0.75;
const PRICE_OUTPUT = 3.75;  // output includes reasoning tokens

type TokenEntry = {
  label: string;
  date: string;
  type: string; // "daily" | period name
  input: number;
  output: number;
  total: number;
  cost: number;
};

const tokenEntries: TokenEntry[] = [];

// Daily reports
for (const r of reports) {
  const tu = r.tokenUsage;
  if (!tu) continue;
  const cost = (tu.input * PRICE_INPUT + tu.output * PRICE_OUTPUT) / 1_000_000;
  tokenEntries.push({
    label: r.title || r.date,
    date: r.date,
    type: "daily",
    input: tu.input,
    output: tu.output,
    total: tu.total,
    cost,
  });
}

// Periodic summaries
for (const s of summaries) {
  const tu = s.tokenUsage;
  if (!tu) continue;
  const cost = (tu.input * PRICE_INPUT + tu.output * PRICE_OUTPUT) / 1_000_000;
  tokenEntries.push({
    label: s.title || `${s.period} ${s.startDate}`,
    date: s.createdAt?.slice(0, 10) || s.startDate,
    type: s.period,
    input: tu.input,
    output: tu.output,
    total: tu.total,
    cost,
  });
}

// Podcast summaries, dated by the episode they summarise
for (const ep of ((podcastsData as any).episodes || []) as any[]) {
  const tu = ep.tokenUsage;
  if (!tu || !ep.date || ep.date < SITE_SINCE) continue;
  tokenEntries.push({
    label: ep.title,
    date: ep.date,
    type: "podcast",
    input: tu.input,
    output: tu.output,
    total: tu.total,
    cost: (tu.input * PRICE_INPUT + tu.output * PRICE_OUTPUT) / 1_000_000,
  });
}

tokenEntries.sort((a, b) => b.date.localeCompare(a.date));

const tokenTypes = [...new Set(tokenEntries.map(e => e.type))];

const tokenTypeLabels: Record<string, [string, string]> = {
  daily: ["每日快報", "每日快報"],
  raw_weekly: ["週報", "產業週報"],
  raw_monthly: ["月報", "產業月報"],
  raw_quarterly: ["季報", "產業季報"],
  labs_classify: ["Labs 分類", "Labs 貼文分類"],
  labs_weekly: ["Labs 週報", "Labs 週報"],
  podcast: ["Podcast", "Podcast 摘要"],
};
// Only offer filters for types that have entries in the shown range.
const tokenTypeButtons = Object.keys(tokenTypeLabels)
  .filter((t) => tokenTypes.includes(t))
  .concat(tokenTypes.filter((t) => !(t in tokenTypeLabels)))
  .map((t) => ({ type: t, label: tokenTypeLabels[t]?.[0] || t, title: tokenTypeLabels[t]?.[1] || t }));

const rangeStart = reports.map((r) => r.date).sort()[0] || SITE_SINCE;
const rangeEnd = reports.map((r) => r.date).sort().at(-1) || SITE_SINCE;

// === Running costs ===
type CostDay = { date: string; x_posts_billed: number; x_usd: number; jev_calls: number; jev_input_tokens: number; jev_usd: number };
type OneOff = { date: string; item: string; label: string; usd: number; note: string };
const costs = costsData as unknown as {
  updatedAt: string;
  prices: { x_post: number; x_user_lookup: number; jev_per_mtok_input: number };
  subscriptions: { name: string; usd_per_year: number }[];
  oneOff: OneOff[];
  days: CostDay[];
};
const costDays = (costs.days || []).filter((d) => d.date >= SITE_SINCE);
const oneOffs = (costs.oneOff || []).filter((o) => o.date >= SITE_SINCE).sort((a, b) => b.date.localeCompare(a.date));
const subscriptions = costs.subscriptions || [];
const subsPerMonth = subscriptions.reduce((t, x) => t + x.usd_per_year / 12, 0);

const geminiByDate: Record<string, number> = {};
for (const e of tokenEntries) geminiByDate[e.date] = (geminiByDate[e.date] || 0) + e.cost;

const costMonths = [...new Set([
  ...costDays.map((d) => d.date.slice(0, 7)),
  ...oneOffs.map((o) => o.date.slice(0, 7)),
  ...tokenEntries.map((e) => e.date.slice(0, 7)),
])].filter((m) => m >= SITE_SINCE.slice(0, 7)).sort().reverse();

type MonthCost = {
  month: string;
  gemini: number;
  x: number;
  xOneOff: number;
  jev: number;
  other: number;
  subs: number;
  total: number;
  rows: { date: string; gemini: number; x: number; jev: number; posts: number; calls: number }[];
};
const monthCosts: MonthCost[] = costMonths.map((month) => {
  const inMonth = (d: string) => d.startsWith(month);
  const days = costDays.filter((d) => inMonth(d.date));
  const offs = oneOffs.filter((o) => inMonth(o.date));
  const dates = [...new Set([...days.map((d) => d.date), ...Object.keys(geminiByDate).filter(inMonth)])].sort().reverse();
  const rows = dates.map((date) => {
    const d = days.find((x) => x.date === date);
    return { date, gemini: geminiByDate[date] || 0, x: d?.x_usd || 0, jev: d?.jev_usd || 0, posts: d?.x_posts_billed || 0, calls: d?.jev_calls || 0 };
  });
  const gemini = rows.reduce((t, r) => t + r.gemini, 0);
  const xOneOff = offs.filter((o) => o.item === "X").reduce((t, o) => t + o.usd, 0);
  const x = rows.reduce((t, r) => t + r.x, 0) + xOneOff;
  const jev = rows.reduce((t, r) => t + r.jev, 0) + offs.filter((o) => o.item === "Jev").reduce((t, o) => t + o.usd, 0);
  const other = offs.filter((o) => o.item !== "X" && o.item !== "Jev").reduce((t, o) => t + o.usd, 0);
  return { month, gemini, x, xOneOff, jev, other, subs: subsPerMonth, total: gemini + x + jev + other + subsPerMonth, rows };
});
const thisMonth = buildToday().slice(0, 7);
const monthLabel = (m: string) => (m === thisMonth ? "本月" : `${Number(m.slice(5))} 月`);
const subsSource = subscriptions.map((x) => `$${x.usd_per_year}/年`).join(" + ");
const usd = (n: number) => (n >= 1 ? `$${n.toFixed(2)}` : `$${n.toFixed(4)}`);

---

<Layout title="Analytics" description="AI War Room 的 LLM token 成本、營運成本、標籤趨勢與來源品質。">
  <Container>
    <div class="space-y-12">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Analytics</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
          {rangeStart} ~ {rangeEnd} 共 {reports.length} 份快報的 LLM token 成本、營運成本、標籤趨勢與來源品質。
        </p>
      </div>

      {/* Global Time Range */}
      <div class="flex flex-wrap items-center gap-3" style="border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
        <span class="meta">時間範圍</span>
        <div class="flex flex-wrap gap-1" id="global-range-btns">
          <button type="button" data-grange="today" class="tag-filter">今天</button>
          <button type="button" data-grange="yesterday" class="tag-filter">昨天</button>
          <button type="button" data-grange="7" class="tag-filter">7 天</button>
          <button type="button" data-grange="30" class="tag-filter">30 天</button>
          <button type="button" data-grange="90" class="tag-filter">90 天</button>
          <button type="button" data-grange="all" class="tag-filter tag-filter-active">全部</button>
        </div>
        <div class="flex items-center gap-1.5">
          <input type="date" id="global-date-from" class="date-input" aria-label="開始日期" />
          <span class="meta">~</span>
          <input type="date" id="global-date-to" class="date-input" aria-label="結束日期" />
        </div>
      </div>

      <section class="space-y-4">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div>
            <h2 class="text-lg font-semibold" style="color: var(--color-text);">Token 用量與成本</h2>
            <p class="text-xs mt-0.5" style="color: var(--color-text-muted);">
              以 gemini-3.8-flash 現價估算：每百萬 input token ${PRICE_INPUT}、output token ${PRICE_OUTPUT}。
            </p>
          </div>
          <div class="flex gap-1.5 flex-wrap" id="token-type-filters">
            <button type="button" data-ttype="all" class="tag-filter tag-filter-active">全部</button>
            {tokenTypeButtons.map((b) => (
              <button type="button" data-ttype={b.type} class="tag-filter" title={b.title}>{b.label}</button>
            ))}
          </div>
        </div>

        {/* Summary cards (JS-driven) */}
        <div class="grid gap-4 grid-cols-2 md:grid-cols-4" id="token-cards">
          <div class="card p-4 text-center">
            <div class="meta mb-1">輸入</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);" id="card-input">—</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">輸出</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);" id="card-output">—</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">合計</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-text);" id="card-total">—</div>
          </div>
          <div class="card p-4 text-center">
            <div class="meta mb-1">估算成本</div>
            <div class="text-lg font-mono font-bold" style="color: var(--color-quarterly-text);" id="card-cost">—</div>
          </div>
        </div>

        {/* Chart */}
        <div class="card p-4" style="position: relative; height: 300px;">
          <canvas id="token-chart" role="img" aria-label="每日 token 用量長條圖"></canvas>
        </div>

        {/* Detailed table (JS-driven) */}
        <details class="group">
          <summary class="flex cursor-pointer items-center gap-3 py-2 text-sm font-semibold" style="color: var(--color-text); min-height: 40px;">
            <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
              <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span id="breakdown-title">明細</span>
          </summary>
          <div class="overflow-x-auto mt-2">
            <table class="source-table">
              <thead>
                <tr>
                  <th style="width: 7rem;">日期</th>
                  <th style="width: 3rem;">類型</th>
                  <th style="text-align: right; width: 7rem;">輸入</th>
                  <th style="text-align: right; width: 7rem;">輸出</th>
                  <th style="text-align: right; width: 7rem;">合計</th>
                  <th style="text-align: right; width: 6rem;">成本</th>
                </tr>
              </thead>
              <tbody id="breakdown-body"></tbody>
            </table>
          </div>
        </details>
      </section>

      <section class="space-y-4" id="running-costs">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div>
            <h2 class="text-lg font-semibold" style="color: var(--color-text);">營運成本</h2>
            <p class="text-xs mt-0.5" style="color: var(--color-text-muted);">
              Gemini、X API（含帳號查詢）、Jev 與訂閱的實際花費，從 {SITE_SINCE} 起算，以月為單位。
            </p>
          </div>
          {monthCosts.length > 1 && (
            <div class="flex gap-1.5 flex-wrap" id="cost-month-tabs">
              {monthCosts.map((m, i) => (
                <button type="button" data-cmonth={m.month} class:list={["tag-filter", { "tag-filter-active": i === 0 }]}>{m.month}</button>
              ))}
            </div>
          )}
        </div>

        {monthCosts.length === 0 ? (
          <div class="card p-6 text-sm" style="color: var(--color-text-muted);">還沒有成本資料。</div>
        ) : monthCosts.map((m, i) => (
          <div class="space-y-4" data-cmonth-panel={m.month} hidden={i !== 0}>
            <div class="grid gap-3 grid-cols-2 md:grid-cols-5">
              <div class="card p-4 col-span-2 md:col-span-1 cost-card-total">
                <div class="meta mb-1">{monthLabel(m.month)}合計</div>
                <div class="text-xl font-mono font-bold" style="color: var(--color-text);">{usd(m.total)}</div>
                <div class="cost-sub">{m.month}</div>
              </div>
              <div class="card p-4">
                <div class="meta mb-1">Gemini</div>
                <div class="text-lg font-mono font-bold" style="color: var(--color-quarterly-text);">{usd(m.gemini)}</div>
                <div class="cost-sub">依上方 token 估算</div>
              </div>
              <div class="card p-4">
                <div class="meta mb-1">X API（含帳號查詢）</div>
                <div class="text-lg font-mono font-bold" style="color: var(--color-text);">{usd(m.x)}</div>
                <div class="cost-sub">{m.xOneOff > 0 ? `含一次性 ${usd(m.xOneOff)}` : "貼文與帳號查詢，每日計費"}</div>
              </div>
              <div class="card p-4">
                <div class="meta mb-1">Jev</div>
                <div class="text-lg font-mono font-bold" style="color: var(--color-text);">{usd(m.jev)}</div>
                <div class="cost-sub">{m.rows.reduce((t, r) => t + r.calls, 0).toLocaleString()} 次呼叫</div>
              </div>
              <div class="card p-4">
                <div class="meta mb-1">訂閱分攤</div>
                <div class="text-lg font-mono font-bold" style="color: var(--color-text);">{usd(m.subs)}</div>
                <div class="cost-sub">{subsSource || "無"}</div>
              </div>
            </div>

            <details class="group" open>
              <summary class="flex cursor-pointer items-center gap-3 py-2 text-sm font-semibold" style="color: var(--color-text); min-height: 40px;">
                <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
                  <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                每日明細（{m.rows.length} 天，不含一次性與訂閱）
              </summary>
              <div class="overflow-x-auto mt-2 cost-table-wrap">
                <table class="source-table cost-table">
                  <thead>
                    <tr>
                      <th>日期</th>
                      <th style="text-align: right;">Gemini</th>
                      <th style="text-align: right;">X API</th>
                      <th style="text-align: right;">Jev</th>
                      <th style="text-align: right;">小計</th>
                    </tr>
                  </thead>
                  <tbody>
                    {m.rows.map((r) => (
                      <tr>
                        <td class="font-mono">{r.date.slice(5)}</td>
                        <td class="cost-num">{usd(r.gemini)}</td>
                        <td class="cost-num" title={`${r.posts} 則計費貼文`}>{r.x ? usd(r.x) : "—"}</td>
                        <td class="cost-num" title={`${r.calls} 次呼叫`}>{r.jev ? usd(r.jev) : "—"}</td>
                        <td class="cost-num" style="color: var(--color-text); font-weight: 600;">{usd(r.gemini + r.x + r.jev)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </div>
        ))}

        {oneOffs.length > 0 && (
          <div class="space-y-2">
            <h3 class="text-sm font-semibold" style="color: var(--color-text);">一次性支出</h3>
            <ul class="card divide-y" style="list-style: none; margin: 0; padding: 0;">
              {oneOffs.map((o) => (
                <li class="cost-oneoff">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="meta">{o.date}</span>
                    <span class="tag tag-model">{o.item}</span>
                    <span class="text-sm" style="color: var(--color-text);">{o.label}</span>
                    <span class="ml-auto font-mono text-sm font-semibold" style="color: var(--color-text);">{usd(o.usd)}</span>
                  </div>
                  {o.note && <p class="text-xs mt-1" style="color: var(--color-text-muted);">{o.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}

        <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">
          X：每則貼文 ${costs.prices?.x_post ?? 0.005}、帳號查詢 ${costs.prices?.x_user_lookup ?? 0.01}；Jev：每百萬 input token ${costs.prices?.jev_per_mtok_input ?? 0.042}（output 免費，<a href="https://docs.typesafe.ai/models" target="_blank" rel="noopener noreferrer" style="color: var(--color-accent-cool-text);">docs.typesafe.ai/models</a>）；Gemini 依頁面上方的估算。訂閱以年費除以 12 分攤到每月。資料更新於 {costs.updatedAt?.slice(0, 10)}。
        </p>
      </section>

      <section class="space-y-4">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div>
            <h2 class="text-lg font-semibold" style="color: var(--color-text);">標籤趨勢</h2>
            <p class="text-xs mt-0.5" style="color: var(--color-text-muted);">
              {reports.length} 份快報裡的 {allTags.length} 個標籤。點下方的標籤可以顯示或隱藏曲線。
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5" id="tag-type-filters">
            <button type="button" data-type="all" class="tag-filter tag-filter-active">全部</button>
            <button type="button" data-type="companies" class="tag-filter" style="--filter-color: #9333ea;">公司</button>
            <button type="button" data-type="models" class="tag-filter" style="--filter-color: var(--color-accent-cool-text);">模型</button>
            <button type="button" data-type="topics" class="tag-filter" style="--filter-color: var(--color-accent-warm-text);">話題</button>
          </div>
        </div>
        {allTags.length > 0 ? (
          <>
            <div class="card p-4" style="position: relative; height: 400px;">
              <canvas id="tag-chart" role="img" aria-label="標籤累計提及次數折線圖"></canvas>
            </div>
            {/* Chart.js's own legend cannot be filtered by tag type. */}
            <div class="tag-list-container" id="tag-list">
              {allTags.slice(0, 20).map((t, i) => {
                const color = t.type === "companies" ? "#9333ea" : t.type === "models" ? "var(--color-accent-cool-text)" : "var(--color-accent-warm-text)";
                return (
                  <button
                    type="button"
                    class="tag-list-item"
                    data-tag-idx={String(i)}
                    data-tag-type={t.type}
                    style={`--tag-color: ${color};`}
                  >
                    <span class="tag-list-dot"></span>
                    <span class="tag-list-name">{t.tag}</span>
                    <span class="tag-list-count">{t.count}</span>
                  </button>
                );
              })}
            </div>
          </>
        ) : (
          <div class="card p-8 text-center">
            <p class="text-sm" style="color: var(--color-text-muted);">資料還不夠，累積更多每日快報後會顯示標籤趨勢。</p>
          </div>
        )}
      </section>

      <section class="space-y-4">
        <div>
          <h2 class="text-lg font-semibold" style="color: var(--color-text);">來源品質</h2>
          <p class="text-xs mt-0.5" style="color: var(--color-text-muted);">
            各來源收錄的新聞有多少被每日快報引用；收錄多、引用少的來源多半是雜訊。
          </p>
        </div>
        <div class="overflow-x-auto">
          <table class="source-table">
            <thead>
              <tr>
                <th style="width: 14rem;">來源</th>
                <th style="text-align: right; width: 7rem;" title="這段期間從這個來源收錄的新聞則數">收錄</th>
                <th style="text-align: right; width: 7rem;" title="其中被每日快報引用的則數">引用</th>
                <th style="text-align: right; width: 6rem;" title="引用除以收錄，越高代表來源越有價值">引用率</th>
                <th style="width: 10rem;" title="引用率的長條圖">分布</th>
              </tr>
            </thead>
            <tbody id="sq-body"></tbody>
          </table>
        </div>
      </section>
    </div>
  </Container>
</Layout>

<style>
  /* === Tag filters === */
  .tag-filter {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .tag-filter:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
  .tag-filter-active {
    color: var(--filter-color, var(--color-text));
    border-color: var(--filter-color, var(--color-border));
    background-color: color-mix(in srgb, var(--filter-color, var(--color-surface-muted)) 10%, transparent);
    font-weight: 600;
  }

  /* === Date input === */
  .date-input {
    min-height: 40px;
    padding: 0 0.4rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-raised);
    color: var(--color-text);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    outline: none;
  }
  .date-input:focus {
    border-color: var(--color-accent-cool);
  }

  /* === Tag list (custom legend) === */
  .tag-list-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    max-height: 11rem;
    overflow-y: auto;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-surface-raised);
  }
  .tag-list-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    padding: 0 0.625rem;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    max-width: 100%;
  }
  .tag-list-item:hover {
    border-color: var(--tag-color);
    color: var(--color-text);
  }
  .tag-list-item.tag-active {
    border-color: var(--tag-color);
    color: var(--tag-color);
    background-color: color-mix(in srgb, var(--tag-color) 8%, transparent);
    font-weight: 600;
  }
  .tag-list-item.tag-hidden-type {
    display: none;
  }
  .tag-list-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--tag-color);
    flex-shrink: 0;
  }
  .tag-list-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tag-list-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-muted);
  }

  /* === Source table === */
  .source-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .source-table th {
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }
  .source-table th[title] {
    cursor: help;
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-text-muted);
  }
  .source-table td {
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cost-sub { margin-top: 0.25rem; font-size: 0.6875rem; color: var(--color-text-muted); }
  .cost-card-total { border-color: color-mix(in srgb, var(--color-accent-cool) 45%, var(--color-border)); }
  .cost-table-wrap { max-height: 22rem; overflow-y: auto; }
  .cost-table th, .cost-table td { padding-left: 0.5rem; padding-right: 0.5rem; }
  .cost-num { text-align: right; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-muted); white-space: nowrap; }
  .cost-oneoff { padding: 0.75rem 1rem; }
  .source-table tbody tr:hover {
    background-color: var(--color-surface-muted);
  }

</style>
<style is:global>
  /* Global — these are used in JS-rendered table rows */
  .bar-bg {
    height: 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--color-surface-muted);
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 0.25rem;
    transition: width 0.3s;
  }
</style>

<script>
  function initCostTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>("#cost-month-tabs [data-cmonth]");
    tabs.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        tabs.forEach((b) => b.classList.toggle("tag-filter-active", b === btn));
        document.querySelectorAll<HTMLElement>("[data-cmonth-panel]").forEach((p) => {
          p.hidden = p.dataset.cmonthPanel !== btn.dataset.cmonth;
        });
      });
    });
  }
  document.addEventListener("astro:page-load", initCostTabs);
</script>

<script is:inline define:vars={{ chartData, tokenEntries, sqData }}>
  window.__analyticsData = { chartData, tokenEntries, sqData };
</script>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

{/* The router re-runs inline scripts on every visit, which would stack
    astro:page-load listeners and throw on the redeclared consts; the flag
    keeps a single listener, and tryInit re-reads the data the page inlined. */}
<script is:inline>
(function () {
  if (window.__analyticsBound) return;
  window.__analyticsBound = true;

  var chartData = null;
  var tokenEntries = [];
  var sqData = [];
  var globalDateFrom = "";
  var globalDateTo = "";
  var tokenFilterType = "all";

  function getTypeBadge(type) {
    var m = { daily: "快報", labs_classify: "分類", labs_weekly: "Labs 週", raw_weekly: "週",
      raw_monthly: "月", raw_quarterly: "季", podcast: "Podcast" };
    return m[type] || type;
  }
  function getTypePeriodClass(type) {
    if (type === "daily") return "warroom";
    if (type.indexOf("classify") >= 0) return "industry";
    if (type.indexOf("weekly") >= 0) return "weekly";
    if (type.indexOf("monthly") >= 0) return "monthly";
    return "quarterly";
  }
  function getTypeTitle(type) {
    var m = { daily: "每日快報", labs_classify: "Labs 每日貼文分類",
      labs_weekly: "Labs 週報", raw_weekly: "產業週報",
      raw_monthly: "產業月報", raw_quarterly: "產業季報", podcast: "Podcast 摘要" };
    return m[type] || type;
  }

  function filteredTokenEntries() {
    return tokenEntries.filter(function(e) {
      if (tokenFilterType !== "all" && e.type !== tokenFilterType) return false;
      if (globalDateFrom && e.date < globalDateFrom) return false;
      if (globalDateTo && e.date > globalDateTo) return false;
      return true;
    });
  }

  function updateTokenCards() {
    var entries = filteredTokenEntries();
    var inp = 0, out = 0, tot = 0, cost = 0;
    entries.forEach(function(e) { inp += e.input; out += e.output; tot += e.total; cost += e.cost; });
    var ci = document.getElementById("card-input");
    var co = document.getElementById("card-output");
    var ct = document.getElementById("card-total");
    var cc = document.getElementById("card-cost");
    if (ci) ci.textContent = (inp / 1000000).toFixed(2) + "M";
    if (co) co.textContent = (out / 1000000).toFixed(2) + "M";
    if (ct) ct.textContent = (tot / 1000000).toFixed(2) + "M";
    if (cc) cc.textContent = "$" + cost.toFixed(4);
  }

  function updateBreakdownTable() {
    var entries = filteredTokenEntries();
    var tbody = document.getElementById("breakdown-body");
    var title = document.getElementById("breakdown-title");
    if (!tbody) return;
    if (title) title.textContent = "明細（" + entries.length + " 次 LLM 呼叫）";
    tbody.innerHTML = entries.map(function(e) {
      return '<tr><td class="meta">' + e.date + '</td>' +
        '<td><span class="period-label period-' + getTypePeriodClass(e.type) + '" title="' + getTypeTitle(e.type) + '">' + getTypeBadge(e.type) + '</span></td>' +
        '<td style="text-align:right" class="meta">' + e.input.toLocaleString() + '</td>' +
        '<td style="text-align:right" class="meta">' + e.output.toLocaleString() + '</td>' +
        '<td style="text-align:right;font-family:var(--font-mono);font-size:0.75rem;font-weight:600;color:var(--color-text)">' + e.total.toLocaleString() + '</td>' +
        '<td style="text-align:right;font-family:var(--font-mono);font-size:0.75rem;color:var(--color-quarterly-text)">$' + e.cost.toFixed(4) + '</td></tr>';
    }).join("");
  }

  function updateTokenChartData() {
    if (!window.__tokenChart) return;
    var entries = filteredTokenEntries();
    var dateMap = {};
    entries.forEach(function(e) {
      if (!dateMap[e.date]) dateMap[e.date] = { input: 0, output: 0 };
      dateMap[e.date].input += e.input;
      dateMap[e.date].output += e.output;
    });
    var dates = Object.keys(dateMap).sort();
    window.__tokenChart.data.labels = dates;
    window.__tokenChart.data.datasets[0].data = dates.map(function(d) { return dateMap[d].input / 1000; });
    window.__tokenChart.data.datasets[1].data = dates.map(function(d) { return dateMap[d].output / 1000; });
    window.__tokenChart.update();
  }

  function updateAllTokenViews() {
    updateTokenCards();
    updateBreakdownTable();
    updateTokenChartData();
  }

  function updateSourceQuality() {
    var filtered = sqData.filter(function(e) {
      if (globalDateFrom && e.date < globalDateFrom) return false;
      if (globalDateTo && e.date > globalDateTo) return false;
      return true;
    });
    // Aggregate by source
    var srcMap = {};
    filtered.forEach(function(e) {
      if (!srcMap[e.source]) srcMap[e.source] = { collected: 0, referenced: 0 };
      srcMap[e.source].collected += e.collected;
      srcMap[e.source].referenced += e.referenced;
    });
    var rows = Object.keys(srcMap).map(function(src) {
      var c = srcMap[src].collected;
      var r = srcMap[src].referenced;
      return { source: src, collected: c, referenced: r, rate: c > 0 ? r / c : 0 };
    });
    rows.sort(function(a, b) { return b.referenced - a.referenced || b.collected - a.collected; });
    var tbody = document.getElementById("sq-body");
    if (!tbody) return;
    tbody.innerHTML = rows.map(function(row) {
      var barWidth = Math.min(row.rate * 100, 100);
      var barColor = row.rate > 0.5 ? "var(--color-quarterly)" : row.rate > 0.1 ? "var(--color-accent-cool)" : "var(--color-text-muted)";
      return '<tr>' +
        '<td class="font-medium" style="color:var(--color-text)">' + row.source + '</td>' +
        '<td class="text-right meta">' + row.collected + '</td>' +
        '<td class="text-right meta">' + row.referenced + '</td>' +
        '<td class="text-right"><span class="font-mono text-xs font-semibold" style="color:' + barColor + '">' + (row.rate * 100).toFixed(1) + '%</span></td>' +
        '<td><div class="bar-bg"><div class="bar-fill" style="width:' + barWidth + '%;background-color:' + barColor + '"></div></div></td>' +
        '</tr>';
    }).join("");
  }

  const TYPE_COLORS = {
    companies: { border: "#9333ea", bg: "rgba(147, 51, 234, 0.1)" },
    models: { border: "#0891b2", bg: "rgba(8, 145, 178, 0.1)" },
    topics: { border: "#d97706", bg: "rgba(217, 119, 6, 0.1)" },
  };

  function initTokenChart() {
    var canvas = document.getElementById("token-chart");
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = "true";
    // A chart from an earlier visit still holds the swapped-out canvas.
    if (window.__tokenChart) window.__tokenChart.destroy();

    var isDark = document.documentElement.classList.contains("dark");
    var gridColor = isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.06)";
    var textColor = isDark ? "#78859b" : "#78716c";

    window.__tokenChart = new Chart(canvas, {
      type: "bar",
      data: { labels: [], datasets: [
        { label: "輸入（K）", data: [],
          backgroundColor: isDark ? "rgba(34, 211, 238, 0.5)" : "rgba(8, 145, 178, 0.5)",
          borderColor: isDark ? "#22d3ee" : "#0891b2", borderWidth: 1 },
        { label: "輸出（K）", data: [],
          backgroundColor: isDark ? "rgba(245, 158, 11, 0.5)" : "rgba(217, 119, 6, 0.5)",
          borderColor: isDark ? "#f59e0b" : "#d97706", borderWidth: 1 },
      ]},
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { position: "bottom", labels: { color: textColor, font: { size: 11, family: "Geist Mono, monospace" }, boxWidth: 12 } },
          tooltip: {
            backgroundColor: isDark ? "#141825" : "#fff",
            titleColor: isDark ? "#e7e5e4" : "#1c1917",
            bodyColor: isDark ? "#78859b" : "#78716c",
            borderColor: isDark ? "#252a3a" : "#e2e0dc", borderWidth: 1,
            callbacks: { label: function(ctx) { return ctx.dataset.label + ": " + ctx.parsed.y.toFixed(1) + "K"; } },
          },
        },
        scales: {
          x: { stacked: true, grid: { color: gridColor }, ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } } },
          y: { stacked: true, grid: { color: gridColor }, ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } },
            title: { display: true, text: "Token（K）", color: textColor, font: { size: 11 } } },
        },
      },
    });

    // Wire up type filter only (time range is global)
    document.querySelectorAll("[data-ttype]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        tokenFilterType = btn.dataset.ttype;
        document.querySelectorAll("#token-type-filters .tag-filter").forEach(function(b) {
          b.classList.toggle("tag-filter-active", b.dataset.ttype === tokenFilterType);
        });
        updateAllTokenViews();
      });
    });

    updateAllTokenViews();
  }

  function initAnalytics() {
    if (typeof Chart === "undefined") return; // Chart.js not loaded yet
    initTokenChart();

    if (!chartData) return;
    const canvas = document.getElementById("tag-chart");
    if (!canvas || canvas.dataset.bound) return;
    canvas.dataset.bound = "true";

    const datasets = chartData.tags.map((tag) => {
      const colors = TYPE_COLORS[tag.type] || TYPE_COLORS.topics;
      // Cumulative count for timeline
      let cumulative = 0;
      const cumulativeData = tag.data.map(v => { cumulative += v; return cumulative; });

      return {
        label: tag.label,
        data: cumulativeData,
        borderColor: colors.border,
        backgroundColor: colors.bg,
        borderWidth: 2,
        pointRadius: 3,
        tension: 0.3,
        hidden: false,
        _type: tag.type,
      };
    });

    // Default visibility: top 3 per type
    var typeCounts = {};
    datasets.forEach(function(ds) {
      var t = ds._type;
      typeCounts[t] = (typeCounts[t] || 0) + 1;
      ds.hidden = typeCounts[t] > 3;
    });

    var isDark = document.documentElement.classList.contains("dark");
    var gridColor = isDark ? "rgba(255,255,255,0.06)" : "rgba(0,0,0,0.06)";
    var textColor = isDark ? "#78859b" : "#78716c";

    if (window.__tagChart) window.__tagChart.destroy();
    window.__tagChart = new Chart(canvas, {
      type: "line",
      data: {
        labels: chartData.dates,
        datasets: datasets,
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: "index",
          intersect: false,
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: isDark ? "#141825" : "#fff",
            titleColor: isDark ? "#e7e5e4" : "#1c1917",
            bodyColor: isDark ? "#78859b" : "#78716c",
            borderColor: isDark ? "#252a3a" : "#e2e0dc",
            borderWidth: 1,
          },
        },
        scales: {
          x: {
            grid: { color: gridColor },
            ticks: { color: textColor, font: { size: 10, family: "Geist Mono, monospace" } },
          },
          y: {
            beginAtZero: true,
            grid: { color: gridColor },
            ticks: {
              color: textColor,
              font: { size: 10, family: "Geist Mono, monospace" },
              stepSize: 1,
            },
            title: {
              display: true,
              text: "累計提及次數",
              color: textColor,
              font: { size: 11 },
            },
          },
        },
      },
    });

    // Sync tag list items with chart visibility
    function syncTagList() {
      document.querySelectorAll(".tag-list-item").forEach(function(item) {
        var idx = parseInt(item.dataset.tagIdx);
        var ds = window.__tagChart.data.datasets[idx];
        if (ds) item.classList.toggle("tag-active", !ds.hidden);
      });
    }
    syncTagList();

    // Click tag list item → toggle dataset
    document.querySelectorAll(".tag-list-item").forEach(function(item) {
      item.addEventListener("click", function() {
        var idx = parseInt(item.dataset.tagIdx);
        var ds = window.__tagChart.data.datasets[idx];
        if (ds) {
          ds.hidden = !ds.hidden;
          window.__tagChart.update();
          syncTagList();
        }
      });
    });

    // Every filter row on the page shares the .tag-filter class, so the
    // lookup must stay inside this row or it clears the others' active state.
    var activeType = "all";
    document.querySelectorAll("#tag-type-filters [data-type]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        activeType = btn.dataset.type;
        document.querySelectorAll("#tag-type-filters .tag-filter").forEach(function(b) {
          b.classList.toggle("tag-filter-active", b.dataset.type === activeType);
        });

        // Show/hide datasets by type
        window.__tagChart.data.datasets.forEach(function(ds) {
          if (activeType === "all") {
            ds.hidden = false;
          } else {
            ds.hidden = ds._type !== activeType;
          }
        });
        window.__tagChart.update();

        // Show/hide tag list items by type
        document.querySelectorAll(".tag-list-item").forEach(function(item) {
          if (activeType === "all") {
            item.classList.remove("tag-hidden-type");
          } else {
            item.classList.toggle("tag-hidden-type", item.dataset.tagType !== activeType);
          }
        });
        syncTagList();
      });
    });
  }

  // Report dates are Taiwan calendar days; UTC "today" is still yesterday
  // there until 08:00.
  var taipeiFormat = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Taipei" });
  function taipeiDate(ms) {
    return taipeiFormat.format(new Date(ms));
  }

  function initGlobalRange() {
    var row = document.getElementById("global-range-btns");
    if (!row || row.dataset.bound) return;
    row.dataset.bound = "true";
    var fromEl = document.getElementById("global-date-from");
    var toEl = document.getElementById("global-date-to");

    function updateAll() {
      updateAllTokenViews();
      updateTagChart();
      updateSourceQuality();
    }

    // Quick buttons
    document.querySelectorAll("[data-grange]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        document.querySelectorAll("#global-range-btns .tag-filter").forEach(function(b) {
          b.classList.toggle("tag-filter-active", b.dataset.grange === btn.dataset.grange);
        });
        var g = btn.dataset.grange;
        if (g === "all") {
          globalDateFrom = "";
          globalDateTo = "";
        } else if (g === "today") {
          var d = taipeiDate(Date.now());
          globalDateFrom = d;
          globalDateTo = d;
        } else if (g === "yesterday") {
          var y = taipeiDate(Date.now() - 86400000);
          globalDateFrom = y;
          globalDateTo = y;
        } else {
          var days = parseInt(g);
          var now = Date.now();
          globalDateFrom = taipeiDate(now - days * 86400000);
          globalDateTo = taipeiDate(now);
        }
        if (fromEl) fromEl.value = globalDateFrom;
        if (toEl) toEl.value = globalDateTo;
        updateAll();
      });
    });

    // Custom date inputs
    function onDateChange() {
      globalDateFrom = fromEl ? fromEl.value : "";
      globalDateTo = toEl ? toEl.value : "";
      document.querySelectorAll("#global-range-btns .tag-filter").forEach(function(b) {
        b.classList.remove("tag-filter-active");
      });
      updateAll();
    }
    if (fromEl) fromEl.addEventListener("change", onDateChange);
    if (toEl) toEl.addEventListener("change", onDateChange);
  }

  // Update tag chart by global date range
  function updateTagChart() {
    if (!window.__tagChart || !chartData) return;
    // Find date indices within range
    var indices = [];
    chartData.dates.forEach(function(d, i) {
      if (globalDateFrom && d < globalDateFrom) return;
      if (globalDateTo && d > globalDateTo) return;
      indices.push(i);
    });
    var filteredDates = indices.map(function(i) { return chartData.dates[i]; });
    window.__tagChart.data.labels = filteredDates;
    window.__tagChart.data.datasets.forEach(function(ds, di) {
      var tag = chartData.tags[di];
      if (!tag) return;
      var cumulative = 0;
      ds.data = indices.map(function(i) { cumulative += tag.data[i]; return cumulative; });
    });
    window.__tagChart.update();
  }

  function waitForChart() {
    if (!document.getElementById("token-chart")) return;
    if (typeof Chart !== "undefined") {
      initAnalytics();
      initGlobalRange();
    } else {
      setTimeout(waitForChart, 100);
    }
  }

  // Bound once for the whole visit, so it also fires on the other pages.
  function tryInit() {
    if (!document.getElementById("token-chart")) return;
    var ad = window.__analyticsData || {};
    chartData = ad.chartData || null;
    tokenEntries = ad.tokenEntries || [];
    sqData = ad.sqData || [];
    globalDateFrom = "";
    globalDateTo = "";
    tokenFilterType = "all";
    updateSourceQuality();
    waitForChart();
  }

  document.addEventListener("astro:page-load", tryInit);
})();
</script>
