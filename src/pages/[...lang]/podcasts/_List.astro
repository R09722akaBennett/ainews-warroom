---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import Pagination from "@components/Pagination.astro";

import type { PageSlice } from "../_lib/paging";
import { buildToday, minutes, recencyLabel, type EpisodeSummary } from "@lib/podcasts";

type Props = { page: PageSlice<EpisodeSummary> };
const { page } = Astro.props;
const episodes = page.data;
const today = buildToday();

function searchText(e: EpisodeSummary): string {
  return [e.title, e.subtitle, e.one_liner, ...(e.topics || []), ...(e.guests || []).map((g) => g.name)]
    .join(" ")
    .toLowerCase();
}
---

<Layout title={page.currentPage === 1 ? "Podcasts" : `Podcasts 第 ${page.currentPage} 頁`} description="AI 工程 podcast 的中文重點整理與逐字稿，目前收 Latent Space。">
  <Container>
    <div class="pc-wrap">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Podcasts</h1>
        <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-text-muted);">
          AI 工程 podcast 的中文重點整理與逐字稿，目前收 Latent Space。
        </p>
      </div>

      {episodes.length === 0 ? (
        <div class="card p-8 text-center text-sm" style="color: var(--color-text-muted);">
          還沒有整理好的集數，第一批整理完成後會出現在這裡。
        </div>
      ) : (
        <>
          <div class="pc-toolbar">
            <label class="pc-search">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
              <input id="pc-q" type="search" placeholder="搜尋本頁的標題、來賓或話題" autocomplete="off" aria-label="搜尋本頁的集數" />
            </label>
            <span class="meta" id="pc-count" data-total={page.total} data-shown={episodes.length}>共 {page.total} 集{page.lastPage > 1 && `，這頁 ${episodes.length} 集`}</span>
          </div>

          <ul class="pc-list" id="pc-list">
            {episodes.map((e) => {
              const label = recencyLabel(e.date, today);
              const [, mm, dd] = e.date.split("-");
              return (
                <li data-q={searchText(e)}>
                  <a href={`/podcasts/${e.slug}`} class="card pc-row">
                    <div class:list={["pc-badge", { "pc-badge-recent": label }]}>
                      <span class="pc-badge-day">{mm}/{dd}</span>
                      <span class="pc-badge-label">{label || e.date.slice(0, 4)}</span>
                    </div>
                    <div class="pc-body">
                      <div class="pc-meta">
                        <span class="pc-show">{e.show}</span>
                        <span>·</span>
                        <span>{minutes(e.duration)}</span>
                      </div>
                      <h2 class="pc-title">{e.title}</h2>
                      {e.one_liner && <p class="pc-oneliner">{e.one_liner}</p>}
                      {e.guests?.length > 0 && (
                        <p class="pc-guests">{e.guests.map((g) => g.name).join("、")}</p>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
          <p id="pc-empty" class="text-sm" style="color: var(--color-text-muted);" hidden>這一頁沒有符合的集數，其他頁的集數不在搜尋範圍內。</p>
          <Pagination currentPage={page.currentPage} lastPage={page.lastPage} base="/podcasts" label="Podcasts 分頁" />
        </>
      )}
    </div>
  </Container>
</Layout>

<style>
  .pc-wrap { max-width: 52rem; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; }
  .pc-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .pc-search {
    flex: 1 1 16rem; display: flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.75rem;
    border: 1px solid var(--color-border); border-radius: 0.5rem; background-color: var(--color-surface-raised);
    color: var(--color-text-muted);
  }
  .pc-search:focus-within { border-color: var(--color-accent-cool); }
  .pc-search input {
    flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
    font-size: 16px; color: var(--color-text);
  }
  .pc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .pc-row { display: flex; gap: 0.875rem; padding: 1rem; text-decoration: none; }
  @media (min-width: 640px) { .pc-row { gap: 1.25rem; padding: 1.125rem 1.25rem; } }
  .pc-badge {
    flex-shrink: 0; width: 3.5rem; height: 3.5rem; border-radius: 0.5rem;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.125rem;
    background-color: var(--color-surface-muted); border: 1px solid var(--color-border);
  }
  .pc-badge-day { font-family: var(--font-mono); font-size: 0.9375rem; font-weight: 700; color: var(--color-text); }
  .pc-badge-label { font-size: 0.625rem; font-family: var(--font-mono); color: var(--color-text-muted-on-muted); }
  .pc-badge-recent {
    border-color: color-mix(in srgb, var(--color-accent-cool) 45%, transparent);
    background-color: var(--color-accent-cool-muted);
  }
  .pc-badge-recent .pc-badge-label { color: var(--color-accent-cool-text); font-weight: 600; font-family: var(--font-sans); font-size: 0.6875rem; }
  .pc-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .pc-meta { display: flex; gap: 0.375rem; font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-muted); }
  .pc-show { color: var(--color-accent-cool-text); font-weight: 600; }
  .pc-title { font-size: 1rem; line-height: 1.4; font-weight: 700; color: var(--color-text); }
  .pc-row:hover .pc-title { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-border); }
  .pc-oneliner {
    font-size: 0.875rem; line-height: 1.6; color: var(--color-text-muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .pc-guests { font-size: 0.75rem; color: var(--color-text); opacity: 0.8; }
</style>

<script>
  function initPodcastSearch() {
    const input = document.getElementById("pc-q") as HTMLInputElement | null;
    const count = document.getElementById("pc-count");
    const empty = document.getElementById("pc-empty");
    if (!input || !count || input.dataset.bound) return;
    input.dataset.bound = "true";
    const rows = Array.from(document.querySelectorAll<HTMLElement>("#pc-list > li"));
    const total = Number(count.dataset.total || rows.length);
    const initial = count.textContent;
    input.addEventListener("input", () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const row of rows) {
        const hay = row.dataset.q || "";
        const ok = terms.every((t) => hay.includes(t));
        row.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = terms.length ? `共 ${total} 集，這頁符合 ${shown} 集` : initial;
      if (empty) empty.hidden = shown > 0;
    });
  }
  document.addEventListener("astro:page-load", initPodcastSearch);
</script>
