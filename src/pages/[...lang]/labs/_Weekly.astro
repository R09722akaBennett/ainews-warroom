---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import "./_labs.css";
import Pagination from "@components/Pagination.astro";
import type { PageSlice } from "../_lib/paging";
import { href, pick, t, type Lang } from "@i18n";
import { labsUI } from "@i18n/ui/labs";
import { renderBrief, shortDate, splitWeekly, tokens, weeklyReports, type Summary } from "./_data";

type Props = { page: PageSlice<Summary>; lang: Lang };
const { page, lang } = Astro.props;
const ui = labsUI[lang];
// Reports are written in Chinese; the English page reads the "en" copy and
// says so when a week has none.
const reports = page.data.map((s) => pick(s, lang, "zh"));
// Only the newest report on the first page opens as a card; the rest are rows.
const latest = page.currentPage === 1 ? reports[0] : undefined;
const latestSplit = latest ? splitWeekly(latest.data.content) : null;
const older = latest ? reports.slice(1) : reports;
---

<Layout title={page.currentPage === 1 ? ui.weeklyTitle : ui.weeklyPageTitle(page.currentPage)} description={ui.weeklyDescription} lang={lang}>
  <Container>
    <div class="lab-wrap">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">{ui.weeklyTitle}</h1>
        <p class="lab-intro">
          {weeklyReports.length > 0 ? ui.weeklyIntro(weeklyReports.length) : ui.weeklyNone}
          <a class="lab-link" href={href(lang, "/labs")}>{ui.backToDaily}</a>
        </p>
      </div>

      {latest && latestSplit && (
        <article class="card card-accent-warm lab-weekly">
          <div class="lab-weekly-meta">
            <span class="period-label period-warroom">{ui.latest}</span>
            <span class="meta">{latest.data.startDate} ~ {latest.data.endDate}</span>
            {latest.data.tokenUsage && <span class="meta lab-tokens ml-auto">{tokens(lang, latest.data.tokenUsage)}</span>}
          </div>
          <h2 class="lab-weekly-title">{latest.data.title}</h2>
          {!latest.translated && <p class="meta">{t(lang).notTranslated}</p>}
          <div class="lab-prose" set:html={renderBrief(lang, latestSplit.lead)} />
          {latestSplit.rest && (
            <details class="lab-more">
              <summary class="lab-more-toggle">
                <span class="lab-more-open">{ui.expand}</span><span class="lab-more-close">{ui.collapse}</span>
                <svg class="lab-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              </summary>
              <div class="lab-prose" set:html={renderBrief(lang, latestSplit.rest)} />
            </details>
          )}
        </article>
      )}

      {older.length > 0 && (
        <section class="lab-section" aria-label={ui.earlier}>
          {latest && <h2 class="lab-h2">{ui.earlier}</h2>}
          <div class="lab-older">
            {older.map(({ data: s, translated }) => (
              <details class="card lab-row">
                <summary class="lab-row-summary">
                  <span class="meta lab-row-date">{shortDate(s.startDate)} ~ {shortDate(s.endDate)}</span>
                  <span class="lab-row-title">{s.title}</span>
                  {s.tokenUsage && <span class="meta lab-tokens">{tokens(lang, s.tokenUsage)}</span>}
                  <svg class="lab-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </summary>
                <div class="lab-row-body">
                  {!translated && <p class="meta">{t(lang).notTranslated}</p>}
                  <div class="lab-prose" set:html={renderBrief(lang, s.content)} />
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <Pagination currentPage={page.currentPage} lastPage={page.lastPage} base={href(lang, "/labs/weekly")} label={ui.weeklyPagination} lang={lang} />
    </div>
  </Container>
</Layout>
