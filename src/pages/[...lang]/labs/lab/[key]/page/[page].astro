---
import type { GetStaticPaths } from "astro";
import Lab from "../../../_Lab.astro";
import { laterPages } from "../../../../_lib/paging";
import { langOf, withLangs } from "@i18n";
import { activeLabs, posts } from "../../../_data";

export const getStaticPaths = (({ paginate }) =>
  withLangs(activeLabs.flatMap((key) => laterPages(paginate, posts.filter((p) => p.lab === key), 30, { key })))) satisfies GetStaticPaths;

const { key } = Astro.params;
const { page } = Astro.props;
const lang = langOf(Astro.params);
---

<Lab labKey={key!} page={page} lang={lang} />
