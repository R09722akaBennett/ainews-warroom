---
import Lab from "../../_Lab.astro";
import { firstPage } from "../../../_lib/paging";
import { langOf, withLangs } from "@i18n";
import { activeLabs, posts } from "../../_data";

export function getStaticPaths() {
  return withLangs(activeLabs.map((key) => ({ params: { key } })));
}

const { key } = Astro.params;
const lang = langOf(Astro.params);
---

<Lab labKey={key!} page={firstPage(posts.filter((p) => p.lab === key), 30)} lang={lang} />
