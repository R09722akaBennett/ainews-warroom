---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { renderMarkdown } from "@lib/markdown";

import { SITE_SINCE } from "@consts";
import allSummaries from "../../data/summaries.json";
import { LANG_PARAMS, langOf, pick, t } from "@i18n";
import { trendsUI } from "@i18n/ui/trends";

export function getStaticPaths() {
  return LANG_PARAMS.map((params) => ({ params }));
}
const lang = langOf(Astro.params);
const ui = trendsUI[lang];

// Summaries without origin "wiki" came from the retired pipeline. A period is
// shown when it ends on or after SITE_SINCE, so a week or quarter that spans
// the cut-over stays and everything that ended before it goes to the archive.
const summariesData = (allSummaries as any[]).filter((s) => s.origin === "wiki" && s.endDate >= SITE_SINCE);

const industry = {
  quarterly: summariesData.filter((s: any) => s.period === "raw_quarterly").sort((a: any, b: any) => b.endDate.localeCompare(a.endDate)),
  monthly: summariesData.filter((s: any) => s.period === "raw_monthly").sort((a: any, b: any) => b.endDate.localeCompare(a.endDate)),
  weekly: summariesData.filter((s: any) => s.period === "raw_weekly").sort((a: any, b: any) => b.endDate.localeCompare(a.endDate)),
};

type PeriodKey = "weekly" | "monthly" | "quarterly";
const periodMeta: Record<PeriodKey, { label: string; badge: string; accent: string }> = {
  weekly: { ...ui.weekly, accent: "weekly" },
  monthly: { ...ui.monthly, accent: "monthly" },
  quarterly: { ...ui.quarterly, accent: "quarterly" },
};
const periods: PeriodKey[] = ["weekly", "monthly", "quarterly"];
const total = periods.reduce((t, p) => t + industry[p].length, 0);
---

<Layout title={ui.title} description={ui.description} lang={lang}>
  <Container>
    <div class="space-y-8">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">{ui.title}</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">{ui.intro(total)}</p>
      </div>

      <div>
        <div class="flex flex-wrap gap-1.5 mb-6" data-period-tabs="industry">
          {periods.map((p, i) => (
            <button type="button" data-period={p} class:list={["tab-pill", { "tab-pill-active": i === 0 }]}>
              <span>{periodMeta[p].label}</span>
              <span class="tab-pill-count">{industry[p].length}</span>
            </button>
          ))}
        </div>

        {periods.map((p, i) => (
          <div data-period-content={p} class:list={["period-content space-y-3", { hidden: i !== 0 }]} data-track="industry">
            {industry[p].length > 0 ? industry[p].map((raw: any) => {
              const { data: s, translated } = pick(raw, lang, "zh");
              return (
              <details class={`card card-accent-${periodMeta[p].accent} group`}>
                <summary class="flex cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-4">
                  <span class={`period-label period-${periodMeta[p].accent}`}>{periodMeta[p].badge}</span>
                  <span class="meta">{s.startDate} ~ {s.endDate}</span>
                  <span class="min-w-0 flex-1 basis-60 text-sm font-medium" style="color: var(--color-text);">{s.title}</span>
                  {s.tokenUsage && <span class="meta hidden sm:inline">{ui.tokens(s.tokenUsage.input?.toLocaleString(), s.tokenUsage.output?.toLocaleString())}</span>}
                  <svg class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 16 16" fill="currentColor" style="color: var(--color-text-muted);">
                    <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </summary>
                <div class="px-5 pb-5 pt-2" style="border-top: 1px solid var(--color-border);">
                  {lang === "en" && !translated && <p class="meta">{t(lang).notTranslated}</p>}
                  <article set:html={renderMarkdown(s.content)} />
                </div>
              </details>
              );
            }) : (
              <p class="text-sm" style="color: var(--color-text-muted);">{ui.empty(periodMeta[p].label)}</p>
            )}
          </div>
        ))}
      </div>

    </div>
  </Container>
</Layout>

<script>
  function initTrends() {
    document.querySelectorAll<HTMLElement>('[data-period-tabs]').forEach(container => {
      if (container.dataset.bound) return;
      container.dataset.bound = "true";
      const track = container.dataset.periodTabs!;
      const btns = container.querySelectorAll<HTMLButtonElement>('[data-period]');

      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          const period = btn.dataset.period!;
          btns.forEach(b => b.classList.toggle('tab-pill-active', b.dataset.period === period));
          document.querySelectorAll<HTMLElement>(`.period-content[data-track="${track}"]`).forEach(c =>
            c.classList.toggle('hidden', c.dataset.periodContent !== period)
          );
        });
      });
    });
  }

  // astro:page-load also fires on the first load.
  document.addEventListener('astro:page-load', initTrends);
</script>
