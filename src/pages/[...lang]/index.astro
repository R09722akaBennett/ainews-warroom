---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, SITE_SINCE } from "@consts";
import { LANG_PARAMS, href, langOf, pick, t } from "@i18n";
import { homeUI } from "@i18n/ui/home";

export function getStaticPaths() {
  return LANG_PARAMS.map((params) => ({ params }));
}
const lang = langOf(Astro.params);
const ui = homeUI[lang];

import reportsData from "../../data/reports.json";
import summariesData from "../../data/summaries.json";
import leaderboardData from "../../data/leaderboard.json";
import papersData from "../../data/papers.json";
import mcpData from "../../data/mcpmarket.json";

const topPapers = ((papersData as any).hot || []).slice(0, 3);
const mcp = mcpData as any;
const topServers = (mcp.servers || []).slice(0, 3);
const topSkills = (mcp.skills || []).slice(0, 3);

const reports = reportsData.filter((r: any) => r.date >= SITE_SINCE);
const latestEntry = reports[0] ? pick(reports[0] as any, lang, "zh") : null;
const latestReport = latestEntry?.data as any;
const recentReports = reports.slice(1, 11).map((x: any) => pick(x, lang, "zh").data);

// Summaries without origin "wiki" came from the retired pipeline.
const summaries = (summariesData as any[])
  .filter((s) => s.origin === "wiki")
  .sort((a, b) => (b.startDate || "").localeCompare(a.startDate || ""));
const industryOf = (period: string) => {
  const found = summaries.find((s) => s.period === period);
  return found ? pick(found, lang, "zh").data : undefined;
};
const industryWeekly = industryOf("raw_weekly");
const industryMonthly = industryOf("raw_monthly");
const industryQuarterly = industryOf("raw_quarterly");

function truncate(text: string, n: number): string {
  if (!text || text.length <= n) return text || "";
  return text.slice(0, n).trimEnd() + "...";
}

const lb = leaderboardData as any;
const topModels = (lb.full as any[])
  .filter((m: any) => m.overall && m.overall > 0)
  .sort((a: any, b: any) => a.overall - b.overall)
  .slice(0, 3);

// Same F1-style points as the Leaderboard lab ranking, so the two agree.
const F1_PTS = [25, 18, 15, 12, 10, 8, 6, 4, 2, 1];
const labMap = new Map<string, { org: string; points: number; bestModel: string }>();
for (const m of lb.full as any[]) {
  const org = m.org || "";
  if (!org) continue;
  const rank = m.overall as number;
  if (!rank || rank < 1) continue;
  const pts = rank < 11 ? F1_PTS[rank - 1] : 0;
  if (!labMap.has(org)) {
    labMap.set(org, { org, points: 0, bestModel: m.model });
  }
  const entry = labMap.get(org)!;
  entry.points += pts;
  if (rank < (lb.full as any[]).find((x: any) => x.model === entry.bestModel)?.overall) {
    entry.bestModel = m.model;
  }
}
const topLabs = Array.from(labMap.values())
  .sort((a, b) => b.points - a.points)
  .slice(0, 3);

const lbUpdated = new Date(lb.updatedAt).toLocaleDateString(ui.dateLocale, {
  timeZone: "Asia/Taipei", month: "numeric", day: "numeric",
});

function lbMedal(rank: number): string {
  if (rank === 1) return "\u{1F947}";
  if (rank === 2) return "\u{1F948}";
  if (rank === 3) return "\u{1F949}";
  return `#${rank}`;
}

// Fetched at build time, so the cards are as fresh as the last deploy.
type TrendingRepo = { name: string; url: string; description: string };
let trendingRepos: TrendingRepo[] = [];
try {
  const resp = await fetch("https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml");
  const xml = await resp.text();
  const items = xml.match(/<item>[\s\S]*?<\/item>/g) || [];
  for (const item of items.slice(0, 3)) {
    const title = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1]
               || item.match(/<title>(.*?)<\/title>/)?.[1] || "";
    const link = item.match(/<link>(.*?)<\/link>/)?.[1] || "";
    const desc = item.match(/<description>([\s\S]*?)<\/description>/)?.[1] || "";
    // The feed escapes the description HTML once more inside the XML.
    const unescaped = desc.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&").replace(/&quot;/g, '"');
    const pMatch = unescaped.match(/<p>(.*?)<\/p>/s);
    const cleanDesc = pMatch ? pMatch[1].replace(/<[^>]+>/g, "").trim().slice(0, 120) : "";
    if (title && link) {
      trendingRepos.push({ name: title, url: link, description: cleanDesc });
    }
  }
} catch {
  // A failed feed leaves the card on its empty state instead of failing the build.
}

type PHProduct = { name: string; tagline: string; url: string };
let topProducts: PHProduct[] = [];
try {
  const resp = await fetch("https://www.producthunt.com/feed");
  const text = await resp.text();
  const entries = text.match(/<entry>[\s\S]*?<\/entry>/g) || [];
  for (const entry of entries.slice(0, 3)) {
    const title = entry.match(/<title>(.*?)<\/title>/)?.[1] || "";
    const link = entry.match(/<link[^>]*href="([^"]*)"[^>]*\/>/)?.[1] || "";
    const content = entry.match(/<content[^>]*>([\s\S]*?)<\/content>/)?.[1] || "";
    const taglineMatch = content.match(/&lt;p&gt;\s*([\s\S]*?)\s*&lt;\/p&gt;/);
    const tagline = taglineMatch
      ? taglineMatch[1].replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").trim()
      : "";
    if (title && link) {
      topProducts.push({ name: title.trim(), tagline: truncate(tagline, 80), url: link });
    }
  }
} catch {
  // A failed feed leaves the card on its empty state instead of failing the build.
}
---

<Layout title={SITE.TITLE} description={ui.description} lang={lang}>
  <Container>
    <div class="space-y-14">

      <div class="space-y-3">
        <h1 class="text-center text-3xl font-semibold tracking-tight lg:text-4xl" style="color: var(--color-text);">
          {SITE.TITLE}
        </h1>
        <p class="text-center text-sm" style="color: var(--color-text-muted);">
          {ui.tagline}{latestReport && ui.latestIssue(latestReport.date)}{ui.period}
        </p>
      </div>

      {latestReport && (
        <section class="space-y-4">
          <h2 class="section-title">{ui.latestHeading}</h2>
          <a href={href(lang, `/reports/${latestReport.date}`)} class="card card-accent-warm block p-6 no-underline">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 space-y-3">
                <div class="flex items-center gap-3">
                  <span class="period-label period-warroom">{ui.badge}</span>
                  <span class="meta">{latestReport.date}</span>
                </div>
                <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text);">
                  {latestReport.title}
                </h2>
                {lang === "en" && !latestEntry?.translated && <p class="meta">{t(lang).notTranslated}</p>}
                <p class="text-sm leading-relaxed line-clamp-3" style="color: var(--color-text-muted);">
                  {latestReport.content
                    ?.split("\n")
                    .filter((l: string) => l.trim() && !/^(#|---|>|\*Source)/.test(l))
                    .slice(0, 2)
                    .join(" ")
                    .replace(/^-\s+/, "")
                    .replace(/\s*\((?:ref-)?\d+(?:,\s*(?:ref-)?\d+)*\)/g, "")
                    .replace(/\*\*/g, "")
                    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
                    .slice(0, 300)}
                </p>
                <div class="flex items-center gap-4 pt-1">
                  <span class="meta">{ui.sourcesIncluded(latestReport.rawCount)}</span>
                  <span class="text-xs font-medium" style="color: var(--color-accent-warm-text);">{ui.readReport}</span>
                </div>
              </div>
            </div>
          </a>
        </section>
      )}

      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="section-title">{ui.rankingsHeading}</h2>
          <span class="meta">{ui.rankingUpdated(lbUpdated)}</span>
        </div>
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          <a href={href(lang, "/leaderboard#overview")} class="card block p-5 no-underline snapshot-card" style="border-left: 3px solid var(--color-accent-cool);">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-cool-text);">{ui.modelRank}</span>
              <span class="snapshot-link">{ui.leaderboardLink}</span>
            </div>
            <div class="space-y-2.5">
              {topModels.map((m: any, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{m.model}</div>
                    {m.org && <div class="snapshot-sub">{m.org}</div>}
                  </div>
                </div>
              ))}
            </div>
          </a>

          <a href={href(lang, "/leaderboard#orgs")} class="card block p-5 no-underline snapshot-card" style="border-left: 3px solid var(--color-accent-warm);">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-warm-text);">{ui.labRank}</span>
              <span class="snapshot-link">{ui.leaderboardLink}</span>
            </div>
            <div class="space-y-2.5">
              {topLabs.map((lab, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{lab.org}</div>
                    <div class="snapshot-sub">{ui.points(lab.points)}</div>
                  </div>
                </div>
              ))}
            </div>
          </a>

          <a href={href(lang, "/trending#mcpservers")} class="card card-accent-cool block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-cool-text);">MCP Servers</span>
              <span class="snapshot-link">{ui.allLink}</span>
            </div>
            <div class="space-y-2.5">
              {topServers.length > 0 ? topServers.map((s: any, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{s.name}</div>
                    <div class="snapshot-sub">☆ {s.stars?.toLocaleString()}</div>
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">{ui.emptyCard}</div>
              )}
            </div>
          </a>

          <a href={href(lang, "/trending#skills")} class="card card-accent-cool block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-cool-text);">Agent Skills</span>
              <span class="snapshot-link">{ui.allLink}</span>
            </div>
            <div class="space-y-2.5">
              {topSkills.length > 0 ? topSkills.map((s: any, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{s.name}</div>
                    <div class="snapshot-sub">☆ {s.stars?.toLocaleString()}</div>
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">{ui.emptyCard}</div>
              )}
            </div>
          </a>
        </div>

        <div class="grid gap-4 grid-cols-1 sm:grid-cols-3">
          <a href={href(lang, "/trending#repos")} class="card card-accent-purple block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-purple-text);">{ui.hotRepos}</span>
              <span class="snapshot-link">{ui.allLink}</span>
            </div>
            <div class="space-y-2.5">
              {trendingRepos.length > 0 ? trendingRepos.map((repo, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{repo.name}</div>
                    {repo.description && <div class="snapshot-sub">{truncate(repo.description, 50)}</div>}
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">{ui.emptyCard}</div>
              )}
            </div>
          </a>

          <a href={href(lang, "/trending#products")} class="card card-accent-orange block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-orange-text);">Product Hunt</span>
              <span class="snapshot-link">{ui.allLink}</span>
            </div>
            <div class="space-y-2.5">
              {topProducts.length > 0 ? topProducts.map((p, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{p.name}</div>
                    {p.tagline && <div class="snapshot-sub">{truncate(p.tagline, 50)}</div>}
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">{ui.emptyCard}</div>
              )}
            </div>
          </a>

          <a href={href(lang, "/trending#papers")} class="card card-accent-cool block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-cool-text);">{ui.hotPapers}</span>
              <span class="snapshot-link">{ui.allLink}</span>
            </div>
            <div class="space-y-2.5">
              {topPapers.length > 0 ? topPapers.map((p: any, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{truncate(p.title, 45)}</div>
                    <div class="snapshot-sub">{ui.paperStats(p.votes, p.visits?.toLocaleString())}</div>
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">{ui.emptyCard}</div>
              )}
            </div>
          </a>
        </div>
      </section>

      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="section-title">{ui.trendsHeading}</h2>
          <a href={href(lang, "/trends")} class="index-more">{ui.allTrends}</a>
        </div>
        <div>
          <div class="grid gap-4 md:grid-cols-3">
            {industryWeekly && (
              <a href={href(lang, "/trends#industry")} class="card card-accent-cool block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-weekly">{ui.weekly}</span>
                  <span class="meta">{industryWeekly.startDate?.slice(5)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(industryWeekly.title, 90)}
                </p>
              </a>
            )}
            {industryMonthly && (
              <a href={href(lang, "/trends#industry")} class="card card-accent-cool block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-monthly">{ui.monthly}</span>
                  <span class="meta">{industryMonthly.startDate?.slice(0,7)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(industryMonthly.title, 90)}
                </p>
              </a>
            )}
            {industryQuarterly && (
              <a href={href(lang, "/trends#industry")} class="card card-accent-cool block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-quarterly">{ui.quarterly}</span>
                  <span class="meta">{industryQuarterly.startDate?.slice(0,7)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(industryQuarterly.title, 90)}
                </p>
              </a>
            )}
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="section-title">{ui.recentHeading}</h2>
          <a href={href(lang, "/reports")} class="index-more">{ui.allReports}</a>
        </div>
        <div class="space-y-2">
          {recentReports.map((report: any) => (
            <a href={href(lang, `/reports/${report.date}`)}
               class="card flex items-center gap-5 px-5 py-3.5 no-underline">
              <span class="meta min-w-[5.5rem]">{report.date}</span>
              <span class="flex-1 text-sm font-medium" style="color: var(--color-text);">{report.title}</span>
              <span class="meta hidden sm:inline">{ui.itemCount(report.rawCount)}</span>
            </a>
          ))}
        </div>
      </section>

    </div>
  </Container>
</Layout>

<style>
  .index-more {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
  }
  .index-more:hover {
    color: var(--color-text);
  }
  .snapshot-card {
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .snapshot-card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .snapshot-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .snapshot-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .snapshot-link {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
  .snapshot-medal {
    font-size: 0.875rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .snapshot-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .snapshot-sub {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
