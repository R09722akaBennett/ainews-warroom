---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Pagination from "@components/Pagination.astro";

import { SITE_SINCE } from "@consts";
import { href, type Lang } from "@i18n";
import { sourcesUI } from "@i18n/ui/sources";
import type { PageSlice } from "../_lib/paging";
import { byDate, dates, totalItems } from "./_data";

type Props = { page: PageSlice<string>; lang: Lang };
const { page, lang } = Astro.props;
const ui = sourcesUI[lang];
const range = page.data.length ? `${page.data[page.data.length - 1]} ~ ${page.data[0]}` : "";
---

<Layout title={page.currentPage === 1 ? ui.title : ui.pageTitle(page.currentPage)} description={ui.description} lang={lang}>
  <Container>
    <div class="space-y-8">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">{ui.title}</h1>
        <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-text-muted);">
          {ui.introBefore}<a href={href(lang, "/about")} style="color: var(--color-accent-cool-text); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">{ui.introLink}</a>{ui.introAfter}{ui.stats(SITE_SINCE, dates.length, totalItems)}{page.lastPage > 1 && range && ui.range(range)}{ui.end}
        </p>
      </div>

      {page.data.map((date) => {
        const { groups, total } = byDate[date];
        return (
          <section>
            <details class="group">
              <summary class="day-header">
                <div class="flex flex-wrap items-center gap-x-3 flex-1 min-w-0">
                  <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);" aria-hidden="true">
                    <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                  <span class="text-base font-semibold" style="color: var(--color-text);">{date}</span>
                  <span class="meta">{ui.dayCount(total, groups.length)}</span>
                </div>
                {/* A link inside <summary> navigates without toggling the details, so it needs no click handler. */}
                <a href={href(lang, `/reports/${date}`)} class="report-link">
                  {ui.viewReport}
                </a>
              </summary>

              <div class="source-groups">
                {groups.map((group) => (
                  <details class="group/src">
                    <summary class="source-header">
                      <svg class="size-3 shrink-0 transition-transform duration-200 group-open/src:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);" aria-hidden="true">
                        <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                      <span class="source-chip">{group.name}</span>
                      <span class="meta">{group.items.length}</span>
                    </summary>
                    <div class="news-list">
                      {group.items.map((item, i) => (
                        <a href={item.url} target="_blank" rel="noopener noreferrer" class="news-item">
                          <span class="news-rank">{i + 1}</span>
                          <div class="news-content">
                            <span class="news-title">{item.title}</span>
                            <svg class="news-external" viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M4 12L12 4M12 4H6M12 4v6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </div>
                        </a>
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            </details>
          </section>
        );
      })}

      <Pagination currentPage={page.currentPage} lastPage={page.lastPage} base={href(lang, "/sources")} label={ui.paginationLabel} lang={lang} />

      {dates.length === 0 && (
        <div class="text-center py-12">
          <p class="text-sm" style="color: var(--color-text-muted);">
            {ui.empty}
          </p>
        </div>
      )}
    </div>
  </Container>
</Layout>

<style>
  .day-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-raised);
    transition: background-color 0.15s;
  }
  .day-header:hover {
    background-color: var(--color-surface-muted);
  }
  .report-link {
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-accent-warm-text);
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.625rem;
    border-radius: 0.25rem;
    transition: background-color 0.15s;
  }
  .report-link:hover {
    background-color: color-mix(in srgb, var(--color-accent-warm) 10%, transparent);
  }
  .source-groups {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
    padding-left: 0.5rem;
  }
  .source-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 40px;
    cursor: pointer;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  .source-header:hover {
    background-color: var(--color-surface-muted);
  }
  .source-chip {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent-cool-text);
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
  }
  .news-list {
    display: flex;
    flex-direction: column;
    margin-left: 1.75rem;
    border-left: 1px solid var(--color-border);
  }
  .news-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    transition: background-color 0.15s;
    border-radius: 0 0.25rem 0.25rem 0;
  }
  .news-item:hover {
    background-color: var(--color-surface-muted);
  }
  .news-rank {
    min-width: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-align: right;
    flex-shrink: 0;
  }
  .news-content {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }
  .news-title {
    font-size: 0.8125rem;
    color: var(--color-text);
    line-height: 1.5;
  }
  .news-external {
    width: 0.625rem;
    height: 0.625rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .news-item:hover .news-external {
    opacity: 1;
  }
</style>
