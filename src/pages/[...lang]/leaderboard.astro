---
import Board from "./leaderboard/_Board.astro";
import leaderboard from "@data/leaderboard.json";

const keys = ["orgs", ...Object.keys((leaderboard as any).categories)];
---

<Board active="overview" />

{/* Tabs used to be #hash anchors on this page, so old shared links are sent
    to the category page; any other hash is ignored. The router re-runs inline
    scripts on every visit, so the IIFE keeps its consts out of global scope. */}
<script is:inline data-keys={JSON.stringify(keys)}>
  (function () {
    const keys = JSON.parse(document.currentScript?.dataset.keys || "[]");
    const key = decodeURIComponent(location.hash.slice(1));
    if (location.pathname === "/leaderboard" && keys.includes(key)) location.replace(`/leaderboard/${key}`);
  })();
</script>
