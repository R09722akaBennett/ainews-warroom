---
import List from "./reading/_List.astro";
import { firstPage } from "./_lib/paging";
import { LANG_PARAMS, langOf } from "@i18n";
import { PER_PAGE, items } from "./reading/_data";

export function getStaticPaths() {
  return LANG_PARAMS.map((params) => ({ params }));
}
const lang = langOf(Astro.params);
---

<List page={firstPage(items, PER_PAGE)} lang={lang} />
