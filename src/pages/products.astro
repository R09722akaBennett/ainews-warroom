---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

// Fetch at build time (server-side, no CORS issue)
type Product = { name: string; tagline: string; url: string; author: string; date: string };

let products: Product[] = [];
try {
  const resp = await fetch("https://www.producthunt.com/feed");
  const text = await resp.text();

  // Parse Atom XML
  const entries = text.match(/<entry>[\s\S]*?<\/entry>/g) || [];
  for (const entry of entries.slice(0, 50)) {
    const title = entry.match(/<title>(.*?)<\/title>/)?.[1] || "";
    const link = entry.match(/<link[^>]*href="([^"]*)"[^>]*\/>/)?.[1]
              || entry.match(/<link[^>]*rel="alternate"[^>]*href="([^"]*)"[^>]*\/>/)?.[1]
              || "";
    const content = entry.match(/<content[^>]*>([\s\S]*?)<\/content>/)?.[1] || "";
    const author = entry.match(/<name>(.*?)<\/name>/)?.[1] || "";
    const published = entry.match(/<published>(.*?)<\/published>/)?.[1] || "";

    // Extract tagline from <p> in content
    const taglineMatch = content.match(/&lt;p&gt;\s*([\s\S]*?)\s*&lt;\/p&gt;/);
    const tagline = taglineMatch
      ? taglineMatch[1].replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").trim()
      : "";

    if (title && link) {
      const dateStr = published ? new Date(published).toLocaleDateString("en-US", { month: "short", day: "numeric" }) : "";
      products.push({ name: title.trim(), tagline, url: link, author, date: dateStr });
    }
  }
} catch (e) {
  console.error("[Products] Fetch error:", e);
}
---

<Layout title="Trending Products" description="Latest products from Product Hunt">
  <Container>
    <div class="mx-auto max-w-3xl space-y-6">

      <div>
        <div class="section-title mb-2">Product Hunt</div>
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text);">Trending Products</h1>
        <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
          {products.length} latest products from Product Hunt
        </p>
      </div>

      {products.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-sm" style="color: var(--color-text-muted);">Could not load products.</p>
          <a href="https://www.producthunt.com" target="_blank" rel="noopener noreferrer"
             class="inline-block mt-2 text-xs no-underline" style="color: var(--color-accent-warm);">
            Visit Product Hunt →
          </a>
        </div>
      ) : (
        <div class="space-y-0.5">
          {products.map((p, i) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="product-row">
              <span class={`product-rank ${i < 3 ? 'product-rank-top' : ''}`}>{i + 1}</span>
              <div style="flex: 1; min-width: 0;">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-semibold" style="color: var(--color-text);">{p.name}</span>
                  <svg class="h-3 w-3 flex-shrink-0" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
                    <path d="M4 12L12 4M12 4H6M12 4v6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                {p.tagline && (
                  <p class="text-xs mt-0.5 leading-relaxed" style="color: var(--color-text-muted);">{p.tagline}</p>
                )}
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-[10px] font-mono" style="color: var(--color-text-muted);">{p.author}</span>
                  {p.date && (
                    <>
                      <span class="text-[10px]" style="color: var(--color-border);">·</span>
                      <span class="text-[10px] font-mono" style="color: var(--color-text-muted);">{p.date}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          ))}
          <div class="text-center pt-6 pb-2">
            <a href="https://www.producthunt.com" target="_blank" rel="noopener noreferrer"
               class="text-xs no-underline hover:underline" style="color: var(--color-accent-warm);">
              View more on Product Hunt →
            </a>
          </div>
        </div>
      )}

    </div>
  </Container>
</Layout>

<style>
  .product-row {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  .product-row:hover {
    background-color: var(--color-surface-muted);
  }
  .product-rank {
    min-width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: var(--color-surface-muted);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .product-rank-top {
    color: var(--color-accent-warm);
    background-color: color-mix(in srgb, var(--color-accent-warm) 12%, transparent);
  }
</style>
