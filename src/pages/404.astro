---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
---

<Layout title="找不到頁面" description="這個網址沒有對應的頁面">
  <Container>
    <div class="flex flex-col gap-4 py-16">
      <p class="meta">404</p>
      <h1 class="text-2xl font-semibold" style="color: var(--color-text);">找不到這個頁面</h1>
      <p style="color: var(--color-text-muted);">網址可能打錯了，或頁面已經移到別的地方。</p>
      <div class="flex flex-wrap gap-3">
        <a href="/" class="reading-link" style="min-height: 40px; display: inline-flex; align-items: center;">回到首頁</a>
        <a href="/reports" class="reading-link" style="min-height: 40px; display: inline-flex; align-items: center;">每日快報</a>
      </div>
    </div>
  </Container>
</Layout>
