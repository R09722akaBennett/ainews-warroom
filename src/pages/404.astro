---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { href, t, type Lang } from "@i18n";

// One 404 page serves every missing address, so it speaks both languages;
// Chinese first because the site's default language is Chinese.
const blocks: Lang[] = ["zh", "en"];
---

<Layout title={t("zh").notFound.title} description={t("zh").notFound.description}>
  <Container>
    <div class="flex flex-col gap-10 py-16">
      <p class="meta">404</p>
      {blocks.map((lang) => (
        <div class="flex flex-col gap-4" lang={lang === "en" ? "en" : "zh-Hant-TW"}>
          <h1 class="text-2xl font-semibold" style="color: var(--color-text);">{t(lang).notFound.heading}</h1>
          <p style="color: var(--color-text-muted);">{t(lang).notFound.body}</p>
          <div class="flex flex-wrap gap-3">
            <a href={href(lang, "/")} class="reading-link" style="min-height: 40px; display: inline-flex; align-items: center;">{t(lang).notFound.home}</a>
            <a href={href(lang, "/reports")} class="reading-link" style="min-height: 40px; display: inline-flex; align-items: center;">{t(lang).notFound.reports}</a>
          </div>
        </div>
      ))}
    </div>
  </Container>
</Layout>
