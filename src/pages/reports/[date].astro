---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import reportsData from "../../data/reports.json";
import sourcesData from "../../data/sources.json";
import { marked } from "marked";

export function getStaticPaths() {
  return reportsData.map((report: any) => ({
    params: { date: report.date },
    props: { report },
  }));
}

const { report } = Astro.props;

const idx = reportsData.findIndex((r: any) => r.date === report.date);
const prevReport = idx < reportsData.length - 1 ? reportsData[idx + 1] : null;
const nextReport = idx > 0 ? reportsData[idx - 1] : null;

// Build ref-N → URL map from structured metadata
const refs: Record<string, string> = {};
(report.refs || []).forEach((r: any, i: number) => {
  if (r.url) refs[`ref-${i + 1}`] = r.url;
});

function processRefs(html: string): string {
  // Add id="ref-N" anchor to h3 headings containing ref-N
  html = html.replace(
    /<h3>(.+?)\s+ref-(\d+)<\/h3>/g,
    '<h3 id="ref-$2">$1 <span class="meta">ref-$2</span></h3>'
  );
  // Convert inline ref-N citations to links (using source URL from metadata)
  // Matches both (ref-1) and (ref-1, ref-4, ref-7) patterns,
  // and also bare ref-1 or [ref-1](#ref-1) from prompt output
  html = html.replace(
    /\(ref-(\d+(?:,\s*ref-\d+)*)\)/g,
    (_match, inner) => {
      const links = (inner as string).split(/,\s*/).map((r: string) => {
        const num = r.replace('ref-', '');
        const url = refs[`ref-${num}`];
        if (url) {
          return `<a href="${url}" target="_blank" rel="noopener" class="ref-link">${r}</a>`;
        }
        return `<a href="#ref-${num}" class="ref-link">${r}</a>`;
      });
      return `(${links.join(', ')})`;
    }
  );
  // Also handle markdown-style [ref-1](#ref-1) links from newer prompts
  html = html.replace(
    /<a href="#ref-(\d+)">ref-\d+<\/a>/g,
    (_match, num) => {
      const url = refs[`ref-${num}`];
      if (url) {
        return `<a href="${url}" target="_blank" rel="noopener" class="ref-link">ref-${num}</a>`;
      }
      return `<a href="#ref-${num}" class="ref-link">ref-${num}</a>`;
    }
  );
  return html;
}

const rawHtml = await marked.parse(report.content || "");
const htmlContent = processRefs(rawHtml);

// Group raw items by source (from sources.json)
type RawItem = { date: string; title: string; url: string; source: string; score: number };
const rawItems = (sourcesData as RawItem[]).filter((s) => s.date === report.date);
type GroupedSources = Record<string, RawItem[]>;
const sourceGroups: GroupedSources = {};
for (const item of rawItems) {
  const src = item.source || "Other";
  if (!sourceGroups[src]) sourceGroups[src] = [];
  sourceGroups[src].push(item);
}
const sortedSources = Object.entries(sourceGroups).sort((a, b) => b[1].length - a[1].length);
---

<Layout title={report.title} description={`AI War Room report for ${report.date}`}>
  <Container>
    <div class="mx-auto max-w-3xl space-y-10">
      <!-- Back link -->
      <a href="/reports/" class="inline-flex items-center gap-1.5 text-sm no-underline transition-colors" style="color: var(--color-text-muted);">
        <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Reports
      </a>

      <!-- Report header -->
      <div class="space-y-3" style="border-left: 3px solid var(--color-accent-warm); padding-left: 1.25rem;">
        <div class="flex items-center gap-3">
          <span class="period-label period-warroom">Report</span>
          <span class="meta">{report.date}</span>
          <span class="meta">{report.rawCount} sources</span>
        </div>
        <h1 class="text-2xl font-semibold tracking-tight lg:text-3xl" style="color: var(--color-text);">
          {report.title}
        </h1>
        {report.tags && (Object.keys(report.tags).length > 0) && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {(report.tags.companies || []).map((c: string) => (
              <span class="tag tag-company">{c}</span>
            ))}
            {(report.tags.models || []).map((m: string) => (
              <span class="tag tag-model">{m}</span>
            ))}
            {(report.tags.topics || []).map((t: string) => (
              <span class="tag tag-topic">{t}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Report content -->
      <article set:html={htmlContent} />

      <!-- Raw Sources -->
      {rawItems.length > 0 && (
        <section class="space-y-4">
          <details class="group">
            <summary class="flex cursor-pointer items-center gap-3 py-3 transition-colors" style="border-top: 1px solid var(--color-border);">
              <svg class="size-3.5 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
                <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span class="text-sm font-semibold" style="color: var(--color-text);">Raw Sources</span>
              <span class="meta">{rawItems.length} items from {sortedSources.length} sources</span>
            </summary>

            <div class="mt-2 space-y-3">
              {sortedSources.map(([source, items]) => (
                <details class="group/src">
                  <summary class="flex cursor-pointer items-center gap-3 rounded-md px-4 py-2 transition-colors source-summary">
                    <svg class="size-3 shrink-0 transition-transform duration-200 group-open/src:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
                      <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    <span class="source-tag">{source}</span>
                    <span class="meta">{items.length}</span>
                  </summary>
                  <div class="mt-1 space-y-0.5 pl-7">
                    {items.map((item: any) => (
                      <a href={item.url} target="_blank" rel="noopener"
                         class="flex items-baseline gap-2 rounded px-3 py-1.5 text-sm no-underline transition-colors source-item">
                        <span class="flex-1" style="color: var(--color-text);">{item.title}</span>
                        {item.score > 0 && (
                          <span class="meta shrink-0">⭐ {item.score}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </details>
        </section>
      )}

      <!-- Prev/Next -->
      <nav class="flex items-center justify-between pt-4" style="border-top: 1px solid var(--color-border);">
        {prevReport ? (
          <a href={`/reports/${prevReport.date}`} class="meta no-underline hover:underline">
            ← {prevReport.date}
          </a>
        ) : <span />}
        {nextReport ? (
          <a href={`/reports/${nextReport.date}`} class="meta no-underline hover:underline">
            {nextReport.date} →
          </a>
        ) : <span />}
      </nav>
    </div>
  </Container>
</Layout>

<style>
  .ref-link {
    color: var(--color-accent-warm);
    text-decoration: none;
    font-size: 0.8em;
    font-weight: 500;
  }
  .ref-link:hover {
    text-decoration: underline;
  }
  .source-summary:hover {
    background-color: var(--color-surface-muted);
  }
  .source-tag {
    display: inline-block;
    border-radius: 2px;
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-accent-cool);
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
  }
  .source-item:hover {
    background-color: var(--color-surface-muted);
  }
</style>
