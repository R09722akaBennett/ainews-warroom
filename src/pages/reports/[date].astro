---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

import reportsData from "../../data/reports.json";
import ExternalIcon from "@components/ExternalIcon.astro";
import { renderMarkdown } from "@lib/markdown";

export function getStaticPaths() {
  return reportsData.map((report: any) => ({
    params: { date: report.date },
    props: { report },
  }));
}

const { report } = Astro.props;

const idx = reportsData.findIndex((r: any) => r.date === report.date);
const prevReport = idx < reportsData.length - 1 ? reportsData[idx + 1] : null;
const nextReport = idx > 0 ? reportsData[idx - 1] : null;

// The report prompt numbers news items in this order, so ref-N is newsItems[N].
const newsItems: { url: string; title: string; source?: string }[] = report.newsItems || [];

// A ref the model invented past the end of the list has no row to jump to,
// so it stays plain text instead of becoming a dead link.
// The model sometimes zero-pads (ref-07) while the rows are id="ref-7".
function refLink(num: string, label = `ref-${num}`): string {
  const n = parseInt(num, 10);
  return n < newsItems.length ? `<a href="#ref-${n}" class="ref-link">${label}</a>` : label;
}

function normalizeRefToken(token: string): string | null {
  const t = token.trim();
  const m = t.match(/^(?:ref-)?(\d+)$/);
  return m ? m[1] : null;
}

function processRefs(html: string): string {
  html = html.replace(
    /<h3>(.+?)\s+((?:ref-\d+(?:,\s*)?)+)<\/h3>/g,
    (_match, title, refStr) => {
      const refLinks = (refStr as string).split(/,\s*/).map((r: string) => {
        return refLink(r.replace('ref-', '').trim(), r.trim());
      }).join(', ');
      return `<h3>${title} ${refLinks}</h3>`;
    }
  );

  // Parenthesized lists mix forms: (ref-1), (ref-1, ref-4), (29, ref-184), (29).
  html = html.replace(
    /\(((?:ref-)?\d+(?:,\s*(?:ref-)?\d+)*)\)/g,
    (_match, inner) => {
      const tokens = (inner as string).split(/,\s*/);
      const hasRef = tokens.some((t: string) => /ref-\d+/.test(t) || /^\d{1,3}$/.test(t.trim()));
      if (!hasRef) return _match;
      const links = tokens.map((t: string) => {
        const num = normalizeRefToken(t);
        if (num && parseInt(num) < newsItems.length) {
          return `<a href="#ref-${num}" class="ref-link">ref-${num}</a>`;
        }
        return t;
      });
      return `(${links.join(', ')})`;
    }
  );

  // The lookarounds skip refs already turned into links above.
  html = html.replace(
    /(?<![">\/\-])ref-(\d+)(?![<"\d])/g,
    (_match, num) => refLink(num)
  );

  html = html.replace(
    /<a href="#ref-(\d+)">ref-\d+<\/a>/g,
    (_match, num) => refLink(num)
  );

  return html;
}

// "Source: ..." lines repeat what the refs already link to in the Sources list.
const cleanedContent = (report.content || "").replace(/^\*?Source:\s*\[?[^\]\n]*\]?\(?[^)\n]*\)?\*?\s*$/gm, "");
const rawHtml = renderMarkdown(cleanedContent);
const htmlContent = processRefs(rawHtml);

---

<Layout title={report.title} description={`${report.date} 的 AI War Room 每日快報。`}>
  <Container>
    <div class="mx-auto max-w-3xl space-y-10">
      <a href="/reports" class="rp-back inline-flex items-center gap-1.5 text-sm no-underline transition-colors" style="color: var(--color-text-muted);">
        <svg viewBox="0 0 16 16" fill="none" class="h-3.5 w-3.5">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Reports
      </a>

      <div class="space-y-3" style="border-left: 3px solid var(--color-accent-warm); padding-left: 1.25rem;">
        <div class="flex items-center gap-3 flex-wrap">
          <span class="period-label period-warroom">快報</span>
          <span class="meta">{report.date}</span>
          <span class="meta">{report.rawCount} 則來源</span>
          {report.tokenUsage && (
            <span class="meta">
              輸入 {report.tokenUsage.input?.toLocaleString()} · 輸出 {report.tokenUsage.output?.toLocaleString()} · 合計 {report.tokenUsage.total?.toLocaleString()} tokens
            </span>
          )}
        </div>
        <h1 class="text-2xl font-semibold tracking-tight lg:text-3xl" style="color: var(--color-text);">
          {report.title}
        </h1>
        {report.tags && (Object.keys(report.tags).length > 0) && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {(report.tags.companies || []).map((c: string) => (
              <span class="tag tag-company">{c}</span>
            ))}
            {(report.tags.models || []).map((m: string) => (
              <span class="tag tag-model">{m}</span>
            ))}
            {(report.tags.topics || []).map((t: string) => (
              <span class="tag tag-topic">{t}</span>
            ))}
          </div>
        )}
      </div>

      <article set:html={htmlContent} />

      <section id="sources-section">
        <details id="sources-details" class="group" style="border-top: 1px solid var(--color-border);">
          <summary class="flex cursor-pointer items-center gap-3 py-4 transition-colors">
            <svg class="size-4 shrink-0 transition-transform duration-200 group-open:rotate-90" viewBox="0 0 16 16" style="color: var(--color-text-muted);">
              <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span class="text-lg font-semibold" style="color: var(--color-text);">引用來源</span>
            <span class="meta">{newsItems.length} 則</span>
          </summary>
          <div id="refs-view" class="space-y-0.5 pb-4">
            {newsItems.length > 0 ? newsItems.map((item: any, i: number) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener"
                id={`ref-${i}`}
                class="ref-row"
              >
                <span class="ref-id">ref-{i}</span>
                <span class="ref-source-tag">{item.source || "—"}</span>
                <span class="flex-1" style="color: var(--color-text);">{item.title}</span>
                <ExternalIcon />
              </a>
            )) : (
              <p class="text-sm" style="color: var(--color-text-muted);">這份快報沒有附來源清單。</p>
            )}
          </div>
        </details>
      </section>

      <nav class="flex items-center justify-between pt-4" style="border-top: 1px solid var(--color-border);">
        {prevReport ? (
          <a href={`/reports/${prevReport.date}`} class="meta rp-nav no-underline hover:underline" rel="prev" aria-label={`前一天的快報 ${prevReport.date}`}>
            &larr; {prevReport.date}
          </a>
        ) : <span />}
        {nextReport ? (
          <a href={`/reports/${nextReport.date}`} class="meta rp-nav no-underline hover:underline" rel="next" aria-label={`後一天的快報 ${nextReport.date}`}>
            {nextReport.date} &rarr;
          </a>
        ) : <span />}
      </nav>
    </div>
  </Container>
</Layout>

<style>
  /* The report body comes from set:html, which scoped styles cannot reach. */
  :global(.ref-link) {
    color: var(--color-accent-warm-text);
    text-decoration: none;
    font-size: 0.8em;
    font-weight: 500;
    cursor: pointer;
  }
  :global(.ref-link:hover) {
    text-decoration: underline;
  }

  .rp-back, .rp-nav { min-height: 40px; display: inline-flex; align-items: center; }
  .ref-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s;
  }
  .ref-row:hover {
    background-color: var(--color-surface-muted);
  }
  .ref-row.highlight {
    background-color: color-mix(in srgb, var(--color-accent-warm) 10%, transparent);
    outline: 1px solid color-mix(in srgb, var(--color-accent-warm) 30%, transparent);
    border-radius: 0.375rem;
  }
  .ref-id {
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-accent-warm-text);
    min-width: 3rem;
    flex-shrink: 0;
  }
  .ref-source-tag {
    display: inline-block;
    padding: 0.05rem 0.375rem;
    border-radius: 0.25rem;
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-accent-cool-text);
    background-color: color-mix(in srgb, var(--color-accent-cool) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent-cool) 20%, transparent);
    flex-shrink: 0;
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  function initReportPage() {
    const details = document.getElementById("sources-details") as HTMLDetailsElement | null;

    document.querySelectorAll<HTMLAnchorElement>('a.ref-link[href^="#ref-"]').forEach(link => {
      if (link.dataset.bound) return;
      link.dataset.bound = "true";
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const href = link.getAttribute("href")!;
        const targetId = href.slice(1);

        // The target row is inside the collapsed Sources section.
        if (details && !details.open) {
          details.open = true;
        }

        // The row has no layout position until the opened details renders.
        requestAnimationFrame(() => {
          const target = document.getElementById(targetId);
          if (!target) return;

          const headerOffset = 96;
          const y = target.getBoundingClientRect().top + window.scrollY - headerOffset;
          window.scrollTo({ top: y, behavior: "smooth" });

          target.classList.add("highlight");
          setTimeout(() => target.classList.remove("highlight"), 2000);
        });
      });
    });
  }

  // astro:page-load also fires on the first load.
  document.addEventListener("astro:page-load", initReportPage);
</script>
