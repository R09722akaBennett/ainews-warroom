---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME } from "@consts";

import reportsData from "../data/reports.json";
import summariesData from "../data/summaries.json";
import leaderboardData from "../data/leaderboard.json";
import papersData from "../data/papers.json";

const topPapers = ((papersData as any).hot || []).slice(0, 3);

const latestReport = reportsData[0];
const recentReports = reportsData.slice(1, 11);

const summaries = summariesData as any[];
const warWeekly = summaries.find((s) => s.period === "weekly");
const warMonthly = summaries.find((s) => s.period === "monthly");
const warQuarterly = summaries.find((s) => s.period === "quarterly");
const industryWeekly = summaries.find((s) => s.period === "raw_weekly");
const industryMonthly = summaries.find((s) => s.period === "raw_monthly");
const industryQuarterly = summaries.find((s) => s.period === "raw_quarterly");

function truncate(text: string, n: number): string {
  if (!text || text.length <= n) return text || "";
  return text.slice(0, n).trimEnd() + "...";
}

// === Leaderboard snapshot ===
const lb = leaderboardData as any;
const topModels = (lb.full as any[])
  .filter((m: any) => m.overall && m.overall > 0)
  .sort((a: any, b: any) => a.overall - b.overall)
  .slice(0, 3);

const F1_PTS = [25, 18, 15, 12, 10, 8, 6, 4, 2, 1];
const labMap = new Map<string, { org: string; points: number; bestModel: string }>();
for (const m of lb.full as any[]) {
  const org = m.org || "";
  if (!org) continue;
  const rank = m.overall as number;
  if (!rank || rank < 1) continue;
  const pts = rank < 11 ? F1_PTS[rank - 1] : 0;
  if (!labMap.has(org)) {
    labMap.set(org, { org, points: 0, bestModel: m.model });
  }
  const entry = labMap.get(org)!;
  entry.points += pts;
  if (rank < (lb.full as any[]).find((x: any) => x.model === entry.bestModel)?.overall) {
    entry.bestModel = m.model;
  }
}
const topLabs = Array.from(labMap.values())
  .sort((a, b) => b.points - a.points)
  .slice(0, 3);

const lbUpdated = new Date(lb.updatedAt).toLocaleDateString("en-US", {
  month: "short", day: "numeric",
});

function lbMedal(rank: number): string {
  if (rank === 1) return "\u{1F947}";
  if (rank === 2) return "\u{1F948}";
  if (rank === 3) return "\u{1F949}";
  return `#${rank}`;
}

// === Trending repos (build-time RSS fetch) ===
type TrendingRepo = { name: string; url: string; description: string };
let trendingRepos: TrendingRepo[] = [];
try {
  const resp = await fetch("https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml");
  const xml = await resp.text();
  const items = xml.match(/<item>[\s\S]*?<\/item>/g) || [];
  for (const item of items.slice(0, 3)) {
    const title = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1]
               || item.match(/<title>(.*?)<\/title>/)?.[1] || "";
    const link = item.match(/<link>(.*?)<\/link>/)?.[1] || "";
    const desc = item.match(/<description>([\s\S]*?)<\/description>/)?.[1] || "";
    // Description is HTML-escaped: &lt;p&gt;...&lt;/p&gt;
    const unescaped = desc.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&").replace(/&quot;/g, '"');
    const pMatch = unescaped.match(/<p>(.*?)<\/p>/s);
    const cleanDesc = pMatch ? pMatch[1].replace(/<[^>]+>/g, "").trim().slice(0, 120) : "";
    if (title && link) {
      trendingRepos.push({ name: title, url: link, description: cleanDesc });
    }
  }
} catch { /* silently skip */ }

// === Product Hunt (build-time fetch) ===
type PHProduct = { name: string; tagline: string; url: string };
let topProducts: PHProduct[] = [];
try {
  const resp = await fetch("https://www.producthunt.com/feed");
  const text = await resp.text();
  const entries = text.match(/<entry>[\s\S]*?<\/entry>/g) || [];
  for (const entry of entries.slice(0, 3)) {
    const title = entry.match(/<title>(.*?)<\/title>/)?.[1] || "";
    const link = entry.match(/<link[^>]*href="([^"]*)"[^>]*\/>/)?.[1] || "";
    const content = entry.match(/<content[^>]*>([\s\S]*?)<\/content>/)?.[1] || "";
    const taglineMatch = content.match(/&lt;p&gt;\s*([\s\S]*?)\s*&lt;\/p&gt;/);
    const tagline = taglineMatch
      ? taglineMatch[1].replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">").trim()
      : "";
    if (title && link) {
      topProducts.push({ name: title.trim(), tagline: truncate(tagline, 80), url: link });
    }
  }
} catch { /* silently skip */ }
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-14">

      <!-- Hero / Branding -->
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="h-px flex-1" style="background: linear-gradient(to right, var(--color-accent-warm), transparent);"></div>
          <span class="section-title">Intelligence Dashboard</span>
          <div class="h-px flex-1" style="background: linear-gradient(to left, var(--color-accent-warm), transparent);"></div>
        </div>
        <h1 class="text-center text-3xl font-semibold tracking-tight lg:text-4xl" style="color: var(--color-text);">
          {SITE.TITLE}
        </h1>
        <p class="text-center text-sm" style="color: var(--color-text-muted);">
          {SITE.DESCRIPTION}
        </p>
      </div>

      <!-- Snapshot Grid: Leaderboard + Trending + Products -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="section-title">At a Glance</div>
          <span class="meta">{lbUpdated}</span>
        </div>
        {/* Row 1: Top Models + Top Labs (2 big cards) */}
        <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
          <!-- Top Models -->
          <a href="/leaderboard#overview" class="card block p-5 no-underline snapshot-card" style="border-left: 3px solid var(--color-accent-cool);">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-cool);">Top Models</span>
              <span class="snapshot-link">rankings →</span>
            </div>
            <div class="space-y-2.5">
              {topModels.map((m: any, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{m.model}</div>
                    {m.org && <div class="snapshot-sub">{m.org}</div>}
                  </div>
                </div>
              ))}
            </div>
          </a>

          <!-- Top Labs -->
          <a href="/leaderboard#orgs" class="card block p-5 no-underline snapshot-card" style="border-left: 3px solid var(--color-accent-warm);">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-warm);">Top Labs</span>
              <span class="snapshot-link">lab ranking →</span>
            </div>
            <div class="space-y-2.5">
              {topLabs.map((lab, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{lab.org}</div>
                    <div class="snapshot-sub">{lab.points} pts</div>
                  </div>
                </div>
              ))}
            </div>
          </a>
        </div>

        {/* Row 2: Repos + Products + Papers (3 smaller cards) */}
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-3">
          <!-- Trending Repos -->
          <a href="/trending#repos" class="card card-accent-purple block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-purple);">Trending Repos</span>
              <span class="snapshot-link">all →</span>
            </div>
            <div class="space-y-2.5">
              {trendingRepos.length > 0 ? trendingRepos.map((repo, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{repo.name}</div>
                    {repo.description && <div class="snapshot-sub">{truncate(repo.description, 50)}</div>}
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">Loading at next build...</div>
              )}
            </div>
          </a>

          <!-- Product Hunt -->
          <a href="/trending#products" class="card card-accent-orange block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-orange);">Product Hunt</span>
              <span class="snapshot-link">all →</span>
            </div>
            <div class="space-y-2.5">
              {topProducts.length > 0 ? topProducts.map((p, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{p.name}</div>
                    {p.tagline && <div class="snapshot-sub">{truncate(p.tagline, 50)}</div>}
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">Loading at next build...</div>
              )}
            </div>
          </a>

          <!-- Hot Papers -->
          <a href="/trending#papers" class="card card-accent-cool block p-5 no-underline snapshot-card">
            <div class="snapshot-header">
              <span class="snapshot-label" style="color: var(--color-accent-cool);">Hot Papers</span>
              <span class="snapshot-link">all →</span>
            </div>
            <div class="space-y-2.5">
              {topPapers.length > 0 ? topPapers.map((p: any, i: number) => (
                <div class="flex items-center gap-2.5">
                  <span class="snapshot-medal">{lbMedal(i + 1)}</span>
                  <div class="flex-1 min-w-0">
                    <div class="snapshot-name">{truncate(p.title, 45)}</div>
                    <div class="snapshot-sub">{p.votes} votes · {p.visits?.toLocaleString()} visits</div>
                  </div>
                </div>
              )) : (
                <div class="snapshot-sub">Loading at next build...</div>
              )}
            </div>
          </a>
        </div>
      </section>

      <!-- Latest Report (hero card) -->
      {latestReport && (
        <section class="space-y-4">
          <div class="section-title">Latest Briefing</div>
          <a href={`/reports/${latestReport.date}`} class="card card-accent-warm block p-6 no-underline">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 space-y-3">
                <div class="flex items-center gap-3">
                  <span class="period-label period-warroom">Report</span>
                  <span class="meta">{latestReport.date}</span>
                </div>
                <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text);">
                  {latestReport.title}
                </h2>
                <p class="text-sm leading-relaxed line-clamp-3" style="color: var(--color-text-muted);">
                  {latestReport.content
                    ?.split("\n")
                    .filter((l: string) => l.trim() && !l.startsWith("#") && !l.startsWith("---") && !l.startsWith("*Source"))
                    .slice(0, 2)
                    .join(" ")
                    .replace(/\*\*/g, "")
                    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
                    .slice(0, 300)}
                </p>
                <div class="flex items-center gap-4 pt-1">
                  <span class="meta">{latestReport.rawCount} sources collected</span>
                  <span class="text-xs font-medium" style="color: var(--color-accent-warm);">Read briefing →</span>
                </div>
              </div>
            </div>
          </a>
        </section>
      )}

      <!-- Trend Cards -->
      <section class="space-y-6">
        <div class="section-title">Trend Signals</div>

        <!-- KDAN Warroom -->
        <div class="space-y-2">
          <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-accent-warm);">KDAN Warroom</div>
          <div class="grid gap-4 md:grid-cols-3">
            {warWeekly && (
              <a href="/trends#warroom" class="card card-accent-warm block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-weekly">Weekly</span>
                  <span class="meta">{warWeekly.startDate?.slice(5)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(warWeekly.title, 90)}
                </p>
              </a>
            )}
            {warMonthly && (
              <a href="/trends#warroom" class="card card-accent-warm block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-monthly">Monthly</span>
                  <span class="meta">{warMonthly.startDate?.slice(0,7)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(warMonthly.title, 90)}
                </p>
              </a>
            )}
            {warQuarterly && (
              <a href="/trends#warroom" class="card card-accent-warm block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-quarterly">Quarterly</span>
                  <span class="meta">{warQuarterly.startDate?.slice(0,7)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(warQuarterly.title, 90)}
                </p>
              </a>
            )}
          </div>
        </div>

        <!-- Industry -->
        <div class="space-y-2">
          <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-accent-cool);">Industry</div>
          <div class="grid gap-4 md:grid-cols-3">
            {industryWeekly && (
              <a href="/trends#industry" class="card card-accent-cool block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-weekly">Weekly</span>
                  <span class="meta">{industryWeekly.startDate?.slice(5)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(industryWeekly.title, 90)}
                </p>
              </a>
            )}
            {industryMonthly && (
              <a href="/trends#industry" class="card card-accent-cool block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-monthly">Monthly</span>
                  <span class="meta">{industryMonthly.startDate?.slice(0,7)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(industryMonthly.title, 90)}
                </p>
              </a>
            )}
            {industryQuarterly && (
              <a href="/trends#industry" class="card card-accent-cool block p-5 no-underline space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="period-label period-quarterly">Quarterly</span>
                  <span class="meta">{industryQuarterly.startDate?.slice(0,7)}</span>
                </div>
                <p class="text-sm font-medium leading-snug" style="color: var(--color-text);">
                  {truncate(industryQuarterly.title, 90)}
                </p>
              </a>
            )}
          </div>
        </div>
      </section>

      <!-- Recent Reports -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="section-title">Recent Reports</div>
          <a href="/reports/" class="text-xs font-medium no-underline transition-colors" style="color: var(--color-text-muted);">
            View all →
          </a>
        </div>
        <div class="space-y-2">
          {recentReports.map((report: any) => (
            <a href={`/reports/${report.date}`}
               class="card flex items-center gap-5 px-5 py-3.5 no-underline">
              <span class="meta min-w-[5.5rem]">{report.date}</span>
              <span class="flex-1 text-sm font-medium" style="color: var(--color-text);">{report.title}</span>
              <span class="meta hidden sm:inline">{report.rawCount} src</span>
            </a>
          ))}
        </div>
      </section>

    </div>
  </Container>
</Layout>

<style>
  .snapshot-card {
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .snapshot-card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .snapshot-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .snapshot-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .snapshot-link {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
  .snapshot-medal {
    font-size: 0.875rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .snapshot-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .snapshot-sub {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
