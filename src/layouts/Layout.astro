---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";
import { htmlLang, type Lang } from "@i18n";

type Props = {
  title: string;
  description: string;
  /** Page language; every page under src/pages/[...lang]/ passes langOf(Astro.params). */
  lang?: Lang;
};

const { title, description, lang = "zh" } = Astro.props;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <Head
      title={title === SITE.TITLE ? title : `${title} | ${SITE.TITLE}`}
      description={description}
      lang={lang}
    />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <Pagefind lang={lang} />
  </body>
</html>
