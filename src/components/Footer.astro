---
import Container from "@components/Container.astro";
import BackToTop from "@components/BackToTop.astro";
import { href, t, type Lang } from "@i18n";

type Props = { lang?: Lang };
const { lang = "zh" } = Astro.props;
const ui = t(lang);
const NAV: { key: keyof typeof ui.nav; path: string }[] = [
  { key: "sources", path: "/sources" }, { key: "reports", path: "/reports" }, { key: "insights", path: "/trends" },
  { key: "reading", path: "/reading" }, { key: "podcasts", path: "/podcasts" }, { key: "leaderboard", path: "/leaderboard" },
  { key: "trending", path: "/trending" }, { key: "labs", path: "/labs" }, { key: "analytics", path: "/analytics" },
  { key: "archive", path: "/archive" }, { key: "about", path: "/about" },
];
---

<footer>
  <Container>
    <div class="relative">
      <div class="absolute -top-12 right-0">
        <BackToTop lang={lang} />
      </div>
    </div>
    <div class="footer-inner">
      <div class="footer-links">
        {NAV.map((item) => <a href={href(lang, item.path)}>{ui.nav[item.key]}</a>)}
      </div>
      <a href="https://bennettlabs.dev" class="footer-home meta no-underline hover:underline">bennettlabs.dev</a>
    </div>
  </Container>
</footer>

<style>
  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-links {
    display: flex;
    column-gap: 0.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-home {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }
  .footer-links a:hover {
    color: var(--color-text);
  }
</style>
