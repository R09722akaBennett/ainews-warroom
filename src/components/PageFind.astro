---
import Search from "astro-pagefind/components/Search";
---

<aside data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    role="dialog"
    aria-modal="true"
    aria-label="搜尋"
    class="invisible fixed left-0 top-0 z-50 flex h-screen w-full justify-center bg-black/50 p-6 backdrop-blur-xs"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[80%] w-full max-w-(--breakpoint-sm) flex-col overflow-auto rounded-sm border border-black/15 bg-neutral-100 p-2 px-4 py-3 shadow-lg dark:border-white/20 dark:bg-neutral-900"
    >
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          excerptLength: 15,
          resetStyles: false,
        }}
      />
      <div class="mr-2 pb-1 pt-4 text-right text-xs dark:prose-invert">
        按 <span class="prose text-xs dark:prose-invert"><kbd>Esc</kbd></span> 或點擊外側即可關閉。
      </div>
    </div>
  </div>
</aside>

{/* A bundled module runs once per visit; the overlay and the header buttons
    are both transition:persist, so the listeners bound here outlive page
    swaps without being added again. */}
<script>
  const backdrop = document.getElementById("backdrop");

  function isOpen(): boolean {
    return !!backdrop && backdrop.classList.contains("visible");
  }

  function openPagefind() {
    if (!backdrop) return;
    backdrop.classList.remove("invisible");
    backdrop.classList.add("visible");
    // The input only takes focus once the overlay is visible.
    setTimeout(() => {
      document.querySelector<HTMLInputElement>("#search input")?.focus();
    }, 0);
  }

  function closePagefind() {
    if (!backdrop) return;
    const input = document.querySelector<HTMLInputElement>("#search input");
    if (input) {
      input.value = "";
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
    backdrop.classList.remove("visible");
    backdrop.classList.add("invisible");
  }

  function isTypingTarget(target: EventTarget | null): boolean {
    if (!(target instanceof HTMLElement)) return false;
    return target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName);
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest("[data-open-search]")) {
      openPagefind();
    } else if (target.closest(".pagefind-ui__result-link")) {
      closePagefind();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (isOpen()) closePagefind();
      return;
    }
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
      return;
    }
    if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey && !isTypingTarget(e.target)) {
      e.preventDefault();
      openPagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!(event.target as Element).closest("#pagefind-container")) {
      closePagefind();
    }
  });

  document.addEventListener("astro:before-swap", closePagefind);

  // Pagefind indexes dist/<page>/index.html and so links to "/page/", which
  // Cloudflare (html_handling: drop-trailing-slash) answers with a redirect.
  // uiOptions is serialized to a data attribute, so a processResult callback
  // cannot be passed; rewrite the rendered links instead.
  const searchRoot = document.getElementById("search");
  if (searchRoot) {
    new MutationObserver(() => {
      searchRoot.querySelectorAll<HTMLAnchorElement>("a[href^=\"/\"]").forEach((a) => {
        const href = a.getAttribute("href") || "";
        const fixed = href.replace(/^(\/[^?#]*?)\/+(?=$|[?#])/, "$1");
        if (fixed !== href) a.setAttribute("href", fixed);
      });
    }).observe(searchRoot, { childList: true, subtree: true });
  }
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: "Geist", sans-serif;
    --pagefind-ui-primary: #3d3d3d;
    --pagefind-ui-text: #3d3d3d;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d0d0d0;
    --pagefind-ui-tag: #f5f5f522;
  }

  .dark {
    --pagefind-ui-primary: #d4d4d4;
    --pagefind-ui-text: #d4d4d4;
    --pagefind-ui-background: #171717;
    --pagefind-ui-border: #404040;
  }

  #search input {
    font-weight: normal;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
  }
</style>
