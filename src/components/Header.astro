---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header transition:persist>
  <Container>
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 no-underline">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-amber-600 dark:bg-amber-500">
          <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4 text-white dark:text-black">
            <path d="M2 4h12M2 8h8M2 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="font-mono text-sm font-semibold tracking-tight" style="color: var(--color-text);">
          {SITE.TITLE}
        </span>
      </a>
      <nav class="flex items-center gap-1">
        <a href="/reports/" class="nav-link">Reports</a>
        <span class="nav-sep">/</span>
        <a href="/sources" class="nav-link">Sources</a>
        <span class="nav-sep">/</span>
        <a href="/trending" class="nav-link">Trending Repo</a>
        <span class="nav-sep">/</span>
        <a href="/trends" class="nav-link">Trends</a>
        <span class="nav-sep">/</span>
        <a href="/archive" class="nav-link">Archive</a>

        <span class="nav-sep ml-1">&nbsp;</span>

        <!-- Theme toggle -->
        <div class="flex items-center gap-0.5">
          <button id="light-theme-button" aria-label="Light theme" class="theme-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </button>
          <button id="dark-theme-button" aria-label="Dark theme" class="theme-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
          <button id="system-theme-button" aria-label="System theme" class="theme-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </button>
        </div>
      </nav>
    </div>
  </Container>
</header>

<style>
  .nav-link {
    display: inline-block;
    border-radius: 0.375rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
    color: var(--color-text-muted);
  }
  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
  :global(.dark) .nav-link {
    color: var(--color-text-muted-dark);
  }
  :global(.dark) .nav-link:hover {
    color: var(--color-text-dark);
    background-color: var(--color-surface-muted-dark);
  }
  .nav-sep {
    font-size: 0.75rem;
    user-select: none;
    color: var(--color-border);
  }
  :global(.dark) .nav-sep {
    color: var(--color-border-dark);
  }
  .theme-btn {
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    transition: color 0.15s, background-color 0.15s;
    cursor: pointer;
    color: var(--color-text-muted);
    border: 1px solid transparent;
    background: transparent;
  }
  .theme-btn:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
    border-color: var(--color-border);
  }
  :global(.dark) .theme-btn {
    color: var(--color-text-muted-dark);
  }
  :global(.dark) .theme-btn:hover {
    color: var(--color-text-dark);
    background-color: var(--color-surface-muted-dark);
    border-color: var(--color-border-dark);
  }
</style>
