---
import Container from "@components/Container.astro";
import { SITE } from "@consts";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
function isActive(href: string): boolean {
  const h = href.replace(/\/$/, "") || "/";
  return pathname === h || (h !== "/" && pathname.startsWith(h));
}
---

<header transition:persist>
  <Container>
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 no-underline">
        <span class="flex h-7 w-7 items-center justify-center rounded-md font-mono text-xs font-bold" style="background-color: var(--color-text); color: var(--color-surface);" aria-hidden="true">B</span>
        <span class="font-mono text-sm font-semibold tracking-tight" style="color: var(--color-text);">
          {SITE.TITLE}
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1">
        <a href="/sources" class:list={["nav-link", { "nav-active": isActive("/sources") }]}>Daily News</a>
        <span class="nav-sep">/</span>
        <a href="/reports/" class:list={["nav-link", { "nav-active": isActive("/reports") }]}>Reports</a>
        <span class="nav-sep">/</span>
        <a href="/trends" class:list={["nav-link", { "nav-active": isActive("/trends") }]}>Insights</a>
        <span class="nav-sep">/</span>
        <a href="/leaderboard" class:list={["nav-link", { "nav-active": isActive("/leaderboard") }]}>Leaderboard</a>
        <span class="nav-sep">/</span>
        <a href="/trending" class:list={["nav-link", { "nav-active": isActive("/trending") }]}>Trending</a>
        <span class="nav-sep">/</span>
        <a href="/labs" class:list={["nav-link", { "nav-active": isActive("/labs") }]}>Labs</a>
        <span class="nav-sep">/</span>
        <span class="nav-sep">/</span>
        <a href="/analytics" class:list={["nav-link", { "nav-active": isActive("/analytics") }]}>Analytics</a>
        <span class="nav-sep">/</span>
        <a href="/archive" class:list={["nav-link", { "nav-active": isActive("/archive") }]}>Archive</a>
        <span class="nav-sep">/</span>
        <a href="/about" class:list={["nav-link", { "nav-active": isActive("/about") }]}>About</a>

        <!-- Hidden theme buttons (used by Head.astro script) -->
        <button id="light-theme-button" class="hidden"></button>
        <button id="dark-theme-button" class="hidden"></button>
        <button id="system-theme-button" class="hidden"></button>

        <!-- Theme toggle: light ↔ dark -->
        <button id="theme-toggle" aria-label="Toggle theme" class="theme-btn">
          <!-- Sun (shown in dark mode → click to go light) -->
          <svg id="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Moon (shown in light mode → click to go dark) -->
          <svg id="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </nav>

      <!-- Mobile: theme toggle + hamburger -->
      <div class="flex items-center gap-1 lg:hidden">
        <button id="theme-toggle-m" aria-label="Toggle theme" class="theme-btn">
          <svg id="icon-sun-m" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg id="icon-moon-m" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="theme-btn"
        >
          <svg id="menu-open-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="menu-close-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none;">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile dropdown menu -->
    <nav id="mobile-menu" class="mobile-menu lg:hidden" hidden>
      <a href="/sources" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/sources") }]}>News</a>
      <a href="/reports/" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/reports") }]}>Reports</a>
      <a href="/trends" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/trends") }]}>Insights</a>
      <a href="/leaderboard" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/leaderboard") }]}>Leaderboard</a>
      <a href="/trending" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/trending") }]}>Trending</a>
      <a href="/labs" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/labs") }]}>Labs</a>
      <a href="/analytics" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/analytics") }]}>Analytics</a>
      <a href="/archive" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/archive") }]}>Archive</a>
      <a href="/about" class:list={["mobile-nav-link", { "mobile-nav-active": isActive("/about") }]}>About</a>
    </nav>
  </Container>
</header>

<style>
  .nav-link {
    display: inline-block;
    border-radius: 0.375rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
    color: var(--color-text-muted);
  }
  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
  .nav-active {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
  .nav-sep {
    font-size: 0.75rem;
    user-select: none;
    color: var(--color-border);
  }
  .theme-btn {
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    transition: color 0.15s, background-color 0.15s;
    cursor: pointer;
    color: var(--color-text-muted);
    border: 1px solid transparent;
    background: transparent;
  }
  .theme-btn:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
    border-color: var(--color-border);
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0.125rem;
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .mobile-menu.show {
    display: flex;
  }
  .mobile-nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color 0.15s, background-color 0.15s;
  }
  .mobile-nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
  .mobile-nav-active {
    color: var(--color-text);
    background-color: var(--color-surface-muted);
  }
</style>

<script>
  function isDark(): boolean {
    return document.documentElement.classList.contains("dark");
  }

  function updateToggleIcon() {
    const dark = isDark();
    for (const suffix of ["", "-m"]) {
      const sun = document.getElementById(`icon-sun${suffix}`);
      const moon = document.getElementById(`icon-moon${suffix}`);
      if (sun) sun.style.display = dark ? "block" : "none";
      if (moon) moon.style.display = dark ? "none" : "block";
    }
  }

  function toggleThemeClick() {
    if (isDark()) {
      document.getElementById("light-theme-button")?.click();
    } else {
      document.getElementById("dark-theme-button")?.click();
    }
    updateToggleIcon();
  }

  function setupThemeToggle() {
    document.getElementById("theme-toggle")?.addEventListener("click", toggleThemeClick);
    document.getElementById("theme-toggle-m")?.addEventListener("click", toggleThemeClick);
    updateToggleIcon();
  }

  function setupMobileMenu() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");

    if (!toggle || !menu || !openIcon || !closeIcon) return;

    const syncMenuState = (isOpen: boolean) => {
      menu.classList.toggle("show", isOpen);
      menu.toggleAttribute("hidden", !isOpen);
      toggle.setAttribute("aria-expanded", String(isOpen));
      openIcon.style.display = isOpen ? "none" : "block";
      closeIcon.style.display = isOpen ? "block" : "none";
    };

    if (toggle.dataset.mobileMenuBound === "true") {
      syncMenuState(menu.classList.contains("show"));
      return;
    }

    syncMenuState(false);

    toggle.addEventListener("click", () => {
      syncMenuState(!menu.classList.contains("show"));
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!menu.classList.contains("show")) return;
      if (menu.contains(target) || toggle.contains(target)) return;
      syncMenuState(false);
    });

    // Close menu on link click
    menu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        syncMenuState(false);
      });
    });

    toggle.dataset.mobileMenuBound = "true";
  }

  setupMobileMenu();
  setupThemeToggle();
  document.addEventListener("astro:page-load", () => {
    setupMobileMenu();
    setupThemeToggle();
  });
</script>
