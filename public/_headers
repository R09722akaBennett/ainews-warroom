# Pages must revalidate on every visit so the daily rebuild shows up on the
# next load instead of after a cache lifetime.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Files under /_astro/ carry a content hash in their name and never change,
# so they can be cached for a year. The "!" line drops the rule above first.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
